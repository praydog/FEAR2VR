build/
build*/
out/
.vs/
.vscode/ipch/
*.user
*.suo
*.log
CMakeLists.txt
# ...except the host's, which is HAND-WRITTEN. The rule above exists because cmkr generates the
# root CMakeLists.txt from cmake.toml; tools/xr64 is a separate 64-bit build that cmkr never sees,
# and ignoring it meant a fresh clone could not build the OpenXR host at all.
!tools/xr64/CMakeLists.txt
# reload copies made by the injector sit next to the built DLL
fear2vr.*.dll
*.pyc

# Frame captures and files created by a mangled CLI argument being taken
# as an output path -- a 36 MB '--info' BMP reached origin this way.
*.bmp
*.png
--*

# staging/ IS the payload -- it is committed on purpose. A global core.excludesFile with *.dll in it
# (this machine has one) would otherwise drop d3d9.dll silently, so the repo says so itself: a repo
# .gitignore outranks the global one, and a CI runner that has no global ignore behaves identically.
!staging/*.dll
