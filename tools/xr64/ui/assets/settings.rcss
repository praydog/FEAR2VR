/* Styling for settings.rml. Flat colours only -- no image decorators, so this document never
   exercises UiRenderInterfaceD3D11::LoadTexture (see that file for why it refuses to load one). */

body {
	width: 100%;
	height: 100%;
	font-family: "Segoe UI";
	font-size: 20px;
	color: #eaeaea;
}

#panel {
	width: 100%;
	height: 100%;
	padding: 28px 32px;
	background-color: rgba(18, 20, 26, 235);
	border: 2px #3a4152;
	border-radius: 14px;
	box-sizing: border-box;
}

h1 {
	font-size: 30px;
	font-weight: bold;
	color: #ffffff;
	margin-bottom: 6px;
	letter-spacing: 2px;
}

#mod-status {
	display: block;
	font-size: 15px;
	color: #8fa0b8;
	margin-bottom: 20px;
}

.row {
	display: block;
	margin-bottom: 20px;
	padding-bottom: 14px;
	border-bottom: 1px #2a2f3a;
}

.row-head {
	display: block;
	margin-bottom: 8px;
}

.row-title {
	font-size: 19px;
	color: #d8dee8;
}

.row-value {
	float: right;
	color: #4da3ff;
	font-weight: bold;
}

.hint {
	display: block;
	font-size: 13px;
	color: #7a8194;
	margin-top: 4px;
}

.footer {
	margin-top: 8px;
	font-size: 14px;
	color: #6b7385;
	text-align: center;
}

/* ---- checkbox ------------------------------------------------------------------------------ */

.toggle-row {
	display: block;
}

input.checkbox {
	width: 22px;
	height: 22px;
	vertical-align: -5px;
	margin-right: 12px;
	background-color: #262b36;
	border: 2px #3a4152;
	border-radius: 5px;
}
input.checkbox:hover {
	border-color: #4da3ff;
}
input.checkbox:checked {
	background-color: #4da3ff;
	border-color: #4da3ff;
}

/* ---- range slider ---------------------------------------------------------------------------
   The three sub-elements (slidertrack/sliderprogress/sliderbar) are instanced by WidgetSlider
   itself, not by settings.rml -- see InputTypeRange.cpp / WidgetSlider.cpp. Selectors below match
   RmlUi's own sample stylesheets (Samples/assets/invader.rcss). */

input.range {
	display: block;
	width: 100%;
	height: 28px;
}
input.range slidertrack {
	display: block;
	height: 8px;
	margin-top: 10px;
	background-color: #262b36;
	border-radius: 4px;
}
input.range sliderprogress {
	display: block;
	height: 8px;
	margin-top: 10px;
	background-color: #2f6fb0;
	border-radius: 4px;
}
input.range sliderbar {
	width: 20px;
	height: 20px;
	margin-top: 4px;
	margin-left: -10px;
	background-color: #4da3ff;
	border-radius: 10px;
}
input.range sliderbar:hover, input.range sliderbar:active {
	background-color: #7cc0ff;
}
input.range sliderarrowdec, input.range sliderarrowinc {
	display: none;
}

/* The aim cursor. Positioned in panel pixels from the controller ray, above everything, and never
   a hit-test target itself -- it must not eat the click it is showing you. */
#aim-cursor
{
	position: absolute;
	z-index: 1000;
	/* Sits exactly under the hit point and above everything, so without this it would swallow every
	   hover and click it is meant to be showing you. Registered by RmlUi 6.2 as `none, auto`. */
	pointer-events: none;
	width: 18px;
	height: 18px;
	margin-left: -9px;
	margin-top: -9px;
	border-radius: 9px;
	background-color: #7fd4ffdd;
	border-width: 2px;
	border-color: #ffffffee;
	visibility: hidden;
}
