type uint64_t 8 [[u64]]
type int32_t 4 [[i32]]
type uint32_t 4 [[u32]]
type int16_t 2 [[i16]]
type uint16_t 2 [[u16]]
type uint8_t 1 [[u8]]
type int8_t 1 [[i8]]
type double 8 [[f64]]
type float 4 [[f32]]
type char 1
type void 0
type code 4 [[code]]
type wstrptr 4 [[utf16*]]
type strptr 4 [[utf8*]]
type wchar_t 2 [[u16]]
type bool 1 [[bool]]
type char 1 [[u8]]

struct BS 0x1000 {

}

namespace regenny {

// The vtable ITSELF (pointed to by DatabaseMgr::vtable, not inlined into the
// object). 64 entries CONFIRMED live: every slot dereferences to a readable
// code pointer inside GameDatabase.dll's real image bounds
// [0x9F0000,0xA05000); vt[64] lands on string data in .rdata ("tera..."),
// which is what pins the count at exactly 64. Virtuals intentionally left
// unmapped/opaque per instruction -- data layout only for now.
class DatabaseMgrVTable 0x100 {
    void* fn[64]   @0x00 [[code]]
}

// LithTech interface holder -- what the SDK's define_holder(IFoo, ptr) macro
// emits. CONFIRMED by reversing CAPIHolder_ctor (dump 0x4050DB) and the four
// vtable slots that operate on it; see reversing/INTERFACE_HOLDERS.md for the
// full trail and for the 147-holder / 36-interface table recovered from it.
//
// DIVERGES FROM THE SOURCE DROP: ltmodule.h's CAPIHolderBase puts `int32
// version` at +0x08. FEAR2 does not -- output_slot occupies it, and all three
// non-destructor virtuals (APIRemoved `*p=0`, APIFound `*p=api`, Interface
// `return *p`) read it as the pointer slot. The base constructor takes only
// the name (`retn 4`). Do not reintroduce `version`.
//
// NOTE ON USE: sdk::interfaces::Registry does NOT read these fields. It
// recovers each holder's name and slot from the static-init CALL SITE operands
// instead (which is where they are pushed from), so it never needs a struct
// offset. This type is here because the schema is where layouts belong, and so
// that code which does want to walk a holder object has an offsetof-able type
// rather than literals.
class CAPIHolder 0xC {
    void* vftable       @0x00 [[code]]   // CONFIRMED &CAPIHolder_vftable (dump 0x66EE08); base ctor writes the base vtable first, derived ctor overwrites
    strptr api_name     @0x04            // CONFIRMED "IFoo.Instance"; stored by CAPIHolderBase_ctor (dump 0x41FEDD)
    void** output_slot  @0x08            // CONFIRMED the consumer's own pointer variable; zeroed at construction, filled by APIFound, cleared by APIRemoved
}

// One 8-byte hash-table bucket entry. CONFIRMED: `hash` values are STABLE
// across apparently-repeated entries (identical 32-bit values recur at
// different indices for what look like the same underlying name), consistent
// with a hash-of-string. The trailing byte fields' MEANING is NOT verified --
// only their raw values are recorded (neutral names on purpose).
class HashEntry 0x8 {
    uint32_t hash   @0x00   // stable/repeating values observed -- consistent with hash(name), not otherwise confirmed
    uint8_t unk_04  @0x04   // observed: 01,02,04,06,07,09 -- meaning unverified
    uint8_t unk_05  @0x05   // observed constant 0x01 in nearly all samples (rare 0x06/0x12 seen) -- meaning unverified
    uint8_t unk_06  @0x06   // observed small incrementing-looking values -- meaning unverified
    uint8_t unk_07  @0x07   // observed constant 0x00 in every sample so far
}

// 0x18-byte record: one entry of DatabaseMgrCategory.records[]. This is the
// engine's HRECORD. CONFIRMED live (4 samples across two categories):
// `name` reads as a printable ASCII string ("Default", "Rat",
// "Multi_CombatBase", "ATCPatrol") and `owner_category` reads back exactly
// the owning DatabaseMgrCategory's address in every sample.
//
// owner_category stays void* (not DatabaseMgrCategory*) because this is a
// genuine cyclic type dependency and ReGenny cannot express it:
// DatabaseMgrCategory.records needs DatabaseMgrRecord defined first, and
// DatabaseMgrRecord.owner_category needs DatabaseMgrCategory defined first.
//
// Forward declarations do NOT solve this. `struct Foo {}` parses, but it
// SHADOWS rather than merges: with a forward decl present, find_struct
// returns the EMPTY declaration (size 0, no fields) and the later real
// definition is unreachable. Measured directly -- forward-declaring
// DatabaseMgrCategory here dropped it from size 0x14 to 0x0 with `name`
// MISSING. So a forward decl is only safe for a type you never define
// fully, which is useless for a real cycle.
// (Self-reference is different and DOES work -- a class may point to
// itself inside its own body; see CClientMgrListLink.)
//
// The pointee IS DatabaseMgrCategory (verified: == the owning category's
// address in every sample); it's just not spellable here. Note which side
// carries the void*: the OWNED-array direction (Category.records ->
// DatabaseMgrRecord*) is typed, because that is the direction you actually
// browse; only the backpointer is untyped. Cast at the call site to walk
// upward.
//
// unk_04/unk_08/unk_0C/unk_14 are UNVERIFIED -- kept as opaque scalars/
// pointers rather than guessed at. This is a deliberate scope boundary: the
// vtable functions that would confirm attribute count/storage were not
// reversed this pass (see reversing/MAPPING_WORKFLOW.md for the recipe).
// Observed live: unk_04 was 3 for "Default" (AI/WeaponContext) and 5 for
// all 3 sampled AI/GoalSets records -- varies per record, plausible
// attribute count. unk_08/unk_0C are heap pointers into two DIFFERENT
// nearby regions per record (0x09B37xxx and 0x09B68xxx in the sampled
// snapshot) -- unk_08 in particular showed a consistent ~0x28-byte stride
// across consecutive records in the same category, plausible attribute-
// descriptor array. unk_14 is a small unique-per-record 32-bit value,
// plausible name hash (same pattern as DatabaseMgrCategory.unk_10).
class DatabaseMgrRecord 0x18 {
    strptr name             @0x00   // CONFIRMED live: readable ASCII in 4/4 samples
    uint32_t unk_04         @0x04   // unverified; observed 3-5, plausible attribute count
    void* unk_08            @0x08   // unverified; plausible attribute-descriptor array (~0x28-byte stride observed)
    void* unk_0C            @0x0C   // unverified
    void* owner_category    @0x10   // CONFIRMED live: == owning DatabaseMgrCategory address in 4/4 samples; see comment above for why this isn't typed DatabaseMgrCategory*
    uint32_t unk_14         @0x14   // unverified; small unique-per-record value, plausible name hash
}

// 0x14-byte record: one entry of DatabaseMgrSubRecord.categories[]. This is
// the engine's HCATEGORY. CONFIRMED 359/359 live (main menu,
// Database\Loki.gamedb): every element's `name` reads as a printable ASCII
// string (real category names: "AI", "FX", "FX/ModelDecal/Settings",
// "AI/WeaponContext", "AI/GoalSets", ...) AND `owner_database` reads back
// exactly the owning DatabaseMgrSubRecord's address -- zero exceptions.
//
// owner_database is void* for the same cyclic-dependency reason as
// DatabaseMgrRecord.owner_category above (pointee IS DatabaseMgrSubRecord,
// verified by address equality; not spelled in the type system).
//
// num_records/records: CONFIRMED via IDatabaseMgr's own vtable. IDA:
// GameDatabase.dll+0x634F (IDatabaseMgr_GetNumRecords, vt[5]/+0x14 -- ALSO
// reused at vt[18]/+0x48, i.e. one function body serves two vtable slots,
// plausibly ICF/linker-folded) does `return *(hCategory+0x8)`; GameDatabase.
// dll+0x635D (IDatabaseMgr_GetRecordByIndex, vt[19]/+0x4C) does `return
// *(hCategory+0xC) + 24*index` bounds-checked against `*(hCategory+0x8)`.
// Live-verified on "AI/WeaponContext" (num_records=1) and "AI/GoalSets"
// (num_records=83, sampled 3 records) -- every element decodes with a
// readable name and owner backpointer (see DatabaseMgrRecord above).
//
// unk_10: unverified. Small (non-pointer-range) 32-bit values, unique per
// category in every sample -- consistent with a precomputed name hash, not
// otherwise confirmed.
class DatabaseMgrCategory 0x14 {
    strptr name                @0x00   // CONFIRMED live: readable ASCII in 359/359 samples
    void* owner_database        @0x04   // CONFIRMED live: == owning DatabaseMgrSubRecord address in 359/359 samples; see comment above for why this isn't typed DatabaseMgrSubRecord*
    uint32_t num_records       @0x08   // CONFIRMED: matches IDatabaseMgr_GetRecordByIndex's bounds check exactly
    DatabaseMgrRecord* records @0x0C   // CONFIRMED: matches IDatabaseMgr_GetRecordByIndex's array base exactly
    uint32_t unk_10             @0x10   // unverified; small unique-per-category values, plausible name hash
}

// 0x1C-byte record. CONFIRMED IDENTICAL SHAPE observed independently at TWO
// live addresses (DatabaseMgrEntry.record_a and .record_b of the single
// array element currently live) -- same field layout, same self-pointer
// relationship, in both instances. This is the engine's HDATABASE: one
// loaded .gamedb file.
//
// string_data and path_data are typed strptr because their CONTENT WAS
// DIRECTLY READ as null-terminated ASCII, not inferred:
//   record_a: string_data -> "AI\0FX\0FX/ModelDecal/Settings\0..." (packed,
//             multiple concatenated strings; strptr renders only the first)
//             path_data   -> "Database\Loki.gamedb"
//   record_b: string_data -> "ObjectDB\0ObjectRec\0msg system exitlevel..."
//             path_data   -> "worlds\sp\m05_outershell\m05_out..."
// hash_entries points at HashEntry-shaped data (verified 8-byte stride, see
// HashEntry) but its LENGTH is not tied to num_categories/count_b/count_c
// with any confirmed formula -- do not assume a specific entry count from
// those.
//
// num_categories/categories: CONFIRMED via IDatabaseMgr's own vtable +
// live memory cross-check. IDA: GameDatabase.dll+0x62DA
// (IDatabaseMgr_GetNumCategories, vt[9]/+0x24) does `return
// *(hDatabase+0xC)`; GameDatabase.dll+0x62E8 (IDatabaseMgr_GetCategoryByIndex,
// vt[10]/+0x28) does `return *(hDatabase+0x14) + 20*index` bounds-checked
// against `*(hDatabase+0xC)`. Live read (main menu, Database\Loki.gamedb):
// num_categories=359, categories points at EXACTLY record+0x1C (one-past-
// the-end -- the array is allocated inline, trailing the header), and all
// 359 elements at that address with 20-byte stride decode as valid
// DatabaseMgrCategory (name readable ASCII + owner_database backpointer ==
// this record, 359/359 -- see DatabaseMgrCategory above). This supersedes
// the old "self_ref, purpose not verified" note.
//
// count_b: unverified. Live value 24270 on the same snapshot; plausible as
// the string_data pool's byte length (large, plausible-string-blob-sized),
// not otherwise confirmed.
//
// count_c: unverified as a field, but vtable evidence is suggestive: two
// vtable functions explored during category/record mapping (IDA
// GameDatabase.dll+0x62A9 and +0x6FC9, NOT renamed -- behavior partially
// understood, not enough to commit a name) increment/decrement a DWORD at
// `handle+0x18` when producing/releasing a lookup result, i.e. exactly this
// field's offset on this struct. Consistent with a refcount, not proven by
// a direct before/after live test.
class DatabaseMgrSubRecord 0x1C {
    strptr string_data              @0x00
    HashEntry* hash_entries          @0x04
    strptr path_data                @0x08
    uint32_t num_categories          @0x0C   // CONFIRMED: matches IDatabaseMgr_GetCategoryByIndex's bounds check exactly (359/359 live-verified)
    uint32_t count_b                 @0x10   // unverified; live value 24270, plausibly string_data pool byte length
    DatabaseMgrCategory* categories  @0x14   // CONFIRMED: == this+0x1C (inline trailing array); matches IDatabaseMgr_GetCategoryByIndex's array base exactly
    uint32_t count_c                 @0x18   // unverified; vtable evidence suggests a refcount (see comment above)
}

// One 8-byte array element of DatabaseMgr's internal array (confirmed size:
// (array_end - array_begin) == 8 bytes for the current 1-element span).
// Both fields point to a DatabaseMgrSubRecord (see above; verified identical
// shape at both addresses).
class DatabaseMgrEntry 0x8 {
    DatabaseMgrSubRecord* record_a   @0x00
    DatabaseMgrSubRecord* record_b   @0x04
}

// Live-memory mapped from the running FEAR2.exe (32-bit). Singleton resolved
// via gamedatabase.dll export LTGetIDatabaseMgr -> GameDatabase.dll + RVA
// 0x122BC (module-relative; use GameDatabase.dll+0x122BC in ReGenny, do not
// hardcode the absolute VA -- it moves with module placement).
//
// Mapped by READING LIVE MEMORY ONLY (regenny_lua_eval) -- no decompilation
// used for this pass. Offsets 0x00-0x14 are STRUCTURALLY confirmed: the
// begin/end/cap_end pointer math is self-consistent
// ((end-begin) == unk_14 * sizeof(DatabaseMgrEntry)) in every observed
// snapshot; vtable dereferences to 64 readable code pointers, all inside
// GameDatabase.dll's real image bounds.
//
// NOTE (2026-07): this is the LOW-LEVEL engine IDatabaseMgr singleton in
// gamedatabase.dll, NOT the game-layer CGameDatabaseMgr wrapper (which lives
// in gameclient.dll/gameserver.dll with its own std::string + HDATABASE
// fields per lithtech/FEAR/Shared/GameDatabaseMgr.h -- a DIFFERENT object,
// do not conflate the two).
//
// Snapshot (2026-07, main menu, one array element registered):
//   +0x18..+0x5C all zero -- struct size beyond +0x18 unconfirmed, sized
//   0x20 here for headroom only.
class DatabaseMgr 0x20 {
    DatabaseMgrVTable* vtable        @0x00
    uint32_t unk_04                  @0x04   // observed 0; role unverified
    DatabaseMgrEntry* array_begin    @0x08
    DatabaseMgrEntry* array_end      @0x0C
    DatabaseMgrEntry* array_cap_end  @0x10
    uint32_t unk_14                  @0x14   // observed 1; equals (array_end-array_begin)/8 in every snapshot so far
}

// 8-byte intrusive circular-list link. A generic, engine-wide list utility
// (used far outside CClientMgr; NOT reverse-engineered as a general
// facility here, only enough to explain the heads/links that embed it).
// CClientMgr embeds two sentinel heads of this shape (counter_list_head
// @0x13EC, start_shell_list @0x1460) and LTObject embeds one @0xAC.
//
// Declared HERE, above its first by-value user, on purpose: `.genny`
// forward declarations (`struct Foo {}`) make a name RESOLVABLE, which is
// enough for POINTER members, but the forward-declared type resolves with
// size 0 -- so anything embedding it BY VALUE would silently get a 0-byte
// member. By-value users therefore need the real definition first.
//
// next: CONFIRMED live (2026-07) for counter_list_head specifically:
// counter_list_head.next == CClientMgr.own_counter_node + 0x14 exactly, in
// the same live snapshot that also matched CClientMgr::Init's insertion
// code (dump 0x415B54: `*(result+20)=*this; *this=result+20;` -- i.e. the
// newly-inserted node's link portion begins at node+0x14, and the head's
// own `next` field points at it). Also confirmed by every LTObject list
// walk: 3506 objects reached by following `.next` from 7 heads.
// prev: position inferred from the same 8-byte link shape; not
// independently read live.
class CClientMgrListLink 0x8 {
    CClientMgrListLink* prev  @0x00   // CONFIRMED live: circular doubly-linked. Walked all 7 object_lists buckets (3489 nodes): every node's prev == its predecessor, and each head's prev == that list's LAST node. 0 failures.
    CClientMgrListLink* next  @0x04   // CONFIRMED live: every bucket walk closes back on its own head (see above)
}

// The world tree's link. DELIBERATELY NOT CClientMgrListLink: that type is
// prev@0x00 / next@0x04, and this one is the other way round. A node's object
// list is traversed by following +0x00 from the head, which is what reaches
// every object (verified: 2142 objects across 285 occupied nodes, every list
// closing back on its own head). Reusing CClientMgrListLink here would compile
// and walk -- a circular list walks fine in either direction -- while silently
// meaning the opposite thing.
//
// Honest limit on the naming: LTWorldTree_RemoveObject's unlink is SYMMETRIC in
// the two fields (it does link[0]->[1] = link[1] and link[1]->[0] = link[0]),
// so the code does not prove which one is "forward". `next` is the field that
// traverses, by convention.
class LTWorldTreeLink 0x8 {
    LTWorldTreeLink* next @0x00   // CONFIRMED as the traversal direction from a node head
    LTWorldTreeLink* prev @0x04
}

// A node of the client world tree -- the spatial index LTObjects are bucketed
// into for culling. Structure recovered from LTWorldTree_FindNodeForObject
// (0x46462F, the descent) and LTWorldTree_RemoveObject (0x4645E7, which walks
// UP), then verified against the live tree by walking all 649 nodes from the
// root at once:
//   * 649 nodes reachable, 285 of them holding objects, 2142 objects, depth 5.
//   * occupied_count == the number of OCCUPIED nodes in that node's subtree,
//     itself included: 649/649, zero mismatches. It is NOT an object count --
//     the root reads 285, not 2142 -- which matches RemoveObject decrementing
//     only when a node's list becomes EMPTY.
//   * parent_offset resolves to the actual parent on 649/649 (0 at the root).
//   * child_offset reproduces the whole tree: the four children live at
//     node + 24*(child_offset + k) for k in 0..3, and 0 means leaf.
//
// It splits on X and Z only -- Y is never divided -- so this is a QUADTREE over
// the ground plane, not an octree.
//
// THE CULL-VOLUME VIRTUAL, since it decides what every spatial structure below indexes:
// object vtable SLOT 2 produces the volume and RETURNS THE SHAPE TAG -- 0 none, 1 sphere,
// 2 box. Per type: OT_NORMAL returns 0 outright; OT_MODEL returns 1 on both its paths (asset
// radius unscaled when sphere_source is set, vis_radius * scale otherwise); OT_WORLDMODEL and
// OT_CAMERA share LTObject_GetCullVolume_AABB and return 2; OT_SPRITE tests its own kind
// (3/4/7/9 -> its OWN aabb pair at +0x120/+0x12C -> 2, else position + radius -> 1); and
// OT_PARTICLESYSTEM returns cull_volume_type itself, so that byte at +0xDD IS the tag.
//
// LTObjectOwner_UpdateSpatialRecord calls it and dispatches on the return to
// LTSpatialRecord_CollectSphere or _CollectAABB, which is what links the volume to the
// visibility structures.

class LTWorldTreeNode 0x18 {
    LTWorldTreeLink objects   @0x00   // CONFIRMED: head of this node's object list; objects link in at LTObject.world_tree_link (+0xC4)
    float split_x             @0x08   // CONFIRMED as a descent comparand: compared against the object's aabb_min.x / aabb_max.x
    float split_z             @0x0C   // CONFIRMED as a descent comparand, against aabb_min.z / aabb_max.z
    uint32_t occupied_count   @0x10   // CONFIRMED 649/649 == occupied nodes in subtree (see above)
    uint16_t parent_offset    @0x14   // CONFIRMED 649/649; parent is `this - 24*parent_offset`, and 0 marks the root
    uint16_t child_offset     @0x16   // CONFIRMED; children at `this + 24*(child_offset + k)`, k in 0..3. 0 == leaf.
}

// NOT claimed: that every object on an INTERNAL node straddles one of that
// node's split planes. The descent inserts at a node when the object's AABB
// crosses a plane, so that would be the tidy story, but live only 332 of 467
// internal-node objects straddle. The counter-examples sit at the root while
// lying wholly inside one quadrant, which is what an object that MOVED after
// being linked looks like -- SetPos updates the AABB and the tree link is only
// revisited when renderability changes. Do not "fix" this by loosening the
// test; it is a property of when the engine re-inserts, not of the layout.

// A vector-like container of 4-byte elements, embedded in CClientMgr @0x68.
// CONFIRMED by its two accessors, which the engine uses on this object:
//   size():       dump 0x61C92C -- `v1 = this[1]; return v1 ? (this[2]-v1)>>2 : 0`
//   operator[]():  dump 0x46D362 -- `if (i >= size()) invalid_parameter();
//                                    return this[1] + 4*i`
// so begin is at +0x04 and end at +0x08, elements 4 bytes wide. dump
// 0x44ED89 uses `g_pClientMgr + 104` (this object) as a drop-in FALLBACK
// for `dword_6F3080 + 1064`, which is what pins it as this shared container
// type rather than something CClientMgr-specific.
//
// header: the DWORD at +0x00 is NOT part of begin/end. Its low byte is read
// and cleared as a flag by dump 0x40CB42 (`if (this[104]) {...}
// this[104] = 0;`). Read 0 live. Whether the upper 3 bytes are part of the
// same flag word, padding, or something else is unverified.
//
// Size 0xC covers only the three confirmed DWORDs -- a capacity/allocator
// field may follow; not investigated.
class CClientMgrPtrVector 0xC {
    uint32_t header @0x00   // low byte used as a commit-and-clear flag (dump 0x40CB42); rest unverified
    void** begin    @0x04   // CONFIRMED via size()/operator[] (dumps 0x61C92C / 0x46D362)
    void** end      @0x08   // CONFIRMED via size() (dump 0x61C92C)
}

// One CONSOLE VARIABLE. Mapped entirely from the engine's own accessors, and the
// record base is offset from the link -- which is the only fiddly part.
//
// CLTClient_GetSConValueFloat reads `*(float*)rec` and GetSConValueString reads
// `*(char**)(rec + 20)`, where rec comes from ConVarTable_FindInBucket, whose last act
// is `return link - 4`. So the intrusive link sits at record+0x04 and everything else
// is placed around it.
//
// Live: 192 entries across the table, 191 with a non-empty name -- Spawn_Debug,
// PhysicsExplosionForce, PhysicsBulletForce, MotionBlur_PassCount, HDR_ToneMapExponent,
// HDR_Blur, BodyCapRadius, AddAmbientLightHigh, DetailWMMaxRadialCheckPerFrame. These
// are the engine's and game's tunables.
class LTConVar 0x18 {
    float value              @0x00   // CONFIRMED: GetSConValueFloat returns exactly this. Live it agrees with the string form on every entry that has one.
    CClientMgrListLink link  @0x04   // CONFIRMED the bucket's intrusive link, and the reason record != link: the finder walks `link = link->next` and hands back `link - 4`.
    uint32_t name_hash       @0x0C   // CONFIRMED the CASE-INSENSITIVE name hash the finder compares before the string compare, and it is the SAME String_HashI already mapped for skeleton node names -- reimplemented against this table it reproduces all 191 stored values exactly. It also selects the bucket: `hash & 0x7F` equalled the containing bucket index on 191/191, no exceptions.
    char* name               @0x10   // CONFIRMED the variable's name, from the finder's own String_EqualsI argument
    char* string_value       @0x14   // CONFIRMED: GetSConValueString copies the string at this offset. Live most entries hold a formatted copy of `value`; some hold nothing while `value` is meaningful, so prefer the float unless the text is wanted.
}

// The console-variable HASH TABLE: 128 buckets of one link pair each.
//
// The bucket count is the engine's, straight out of `link = base + 8 * (hash & 0x7F)`.
// The BASE is two hops: callers pass `g_pClientMgr + 0xC0` to ConVarTable_Find, which
// adds 0x24 before walking -- so the buckets live at CClientMgr+0xE4 and the array ends
// at 0xC0 + 0x24 + 0x400 == 0x4E4, exactly where the next mapped CClientMgr field
// starts. That adjacency is what pins the size.
//
// Live 28 of the 128 buckets are empty and the longest chain is 5.
class LTConVarTable 0x424 {
    CClientMgrListLink buckets[128] @0x24   // CONFIRMED: 128 link pairs, self-pointing when empty. Everything below +0x24 is unmapped -- no accessor read so far touches it.
}

// Object type. The VALUE SPACE is confirmed: CClientMgr.object_lists has
// exactly 7 buckets (0..6), every object's .type equals its bucket index
// (0 mismatches / 3490 live objects, single traversal), and each bucket
// holds exactly one distinct vtable with ZERO vtables shared between
// buckets (914/183/1476/221/-/474/222 objects behind vtables 0x00672360 /
// 0x006736B0 / 0x006776E8 / 0x00671018 / - / 0x00677728 / 0x00670FD8).
// That proves one concrete class per bucket.
//
// The NAMES below are SOURCE-ANALOGUE ALIASES, not FEAR2-confirmed. They
// come from lithtech/sdk/inc/ltbasedefs.h's object-type enum (OT_NORMAL..
// OT_PARTICLESYSTEM occupy exactly 0..6 there, and FEAR2 has exactly 7
// buckets -- a strong structural match). Per AGENT.MD rule 9 the FEAR1/
// LithTech sources are analogues for NAMING ONLY, never ground truth for
// this build, and two observations argue for caution: OT_LIGHT (4) held
// ZERO objects in a fully-loaded scene, and OT_CAMERA (5) held 474 --
// unexpected if those labels are literal. Treat a name here as "the
// LithTech slot with this index", not as a verified FEAR2 semantic.
// RTTI is stripped from the shipping build, so the real class names could
// not be recovered that way.
enum LTObjectType : uint8_t {
    OT_NORMAL = 0,
    OT_MODEL = 1,
    OT_WORLDMODEL = 2,
    OT_SPRITE = 3,
    OT_LIGHT = 4,
    OT_CAMERA = 5,
    OT_PARTICLESYSTEM = 6,
}

// 3-float vector. Confirmed by content: LTObject.position below reads as
// plausible world coordinates (e.g. 3640.5, 1424.0, -1765.8) across every
// sampled object.
class LTVector 0xC {
    float x @0x00
    float y @0x04
    float z @0x08
}

// 4-float quaternion. CONFIRMED BY INVARIANT, not by guess: sampled the
// 4 floats at LTObject+0x20 across 3506 live objects and computed the
// magnitude -- 3506/3506 (100.0%) were unit-length within 1e-2. Random
// memory does not do that; only a real normalized quaternion does.
class LTRotation 0x10 {
    float x @0x00
    float y @0x04
    float z @0x08
    float w @0x0C
}

// The engine's client-side object (LithTech "LTObject"). CClientMgr keeps
// every one of these in the 7 type-bucketed lists at CClientMgr+0x00 (see
// CClientMgr.object_lists).
//
// CONFIRMED LIVE across 3506 objects walked from all 7 lists in one
// snapshot (main menu):
//   - vtable: 3506/3506 (100.0%) point inside FEAR2.exe's image.
//   - rotation: 3506/3506 (100.0%) unit-length quaternion (see LTRotation).
//   - type: the byte at +0x10 EQUALS THE INDEX OF THE LIST the object was
//     found in. Per-type counts matched per-list counts exactly for lists
//     0/2/3/5 (914, 1480, 220, 474); lists 1 and 6 drifted slightly (192 vs
//     202, 226 vs 264) purely because the game is LIVE and creating/
//     destroying objects between the two walks. That is what makes
//     "object_lists is bucketed BY TYPE" a confirmed fact rather than a
//     hypothesis.
//
// list_link @0xAC: CONFIRMED -- every list walker in the engine recovers the
// object base as `link - 172` (dump 0x40B52A `v3 = v2 - 172`, dump 0x40D065
// `j - 172`). The lists thread through THIS field, not the object base.
//
// handle @0x12: CONFIRMED sentinel semantics -- dump 0x40B287 does
// `v2 = *(WORD*)(a1+18); if (v2 != 0xFFFF) sub_40A4A8(v2);` i.e. 0xFFFF
// means "no handle". Sampled object read exactly 0xFFFF.
//
// position/rotation: offsets confirmed by the quaternion invariant above
// (a wrong offset would not produce 100% unit-length) plus plausible
// world-coordinate content in position. What they are RELATIVE TO (world
// origin? parent?) is not investigated.
//
// unk_38: CONFIRMED as a pointer the engine treats as owned/refcounted --
// dump 0x40B287 and 0x40D065 both pass `*(a1+56)` to sub_445B16 during
// teardown; 0x40B287 also tests `*(BYTE*)(*(a1+56)+47) & 1`. Pointee not
// mapped.
//
// flags @0x44: CONFIRMED as a bitfield -- dump 0x40B287 tests
// `(*(WORD*)(a1+68) & 0x600) != 0`. Individual bit meanings unverified.
//
// unk_D8: RELOCATED OUT OF THIS CLASS. It is only touched when type == 6
// (dump 0x40B287 passes it to off_6ECC90's vtable slot 50, then zeroes it),
// and the allocator evidence below proves why: at +0xD8 it lies OUTSIDE a
// base LTObject entirely. It is a field of the particle-system subclass
// (264 bytes), not of LTObject (204). Left unmapped rather than guessed at
// on a subclass that has no other mapped field yet.
//
// SIZE 0xCC (204) is the ALLOCATION SIZE the engine requests for a type-0
// object -- not a proven nominal C++ `sizeof` of a base subobject. Stride and
// allocator size cannot distinguish "sizeof(LTObject)" from "sizeof(whatever
// concrete class OT_NORMAL uses)"; OT_NORMAL objects are plain base objects in
// the reference SDK, which makes them the same thing there, but that is
// analogue reasoning and stays labelled as such. Treat 0xCC as a hard upper
// bound for anything overlaid on a type-0 object.
//
// Derived from the engine's own per-type pool allocators (see
// CClientMgr.object_banks):
//   * CClientMgr's bank for OT_NORMAL records element_size 204, and its pool
//     has block_size 208 == (204 + 8) & ~7.
//   * Live, the MINIMUM address spacing between two OT_NORMAL objects is
//     exactly 208 across 919 objects -- consecutive slots in that pool.
//   * That bank's chunk contains ONLY type-0 objects (56 in-chunk, 0 of any
//     other type), so the size belongs to type 0 specifically.
//   * Every field mapped below ends at or before 0xB4, well inside 204.
//
// The other types' allocation sizes come from the same source (element_size
// per bank): OT_MODEL 408, OT_WORLDMODEL 316, OT_SPRITE 340, OT_CAMERA 320,
// OT_PARTICLESYSTEM 264. Those are the derived classes; only the shared
// prefix is mapped here, and no derived field is claimed.
//
// The per-object spatial/visibility record LTObject.spatial_record points at.
// Declared BEFORE LTObject because genny resolves types in file order and
// LTObject holds a pointer to this; `object` below is therefore void* rather
// than LTObject*, since typing both directions would be circular.
//
// The size here is the MAPPED EXTENT, not a proven class size: the true size is
// unknown, fields beyond +0x3C exist (0xFFFFFFFF was observed at +0x40), and
// parts of the layout are type-dependent.
//
// Its HEAD holds the CULL VOLUME the object's vtable slot 2 produced -- that is
// how the volume reaches the spatial queries. Verified against the typed sources
// on every live object, per type:
//   OT_NORMAL          919/919   all six floats zero -- slot 2 returns 0
//   OT_MODEL           193/193   position + vis_radius*scale (sphere branch)
//   OT_WORLDMODEL     1472/1473  aabb_min / aabb_max
//   OT_SPRITE          224/224   both kinds -- AABB fields, or position + radius
//   OT_CAMERA          474/474   aabb_min / aabb_max
//   OT_PARTICLESYSTEM  278/278   both kinds, offsets added to position
// The single OT_WORLDMODEL exception is the level-geometry object, whose flags3
// bit 0x80 makes slot 2 return 0, so there is no unexplained residue.
//
// This is the strongest cross-check in the schema so far, because the engine
// wrote these bytes independently of the fields they are compared against: it
// ties LTObject's position/aabb_min/aabb_max/scale, LTModelObject's vis_radius,
// LTSpriteObject's kind/aabb/radius and LTParticleSystemObject's
// cull_volume_type/offsets to one separate copy of the same values. A single
// moved offset in any of those breaks it.
// One object<->hit association. Each entry is a member of TWO lists at once,
// with DIFFERENT linkage disciplines, which is why it carries two link groups:
//   * the RECORD's list -- singly linked through record_next, head at
//     LTSpatialRecord.entry_list, length counted in LTSpatialRecord.entry_count.
//   * the HIT's list -- doubly linked through hit_prev/hit_next, whose head
//     lives elsewhere and is reached through hit_head. Being doubly linked is
//     what lets LTSpatialRecord_DetachEntries unlink an entry from the hit side
//     without walking that list.
//
// Structure recovered from LTSpatialRecord_LinkEntry (0x4456DB) and
// LTSpatialRecord_DetachEntries (0x44559D), then verified live over every object:
//   * entry->record == the record that lists it, 3583/3583 records clean.
//   * hit-side links are mutually consistent -- for every entry, hit_next's
//     hit_prev points back, hit_prev's hit_next points back, and an entry with
//     no hit_prev is the one its hit_head points at: 3583/3583.
// Size is the mapped extent; LinkEntry writes exactly these five fields.
class LTSpatialEntry 0x14 {
    void* record            @0x00   // CONFIRMED: the owning LTSpatialRecord. void* to avoid a circular type reference.
    void** hit_head         @0x04   // CONFIRMED: points AT the hit's list-head slot, not at the head element -- DetachEntries writes `*hit_head = hit_next` when this entry is first. The hit itself is unmapped.
    LTSpatialEntry* record_next @0x08   // CONFIRMED: next entry in the RECORD's list (singly linked)
    LTSpatialEntry* hit_prev @0x0C   // CONFIRMED: previous entry in the HIT's list
    LTSpatialEntry* hit_next @0x10   // CONFIRMED: next entry in the HIT's list
}

// (record class continues below)
class LTSpatialRecord 0x40 {
    float volume[6]     @0x00   // CONFIRMED: sphere shapes use [0..2] centre + [3] radius; AABB shapes use [0..2] min + [3..5] max. WHICH shape applies is recorded in volume_flags below -- an earlier pass asserted it was "a property of the owning object, not of any field here", and the engine's own writers refute that.
    uint8_t volume_flags @0x1B  // CONFIRMED bit 0x80 IS THE SHAPE TAG: set = the volume holds a SPHERE, clear = an AABB. Written by the only two functions that store a volume, on the record itself (`mov ecx, [esi+38h]` picks the record before both calls): LTSpatialRecord_SetSphere (0x40C715) writes volume[0..3] and `or byte ptr [ecx+1Bh], 80h`; LTSpatialRecord_SetAABB (0x40C748) copies volume[0..5] through LTBoundingBox_Assign and `and byte ptr [ebx+1Bh], 7Fh`. Live over the 1884 records holding entries: 635 tagged sphere, 1249 tagged AABB. NOTE the tag is only meaningful once a volume has been stored -- LTObjectOwner_UpdateSpatialRecord calls neither setter when the cull volume is kind 0, so the bit keeps whatever it last held; existence comes from the gate, the LAYOUT comes from here. Remaining bits of this byte, and the rest of the dword at 0x18, unmapped.
    uint16_t entry_count @0x30  // CONFIRMED uint16: LinkEntry increments it per entry and DetachEntries zeroes it alongside entry_list. Live it equals the walked length of entry_list on 3583/3583 records -- so it is a maintained count, not a hint. Note the upper half of this dword is a SEPARATE field (live 0x9249 on many records), which is why this is 16-bit.
    uint8_t client_flags @0x2F  // CONFIRMED as the engine's FOURTH flag kind. LTObject_SetFlagsByType (0x44E53B) routes kind 3 here -- `if (obj->flags3 & 0x400) *(uint8_t*)(record + 0x2F) = value` -- and the reference SDK's matching enum names kind 3 OFT_Client ("client flags, not available on server objects"). So the client flags live on the RECORD, not on the object, which is why they were not found alongside flags/flags2/user_flags. Bit meanings unmapped, and note the write is gated on flags3 bit 0x400 (set on 3583/3583 live).
    void* object        @0x38   // CONFIRMED backpointer to the owning LTObject on 3583/3583. void* only to avoid a circular type reference; it is always an LTObject*.
    LTSpatialEntry* entry_list @0x3C   // CONFIRMED head of this record's association list, rebuilt by LTSpatialRecord_CollectSphere / _CollectAABB. THE LIST IS THE QUERY'S OUTPUT: CollectSphere is literally LTVisTree_QuerySphere with LTSpatialRecord_AddEntry as the callback, so each entry names a sector the volume overlapped -- which makes these entries an oracle for any reimplementation of that query (sdk::VisTree reproduces all 2565 live entries with zero unreachable). THE GATE IS EXACT AND ASYMMETRIC: LTObjectOwner_UpdateSpatialRecord stores the volume UNCONDITIONALLY and collects only `if ((flags & 1) && !(flags2 & 0x700))` (= sdk::is_renderable), so a non-renderable object holds a CURRENT volume beside a RELEASED list -- 1087 of 1087 live non-renderables have an empty list, and 553 of the 569 objects whose entries disagree with their volume are simply gated out rather than stale. Only 16 are genuinely stale, and all 16 differ in one direction only (sectors the query reaches that the record lacks; never the reverse). Live totals: 3666 entries across 3583 records, 1699 of them empty. Per type -- OT_SPRITE 1215 entries over 224 objects, OT_WORLDMODEL 1821/1473, OT_PARTICLESYSTEM 336/278, OT_MODEL 294/215, and ZERO for OT_NORMAL and OT_CAMERA. GATED, and this is what makes the two zeroes different: LTObjectOwner_UpdateSpatialRecord only collects when `(flags & 1) && !(flags2 & 0x700)` -- otherwise it calls LTSpatialRecord_Release and the list stays empty. Live the gate is NECESSARY: 1884 records hold entries and every one satisfies it, with 0 counter-examples out of 3583. It is not sufficient -- 40 gated objects still hold nothing, because their volume can miss every sector. OT_NORMAL's zero is because slot 2 returns no volume at all (only 2 of its 919 even pass the gate). OT_CAMERA's zero, which an earlier pass left as "unexplained", is the gate: ZERO of the 474 cameras have flags bit 0 set. It is not geometric -- 459 of their volumes do overlap at least one sector. So cameras are renderable via flags 0x800 and world-tree linked, yet never visibility-associated.
}

// One clipping plane of a visibility sector. Stride is 20 bytes, taken from the
// test loop's `v7 += 20` in LTVisSector_TestSphere.
//
// CONFIRMED live: across every sector that has planes (19 of 263), all normals
// are unit length to within 0.01. That is the check that makes the normal/
// distance split real rather than assumed -- a wrong offset would give lengths
// scattered around arbitrary values.
class LTVisPlane 0x14 {
    LTVector normal   @0x00   // CONFIRMED unit length on every plane of every sector that has any
    float distance    @0x0C   // CONFIRMED: the test compares a point-distance against this. // THE SIGN CONVENTION IS THE ENGINE'S AND POSITIVE IS INSIDE: LTVisSector_TestSphere checks the sector's AABB first, then rejects a sphere when `dot(normal, center) - distance < -radius`, i.e. when the volume lies wholly on the NEGATIVE side. Corroborated live from the other direction: all 125 planes across the 19 plane-bearing sectors read POSITIVE at their own sector's box centre (125/125, none negative), so an implementation treating negative as inside rejects every plane-bearing sector outright. This project had the sign inverted for several passes and nothing caught it -- the only query that exercised planes lands in a box-only sector (244 of 263 are), and the brute-force oracle called the same predicate.
  uint32_t corner_code @0x10 // CONFIRMED a 3-bit AABB CORNER SELECTOR, derived from `normal`, used only by the BOX path. LTVisPlane_RejectsAABB passes it to LTVisPlane_SelectAABBCorner, which indexes g_LTVisAABBCornerTable (0x6749D8, eight 3-tuples) to build one corner out of the query box's six floats: bit0 -> x=max, bit1 -> y=MIN, bit2 -> z=max. That is the corner MAXIMISING dot(normal, corner), i.e. the one reaching furthest toward the plane's positive side, so the reject `dot(normal, corner) - distance < 0.0` fires only when the WHOLE box lies negative -- the same "wholly on the negative side" rule the sphere path spells as `< -radius`, and a third independent confirmation that POSITIVE IS INSIDE. Rule pinned live: taking max where the component is >= 0 and min where it is < 0 reproduces all 125 codes (125/125; every one of them has a zero component, so the >= tie-break is what the data settles). Codes seen: 0,1,4,5,7. IT IS A CACHE OF THE NORMAL, so anything writing a normal must rewrite this or the box test silently picks the wrong corner -- see sdk::VisTree::plane_corner_code_is_current.
}

// A visibility sector: a convex region described by an AABB plus optional
// clipping planes, holding the list of objects currently associated with it.
// This is the far end of LTSpatialEntry.hit_head -- the thing objects associate
// WITH.
//
// Layout from LTVisSector_TestSphere (0x445F38), which AABB-tests `hit + 0x04`
// and then walks `*(uint8*)(hit + 0x24)` planes from `*(hit + 0x28)`. That also
// pins entry_list at +0x00, since the entry's hit_head values ARE sector
// addresses and the six floats immediately after them are the AABB.
//
// CONFIRMED live -- the sectors form one contiguous array, and the association
// is verified from BOTH ends:
//   * 263 records at stride 48 starting at a single base, every AABB ordered
//     (min <= max componentwise).
//   * Walking each sector's OWN list via hit_next reached 3666 entries, exactly
//     the 3666 the object side produced, and 263/263 sectors' lists were
//     set-equal to the entries that name them. Neither side has an entry the
//     other does not.
// Sector occupancy is very uneven: the busiest holds 197 entries, and 1699 of
// the 3583 object records associate with nothing at all.
class LTVisSector 0x30 {
    LTSpatialEntry* entry_list @0x00   // CONFIRMED: head of this sector's entry list, threaded through LTSpatialEntry.hit_prev/hit_next. LTSpatialEntry.hit_head points AT this slot.
    LTVector aabb_min   @0x04   // CONFIRMED: AABB-tested by LTVisSector_TestSphere; ordered against aabb_max on 263/263
    LTVector aabb_max   @0x10   // CONFIRMED
    float unk_1C        @0x1C   // unmapped; live 0.1 on a sampled record
    uint32_t index      @0x20   // CONFIRMED THE SECTOR'S OWN INDEX: read across all 263 sectors the values are 0,1,2,...,262, exactly one of each. Loaded from the file header by LTVisSector_LoadFromStream (`*(DWORD*)(this+32) = v21`), not computed at runtime. An earlier pass recorded this as "live 0 or 1" from a one-record sample, which is precisely what a self-index looks like when you only ever read sector 0 and 1 -- a flag and a counter are indistinguishable until the whole population is read. Useful as an independent check on the pointer-to-index arithmetic every accessor here does: sdk::VisTree::sector_index_is_stored_index compares the two.
    uint8_t plane_count @0x24   // CONFIRMED: the plane loop's bound, read as a BYTE. Live, only 19 of 263 sectors have any planes -- the rest are AABB-only, which is why the loop is skipped for them.
    uint8_t portal_count @0x25  // CONFIRMED the length of `portals` below. LTVisSector_LoadFromStream reads it as a byte and immediately allocates `4 * portal_count` for the array. Live it sums to 688 across the 263 sectors == 2 x 344 portals exactly, i.e. every portal is listed by precisely its two sectors.
    uint8_t unk_26      @0x26   // CONSTRUCTOR DEFAULT IS 0, unlike unk_27's 0xFF -- LTVisSector_Construct zeroes this one, so 0 is a meaningful "nothing set" here. FLAGS, not a stamp. LTVisSector_LoadFromStream writes a literal 35 (0b100011) into it, yet live only 62 of 263 still hold 35 -- the other 201 hold 3 (195) or 1 (6), so a later pass clears bits down. STATIC once set: re-read after ~0.5s of gameplay, 0 of 263 changed, which rules out a per-frame visit stamp. The observed values nest (1 = b1, 3 = b11, 35 = b100011), consistent with bits being cleared rather than a small enum. Which pass clears them is unmapped.
    uint8_t unk_27      @0x27   // THE CONSTRUCTOR INITIALISES IT TO 0xFF, which is only initialisation and not yet meaning: LTVisSector_Construct (0x4460FA) zeroes the whole 0x30-byte record and the bytes at 0x24/0x25/0x26, then writes 0xFF here specifically. Being singled out that way is consistent with an unset marker, but nothing READS it yet, so what 0xFF means at runtime is unestablished -- the one live sector holding 255 might be unset or might be a real value. Live: exactly one of 263. THE VALUE DISTRIBUTION ARGUES AGAINST AN INDEX, though: 8 appears 134 times, 1 fifty-three times, then 3, 6, 10 and 0, which is a small repeated vocabulary rather than the mostly-distinct values an index into a table would give. A kind, group or flag-set is the better reading, and it is not named until something reads it. Loaded from the file record by LTVisSector_LoadFromStream, alongside the counts. Live distribution 8:134, 1:53, 3:36, 6:18, 10:17, 0:4 and a single 255 -- small values plus what looks like a 0xFF "none" sentinel, so an index or kind rather than a bitfield. Meaning unmapped.
    LTVisPlane* planes  @0x28   // CONFIRMED: base of the plane array walked at stride 20. NOTE the file stores only 16 bytes per plane -- LTVisPlane_LoadFromStream copies those (normal + distance) and then COMPUTES the fifth field via LTVisPlane_ComputeCornerCode, which is why corner_code is a cache rather than data: it never existed in the asset.
    void** portals      @0x2C   // Always an LTVisPortal**; void** because LTVisPortal.sector_a points back here and the schema has no forward declarations -- the same reason LTSpatialRecord.object is void*. CONFIRMED an array of `portal_count` POINTERS into the tree's portal table. LTVisSector_LoadFromStream reads a portal INDEX per element and stores `portal_table[index]`, then calls LTVisPortal_AttachSector to register this sector into the portal's first free sector_a/sector_b slot. THAT MAKES THIS THE PRIMARY DATA and LTVisPortal.sector_a/sector_b the derived back-references -- the symmetry an earlier pass asserted over the portal table is guaranteed by construction from this side. Verified live from the other direction anyway: all 688 listed portals name their listing sector in one of their two slots, 0 failures and 0 nulls. An earlier pass recorded this as holding "the same value as planes", which was one sampled sector's adjacent allocations coinciding.
}

// A node of the visibility KD-tree. Layout from LTVisTree_QuerySphere (0x4458D2)
// and LTVisTree_QueryAABB (0x445825), which are the same walk over a sphere or
// an AABB.
//
// split_axis doubles as the LEAF MARKER: the walk treats any value > 2 as "no
// split here, pop the stack", so a leaf is encoded by putting an out-of-range
// axis in the field rather than by a separate flag.
//
// CONFIRMED live by walking from LTVisTree.root: 111 nodes reached, depth 7,
// yielding 263 distinct elements -- every one of them a correctly-aligned entry
// of LTVisTree.sectors, with none outside it. The node count matched
// LTVisTree.node_count exactly.
class LTVisTreeNode 0x18 {
    LTVisSector** elements @0x00   // CONFIRMED: array of sector pointers held at this node -- AND INTERNAL NODES CARRY THEM, not just leaves. That is the fact a point-location query turns on: a sector spanning a whole subtree's region is attached at the node covering it rather than pushed down into every leaf below, so descending to a leaf and reading only its elements MISSES it. Measured: descending to the leaf for the player's position offered 2 sectors and the one he was actually inside (142 of 263, found by scanning all of them) was not among them; collecting elements at every node along the path gives 19 candidates and includes it. The engine's own walk (LTVisTree_QuerySphere) tests elements at each node it visits for exactly this reason.
    uint32_t element_count @0x04   // CONFIRMED: its length; the walk tests each element against the query volume
    LTVisTreeNode* child_a @0x08   // CONFIRMED: taken when the query lies on one side of the split
    LTVisTreeNode* child_b @0x0C   // CONFIRMED
    uint32_t split_axis    @0x10   // CONFIRMED: 0/1/2 index the query volume's components; > 2 means LEAF
    float split_value      @0x14   // CONFIRMED: compared against the query volume's component on split_axis
}

// A visibility PORTAL: the connection between two sectors, and the other half of
// the visibility graph. 344 of them live, joining 262 of the 263 sectors (one
// sector has no portals at all).
//
// Found by resolving what LTVisTree's unmapped +0x00/+0x10 pair pointed at. The
// stride is pinned by arithmetic rather than guessed: the region between the
// pointer table and the sector array is 31648 bytes for 344 entries, exactly
// 92 = 0x5C each, and the mapped fields below fill that to the byte.
//
// CONFIRMED live on all 344, with no exceptions:
//   * plane_normal is unit length.
//   * center lies ON the plane -- dot(plane_normal, center) == plane_distance.
//   * sector_a and sector_b are both aligned entries of LTVisTree.sectors, and
//     no portal joins a sector to itself.
//   * vertex_count is 4 on every single one, and all four vertices satisfy the
//     plane equation.
// An earlier guess that this region held bare 4-vertex quads was WRONG and was
// tested: read as 12 floats only 45 of 344 were coplanar. The quads are real but
// they start at +0x2C, behind the plane and the sector pair.
// VARIABLE-LENGTH RECORD: LTVisPortal_LoadFromStream sizes each one `12*(vertex_count-1) + 56`,
// so 0x5C is the size of a FOUR-vertex portal and nothing more. It holds for every portal in
// this level (344/344 have vertex_count 4, and all 343 consecutive pointer gaps are exactly 92
// bytes, which the formula predicts exactly), but it is a property of the art.
//
// SO INDEX PORTALS THROUGH LTVisTree.portals, NEVER by striding 0x5C from the first body. The
// pointer table is the authority; the contiguity is a consequence of one allocation being
// carved up in order, not a guarantee.
class LTVisPortal 0x5C {
    LTVector plane_normal  @0x00   // CONFIRMED unit length 344/344
    float plane_distance   @0x0C   // CONFIRMED: center and all four vertices satisfy dot(n,p) == this
    LTVector center        @0x10   // CONFIRMED on-plane point; a centroid by position, though nothing read so far proves it is the exact centroid
    float radius           @0x1C   // bounding radius about center; magnitude is plausible (1030..2154 live) but no reader has been traced
    LTVisSector* sector_a  @0x20   // CONFIRMED aligned sector pointer
    LTVisSector* sector_b  @0x24   // CONFIRMED aligned sector pointer, never equal to sector_a
    uint32_t vertex_count  @0x28   // CONFIRMED == 4 on 344/344 -- BUT 4 IS THIS LEVEL'S ART, NOT A LIMIT. An earlier pass guessed "4 may be a hard maximum"; the allocator refutes it. LTVisPortal_LoadFromStream reads this count first and then allocates `12*(count-1) + 56` bytes, i.e. a 44-byte head plus 12 per vertex, so a 6-vertex portal is simply a 116-byte record. Read this field; never assume the array's declared length.
    LTVector vertices[4]   @0x2C   // CONFIRMED: all vertices lie on the plane. THE RECORD IS VARIABLE-LENGTH and this array really has `vertex_count` elements -- 4 is declared because that is what every portal in this level has and what the schema language can express. A consumer reading more than vertex_count entries reads whatever follows the record.
}

// The visibility tree manager -- the root of the whole vis subsystem, and the
// reason it can be reached without a pattern scan of its own.
//
// IT IS AN EMBEDDED SUB-OBJECT of the IWorldClientBSP instance, at +0x24:
// that interface's vtable slot 14 is literally `return this + 36`. So
// `interfaces::IWorldClientBSP::get() + 0x24` is the manager, and
// LTObjectOwner_UpdateSpatialRecord obtains it exactly that way before calling
// LTSpatialRecord_CollectSphere / _CollectAABB.
//
// CONFIRMED live, and this is what closed the loop on the sector array: reading
// the header gave the SAME array base (sectors) that an earlier pass had found
// only by scanning outwards from a known slot, plus the count as a field instead
// of an inference.
//   * sectors == the scanned base, sector_count == 263 == the scanned record count.
//   * walking root reached 111 nodes -- equal to node_count -- and 263 distinct
//     elements, all of them aligned entries of sectors, none outside.
//   * LTVisTree_Root is `if (this[6]) return this[5]; else return 0`, i.e. it
//     gates the root on node_count being non-zero. An earlier note called +0x18
//     a "validity flag"; it is the node count, used as a truthiness test.
//
// Size is the mapped extent. unk_00/unk_0C hold the same pointer live and
// unk_10 reads 344, which looks like a second array/count pair, but nothing
// read so far touches them so no claim is made.
class LTVisTree 0x24 {
    LTVisPortal** portals   @0x00   // CONFIRMED: a table of portal_count pointers, immediately followed in memory by the portals themselves and then by `sectors` -- one contiguous allocation. Every pointer equals `table_end + i*0x5C` in order, 344/344.
    LTVisSector* sectors    @0x04   // CONFIRMED: base of the sector array (stride 0x30)
    uint32_t sector_count   @0x08   // CONFIRMED == 263 live, matching the array's extent
    void** portal_table     @0x0C   // CONFIRMED the base of the portal POINTER TABLE, which is why it equals `portals` above: the table sits at the very start of the one allocation (measured -- the first portal body begins exactly at table_base + 4*portal_count). LTVisTree_LoadFromStream keeps this handle to fill the table (`table[i] = LTVisPortal_LoadFromStream(stream)`, portal_count times) and then passes it to LTVisSector_LoadFromStream as the base each sector resolves its portal indices against.
    uint32_t portal_count   @0x10   // CONFIRMED == 344 live. The arithmetic is exact: 344 pointers (0x560 bytes) + 344 portals (0x5C each) lands precisely on `sectors`.
    LTVisTreeNode* root     @0x14   // CONFIRMED: LTVisTree_Root returns this when node_count is non-zero
    uint32_t node_count     @0x18   // CONFIRMED == 111 live, exactly the nodes reached by walking root
    void* traversal_stack   @0x1C   // CONFIRMED: the queries push deferred children here (`v4[7]`)
    void* unk_20            @0x20   // unmapped
}

// The client-side world container: the engine object behind the
// IWorldClientBSP interface. A STATIC INSTANCE in FEAR2.exe's data, whose
// address the interface holder points at.
//
// Reading this header replaced two earlier inferences with fields, and gave the
// world tree a named-global route it did not have before:
//   * bounds_min/max at +0x04 hold the same values as the pair at +0x22C that
//     IWorldClientBSP_IsPointOutsideWorld reads. TWO COPIES, live identical.
//     The slot-16 test uses the +0x22C pair, so that is the authoritative one
//     for "is this point outside the world".
//   * world_tree_root / world_tree_node_count: an earlier pass found the world
//     tree only by climbing parent_offset from a linked object, and counted its
//     nodes by walking. Both are fields here, and both agree exactly -- 649
//     nodes walked == the stored count, and the stored root IS the address that
//     climbing from objects reaches. Two independent routes, same answer.
//   * vis_tree is EMBEDDED at +0x24, which is what IWorldClientBSP's vtable
//     slot 14 returns (`return this + 36`).
//
// THE FILE FORMAT IS "WLDC" VERSION 126: IWorldClientBSP_LoadFromStream (vtable slot 12)
// reads two dwords and rejects anything but magic 0x43444C57 == 'WLDC' and version 126, then
// loads the render data through slot 17 and the vis tree through slot 18 (IWorldClientBSP_LoadVisTree),
// calling slot 5 (IWorldClientBSP_Unload) if either fails -- which is what confirms slot 5's name.
//
// world_path is the loaded world file: live
// "worlds\sp\m05_outershell\m05_outershell.wld". Worth knowing for what the
// "main menu" actually is -- a real level is loaded, which is why 3583 objects
// and 263 vis sectors exist there at all.
//
// SIZE IS BOUNDED BY THE NEXT SINGLETON, not by anything mapped: g_pIWorldServerBSP's object
// sits at 0x6F6D48, exactly 0x170 past this one at 0x6F6BD8, and carries its OWN distinct vtable
// (0x677680, thirteen slots). So this class ends at or before +0x170.
//
// THAT BOUND MATTERS BECAUSE AN EARLIER PASS BROKE IT. This class was recorded as 0x244 with a
// second bounds pair at +0x22C, on the strength of IWorldClientBSP_IsPointOutsideWorld reading
// 0x6F6E04 and the arithmetic 0x6F6BD8 + 0x22C landing on it exactly. The coincidence is real and
// the conclusion was wrong: +0x22C is past the server object entirely. Those addresses are
// FILE-SCOPE GLOBALS (see the block below), which is why the server BSP's own methods -- slots 2,
// 3 and 6 of a different vtable -- reference the very same addresses. Two classes cannot share one
// instance field.
//
// The lesson is cheap to apply: before believing an absolute address is `singleton + offset`,
// check what the NEXT global object's address is. It bounds the class for free.
//
// The world_path array length is the observed string plus its terminator, NOT a proven buffer
// capacity.
//
// ---- THE WORLD BOUNDS GLOBALS (not members of any class) ----
//   g_WorldClientBSP_BoundsMin  0x6F6E04  float[3]
//   g_WorldClientBSP_BoundsMax  0x6F6E10  float[3]
// The authoritative world extent. IWorldClientBSP_IsPointOutsideWorld reads these and ignores
// `this`, which is why it is __stdcall despite being vtable slot 16. LTWorldClientBSP.bounds_min/
// max hold an identical copy live. The SERVER BSP derives from them instead of copying: its world
// load (0x46300B, its vtable slot 6) writes `global_min - 100.0` and `global_max + 100.0` into its
// own +0x04/+0x10, and the 100.0 is dbl_66E370 -- measured live as exactly the offset between the
// two objects' bounds pairs.
class LTWorldClientBSP 0x170 {
    void* vftable              @0x00 [[code]]   // CONFIRMED: live 0x6775F0, and slots 7/13/14/16 are mapped
    LTVector bounds_min        @0x04   // CONFIRMED: equals the +0x22C copy live
    LTVector bounds_max        @0x10   // CONFIRMED
    uint32_t world_tree_node_count @0x1C   // CONFIRMED == 649 live, exactly the nodes reached by walking world_tree_root
    LTWorldTreeNode* world_tree_root @0x20   // CONFIRMED three ways: climbing LTObject.world_tree_link's parent chain reaches it, WorldBSP/VisTree descend from it live, and it is THE ENGINE'S OWN STARTING NODE for insertion. That last one took two indirections to establish and is worth the trail: LTWorldTree_AddObject is `(world, object)` and starts at `world + 0x1C`; `world` comes from the object's owner (LTObject +0x34, the singleton g_LTObjectOwner) through owner vtable slot 3, which forwards to IWorldClientBSP vtable slot 13 -- and that slot is literally `lea eax, [ecx+4]; retn`. So `world` is `bsp + 4` and `world + 0x1C` is `bsp + 0x20`, i.e. this field. An earlier draft nearly recorded `world + 0x1C` as a field of some other class, because +0x1C OF THIS CLASS is the node count (649) and the arithmetic only closes once the +4 is followed. // AND IT IS GROWN, NOT LOADED: LTWorldClientBSP_Construct calls LTWorldTree_InitFields, which zeroes the bounds, sets world_tree_node_count to 1 and leaves this null -- there is no world-tree stream loader at all, unlike the vis tree beside it (IWorldClientBSP_LoadVisTree, vtable slot 18). Nodes appear as objects are inserted through LTWorldTree_AddObject. THAT IS THE STRUCTURAL REASON FOR THE STALENESS ASYMMETRY recorded in reversing/MAPPING_WORKFLOW.md: the vis tree is immutable level data loaded once, so nothing in it can go stale, while this tree indexes moving objects and is mutated at runtime -- so a stale entry here is native to the design rather than a fault.
    LTVisTree vis_tree         @0x24   // CONFIRMED embedded sub-object: IWorldClientBSP vtable slot 14 is `return this + 36`
    void* attach_resource      @0x44   // Created during world attach and returned by vtable slot 15 (`mov eax, [ecx+44h]`). IWorldClientBSP_AttachToServerWorld releases the previous value then reassigns from 0x4633DC; live it is a heap pointer (0x290298A8). What it owns is unmapped.
    uint8_t world_attached     @0x48   // CONFIRMED A LOADED-WORLD FLAG: LTWorldClientBSP_Construct zeroes it and IWorldClientBSP_AttachToServerWorld sets it to 1 on success only, in the same breath as world_attached_2 and the world_path copy. Vtable slot 7 is its getter. Live 1.
    uint8_t world_attached_2   @0x49   // CONFIRMED set to 1 beside world_attached, by the same store pair, and zeroed by the same constructor. Vtable slot 8 is its getter. NO CODE FOUND SO FAR DISTINGUISHES THE TWO -- they are written together and read separately, so they are named as a pair rather than guessed apart. Live 1.
    char world_path[44]        @0x4A   // CONFIRMED: the loaded .wld path, and IWorldClientBSP vtable slot 9 is its getter (`lea eax, [ecx+4Ah]`) -- see sdk::WorldBSP::world_path()/world_name(). Corroborated three ways: the getter's offset, this field, and LTWorldClientBSP_Construct zeroing exactly this byte, which is what an unloaded world looks like. The 44 is 43 observed characters plus a terminator, measured again live. Length is the observed string + NUL; the real buffer is probably larger and its capacity is unverified.
}

// NOT an invariant: object positions lying inside the world bounds. Live it is
// 3579 of 3583, and all 263 vis-sector AABBs fit, but four objects sit outside.
// That is consistent with the engine's own behaviour -- the outside-world test
// exists precisely because objects can leave, and LTObjectOwner_OnObjectChanged
// has a "pin objects that have gone outside the world" path -- so the rate is
// recorded rather than asserted.

// The refcounted record LTObject.shared_ref points at. Reached only from there,
// and only on OT_MODEL objects (36 of 215 live).
//
// Size is the MAPPED EXTENT; the true size is unknown.
//
// What is proven is the LIFETIME MECHANISM, not the payload. The base destructor
// calls 0x415B43 on this, which is `if (--refcount == 0) release(this)`, so it is
// shared and counted. Live refcounts are 1 (x21), 3 (x11) and 35 (x4) -- small,
// positive, and varied, which is what a real count looks like.
//
// The records are threaded among THEMSELVES through +0x00/+0x04: following those
// from one record walks to the others. +0x08 and +0x1C both hold the record's own
// address, and +0x0C/+0x10 are a self-pointing pair (an empty list head).
// Nothing here identifies what resource it represents.
class LTObjectRef 0x28 {
    LTObjectRef* link_prev @0x00   // CONFIRMED: records point at each other through this pair
    LTObjectRef* link_next @0x04   // CONFIRMED
    void* self_08          @0x08   // CONFIRMED == this record's own address
    void* unk_0C           @0x0C   // self-pointing pair with unk_10 -- an empty embedded list head
    void* unk_10           @0x10
    void* unk_14           @0x14   // unmapped heap pointer
    void* unk_18           @0x18   // unmapped heap pointer
    void* self_1C          @0x1C   // CONFIRMED == this record's own address (a second copy)
    uint32_t unk_20        @0x20   // live 0xFFFFFFFF on every sampled record
    uint32_t refcount      @0x24   // CONFIRMED: 0x415B43 decrements this and releases at zero. Live 1/3/35.
}

// One ATTACHMENT record: a child object riding a parent, optionally at a named bone.
// This is the mechanism a VR mod needs for "what is in the player's hands", and the
// whole class was mapped from the engine's own walker rather than by guesswork.
//
// CLTClient_ProcessAttachments -> its worker (0x4094B6) reads `owner + 0xB4` as the
// list head, resolves `record + 0x1C` through CClientMgr_HandleToObject, asks
// ILTCommon's vtable slot 8 for the record's transform, pushes the result through
// IClientShell slots 22/23, then RECURSES into the child's own list -- so attachments
// nest, and the walker proves both the head offset and the link offset.
//
// Live: 139 objects hold lists, 362 records total, every list terminates (lengths
// 1..16, checked with cycle detection), zero cycles.
//
// THE PLAYER'S OWN LIST, which is the case a VR mod cares about: two records, and the
// pass that mapped them is why this class's socket field is now named correctly.
//
//   child 7395  socket_handle 0 -> `RightHand`  weapons\shotgun_clip\shotgun_clip.mdl
//   child 7396  socket_handle 1 -> `LeftHand`   engine\default.mdl
//
// AND A MEASURED AGREEMENT WORTH MORE THAN THE MAPPING ITSELF: each child's own position
// equals, to 0.000, the world transform this project composes independently for that
// socket -- (2153.78, 1554.84, -2227.71) and (2132.06, 1560.98, -2230.70). The engine
// computes placement with its arithmetic (ILTModel_GetSocketTransform, then
// LTTransform_Compose with the record's own offset); we compose ours from the asset's
// socket record and the bone cache. Two unrelated producers of one point, agreeing
// exactly, is the strongest confirmation the composition is correct that this project has.
//
// It is also what CORRECTED the field: an earlier pass read the same values as node
// indices, got plausible bone names out (`Null`, `Pelvis`), and recorded a discrepancy it
// could not explain -- the child was nowhere near the bone the record supposedly named.
// The discrepancy was the evidence, not a curiosity. See socket_handle below.
class LTAttachment 0x30 {
    LTVector offset_position   @0x00   // the child's offset from its attach point. Live all zero on 362/362, which is what an attachment pinned directly to a socket looks like -- so the field is UNEXERCISED here, not proven to be a position.
    LTRotation offset_rotation @0x0C   // live the IDENTITY quaternion (0,0,0,1) on 362/362: the w component at +0x18 reads exactly 1.0. Same caveat as the position -- unit-length and identity is consistent with a rotation and does not prove one.
    uint16_t child_handle      @0x1C   // CONFIRMED the ATTACHED (child) object's handle: the engine's walker resolves exactly this field through CClientMgr_HandleToObject to get the object it then moves. Live all 362 values are DISTINCT -- each child is attached once -- and 327 of 362 resolve to a live object. The other 35 fail the table's tag check, i.e. they name a handle whose slot is not live: stale or not-yet-created children, which the walker skips by design.
    uint16_t parent_handle     @0x1E   // CONFIRMED the OWNER's handle, by identity rather than inference: resolving this field returns the very object whose +0xB4 list the record is on, on 362/362 records with ZERO exceptions. It takes exactly 139 distinct values -- one per list -- and the multiplicities match each list's length (one owner appears 16 times, matching its 16-record list). CLTCommonClient_GetAttachmentObjects (0x4055F8) hands this field out as the PARENT and +0x1C as the child, which fixes which is which.
    uint32_t socket_handle     @0x20   // CONFIRMED a UNIFIED SOCKET HANDLE, from the engine's own call chain rather than from a live distribution: LTObject_UpdateAttachmentsRecursive asks ILTCommon slot 8 (CLTCommonShared_GetAttachmentTransform, 0x44E7A0), which tests `parent->type != OT_MODEL || field == -1` and otherwise fetches ILTModel (ILTCommon slot 18) and calls its slot 3 -- ILTModel_GetSocketTransform -- passing THIS FIELD as the socket handle. That accessor addresses SOCKETS first and falls through to NODES beyond socket_count (see LTModelAsset.socket_count). // TWO EARLIER CLAIMS HERE WERE WRONG AND ARE RETRACTED. (1) It was named `parent_node` and documented as a NODE index because all 27 model-parent values land inside node_count -- but they land inside socket_count too (27/27 both ways, measured), so "in range" distinguished nothing. Resolved as node indices they even produced plausible bone names (L_Shoulder, Torso, Neck), which is why the wrong reading survived several passes. (2) The sentinel is -1, exactly as the reference SDK says; an earlier note "corrected" the reference to 127 on the strength of 335/335 non-model records holding 127. Those 335 are never read: the engine short-circuits on `type != OT_MODEL` first. Live 0 records hold -1, so the real sentinel is simply unexercised in this state. // WHAT SETTLED IT was where the child actually SITS: the player's two records hold 0 and 1, which as socket handles are `RightHand` and `LeftHand`, and both children sit at exactly those sockets' world positions (2153.78,1554.84,-2227.71) and (2132.06,1560.98,-2230.70) -- to 0.000, against an independent composition. As node indices the same values name `Null` and `Pelvis`, which is nowhere near either child.
    LTAttachment* next         @0x24   // CONFIRMED the list link, from the walker's own `v2 = *(_DWORD *)(v2 + 36)` advance. Live every chain terminates at null.
    uint32_t unk_28            @0x28   // live 0 on every record sampled
    uint32_t unk_2C            @0x2C   // small integers, live 70/71/76 on the three records dumped. Unmapped; included to carry the class past the reference's 0x28 end, which FEAR 2 clearly exceeds.
}

// ---- The base virtual interface (from the six object vtables) --------------
//
// Type <-> vtable is 1:1: walking all seven object_lists[] buckets, each type's
// objects share exactly ONE vtable (3583 live objects, single traversal):
//   OT_NORMAL 0x672360   OT_MODEL 0x6736B0   OT_WORLDMODEL 0x6776E8
//   OT_SPRITE 0x671018   OT_CAMERA 0x677728  OT_PARTICLESYSTEM 0x670FD8
// OT_LIGHT has no live objects and therefore no observed vtable.
//
// 0x672360 (OT_NORMAL's) IS the base LTObject vtable: the base destructor body
// at 0x42050E and the base constructor at 0x420408 both install it. So type 0
// is a plain LTObject and the other five are derived classes. WORLDMODEL and
// CAMERA differ from each other in only slots 0 and 1.
//
// The base methods live in 0x4200A0..0x4206E8. Known slots:
//   1 = Init(owner, createStruct)     8 = SetFlags(uint32 -> +0x3C)
//   3 = SetPos(vec3)                  9 = SetFlags2(uint16 -> +0x44)
//   4 = SetRotation(quat)             6 = sets the float at +0x30
//   7 = SetPosRot(vec3, quat)
// Each notifies owner->slot4(this, code) with a CHANGE CODE, decoded from the
// call sites: 2 = position, 4 = rotation, 6 = both, 8 = flags, 0x10 = +0x30,
// 0x4000 = dims. Slots 10-15 of the simple types are ICF-folded shared stubs
// (0x651914 is `nullsub`, reached from 55 different vtable slots) -- see
// AGENT.MD on not over-claiming from folded bodies.
class LTObject 0xCC {
    void* vtable          @0x00 [[code]]
    uint8_t color_b       @0x04   // CONFIRMED the BLUE channel, and the whole field is finally explained. CLTClient_SetObjectRGB writes `obj[6]=r, obj[5]=g, obj[4]=b` -- so the byte order on disk is B, G, R, A and the dword reads 0xAARRGGBB. CLTClient_GetObjectColor hands out that whole dword from +0x04, and CLTClient_SetObjectColor writes it back. // THIS RESOLVES AN OLD "MEANING UNMAPPED": the note here used to read "ctor writes all four bytes as 0xFF, live 0xFFFFFFFF on 3265/3583, a -1 none default". It is not a sentinel at all -- 0xFFFFFFFF is WHITE, FULLY OPAQUE, which is exactly what a constructor should set. // NOTE THE REFERENCE DISAGREES ON ORDER: its LTObject declares m_ColorR, m_ColorG, m_ColorB, m_ColorA in that sequence, i.e. red first. FEAR 2 stores blue first. The concept transfers, the byte order does not.
    uint8_t color_g       @0x05   // CONFIRMED green, from the same setter
    uint8_t color_r       @0x06   // CONFIRMED red, from the same setter
    uint8_t color_a       @0x07   // CONFIRMED ALPHA, and separately witnessed: CLTClient_SetObjectAlpha writes ONLY `*(uint8_t*)(obj + 7)`. Live 3462 of 3583 objects sit at 255 and 121 are genuinely translucent, with values clustering at 149 (x48), 146 (x34), 251 (x16) and 0 (x9). The population is semantically right: 204 sprites and 104 particle systems carry non-default colour, which are precisely the alpha-blended effect types, while 9 worldmodels sit at or near alpha 0 -- invisible geometry. // A WRITE-PATH ASYMMETRY WORTH KNOWING BEFORE USING IT: SetObjectColor and SetObjectAlpha both notify the owner (owner->vtable slot 2) after writing; SetObjectRGB does NOT. So changing RGB alone skips the notification the other two send.
    LTObjectRef* shared_ref @0x08   // CONFIRMED a pointer to a REFCOUNTED record: the base dtor (LTObject_dtor_body) branches on it and calls 0x415B43, which is `if (--pointee[9] == 0) release(pointee)` -- a decrement-and-release on the pointee's +0x24. Live it is non-null on exactly 36 objects, ALL of them OT_MODEL (36 of 215), and the records are threaded among themselves through their own +0x00/+0x04. Refcounts read 1 (x21), 3 (x11) and 35 (x4). WHAT the resource is remains unmapped -- only that it is shared, counted, and released with the object.
    LTObjectType type     @0x10   // CONFIRMED == the index of the object_lists[] bucket holding this object (0 mismatches / 3490 live objects, single traversal). The ctor writes it as a BYTE from its argument.
    uint16_t handle       @0x12   // CONFIRMED: 0xFFFF means "none" (dump 0x40B287, and the ctor initialises it to 0xFFFF). // AND CONFIRMED TO MEAN "SERVER OBJECT" BY THE ENGINE'S OWN PREDICATE: CLTClient_IsServerObject (0x40991C) is, in its entirety, `*out = *(uint16_t*)(obj + 18) != 0xFFFF`. So this field IS the engine's server/client discriminator, and the 335 handle-less objects (all 278 particle systems plus a few models and sprites) are client-created. An earlier pass could only infer that from the population shape and the reference SDK; the engine settles it. Found by the error-string technique -- the function logs its own name on the failure path.
    LTVector position     @0x14   // CONFIRMED: written component-wise by SetPos (0x4201B8) and SetPosRot (0x4202B6), and independently confirmed by the engine's public READER: CLTClient_GetObjectPos (0x4067E9) copies out `obj[5], obj[6], obj[7]` as floats -- i.e. exactly +0x14/+0x18/+0x1C.
    LTRotation rotation   @0x20   // CONFIRMED unit-length in 3506/3506 live samples; the ctor writes (0,0,0,1), pinning w at +0x2C
    float scale           @0x30   // CONFIRMED as a uniform scale, by its READER: OT_MODEL's cull-volume provider (OT_MODEL_GetCullVolume, 0x428FB6) computes its sphere radius as `vis_radius(+0x16C) * this(+0x30)`. That matches the reference SDK's GetRadius() == m_VisRadius * MAX(m_Scale...), except FEAR2 keeps ONE float here rather than the reference's LTVector m_Scale. ctor sets 1.0; virtual slot 6 (LTObject_SetScale, 0x4200BF) is the setter and notifies with change code 0x10. Live it is exactly 1.0 on 3578/3583; the models that differ (1.658/2.493/2.656/3.0/3.19/3.2) multiply a vis_radius of 100.0 into radii of 165.76..320.0, all finite and positive on 193/193 sphere-culled models. An earlier pass called this MEANING UNKNOWN because the models whose value differs all had dims == 0 -- that turned out to be the explanation, not a counter-argument: they are SPHERE-culled, so LTObject_SetDims never runs on them and radius/dims stay at their constructor zeroes.
    void* owner           @0x34   // CONFIRMED: the SAME global for all 3583 live objects -- 0x6ECD2C, a static instance in FEAR2.exe's data (vtable 0x66F86C, constructed by 0x40C4E3). Every base setter reports changes through its vtable; slots 1/2/3/4/6/11/12 are used.
    LTSpatialRecord* spatial_record @0x38   // CONFIRMED per-object and never null (3583/3583); record->object points BACK here on 3583/3583. LTObjectOwner_UpdateSpatialRecord asks the object's own vtable slot 2 for a bounding volume, then calls LTSpatialRecord_CollectSphere / _CollectAABB (or _Release when the object is not renderable), which store that volume on the record and link each spatial hit onto it. NOT a refcount, as an earlier pass guessed. See LTSpatialRecord for the volume evidence. Still unmapped there: record[+0x1C]'s low byte equals this->type on 3465/3583 (118 OT_PARTICLESYSTEM disagree) so that is NOT a type field, and record[+0x34] is NOT a string pointer.
    // flags bit survey (all rates from ONE main-menu snapshot, 3583 objects).
    // These are CORRELATIONS and engine POLICY, not layout -- see
    // MAPPING_WORKFLOW's layout-vs-policy rule. Rates are recorded so a future
    // scene can be compared against them; none is asserted in the fixture except
    // the two mechanism-backed ones called out below.
    //
    // 33 distinct values live. Most common: 0x00000000 x863, 0x00003033 x756,
    // 0x00000800 x473, 0x00003003 x258.
    //
    // TYPE-EXCLUSIVE bits (a bit that only ever appears on one object type):
    //   0x0800  OT_CAMERA, 474/474 AND no other type -- a perfect biconditional
    //           in this snapshot, so it reads as a camera marker. It also sits
    //           inside the renderable mask, which is WHY every camera is
    //           world-tree linked.
    //   0x0008 / 0x0080 / 0x0100 / 0x0200 / 0x20000   OT_MODEL only
    //   0x0040 / 0x2000                               OT_WORLDMODEL only
    //
    // RENDERABILITY. LTObject_IsRenderable is
    //     !(flags & 0x200) && (flags & 0x10C30)
    // and LTObject_SetFlags adds to / removes from the world tree exactly when
    // that predicate flips, which makes the following MECHANISM-backed rather
    // than incidental:
    //   * renderable IMPLIES world-tree linked: 1758/1758, zero counter-examples.
    //   * the converse is FALSE -- 384 objects are linked while not renderable,
    //     so do not turn this into a biconditional. Removal is not as prompt as
    //     insertion (flags2/flags3 changes do not re-run the predicate).
    //   * bit 0x200 (the suppressor) IMPLIES not linked: 27/27, and it is
    //     exercised -- 27 OT_MODELs carry it.
    // Of the mask's bits, the three that occur live (0x10 x1284, 0x20 x860,
    // 0x800 x474) are each 100% world-tree linked; 0x400 and 0x10000 occur on no
    // live object, so their contribution is unexercised.
    //
    // PER-TYPE BIT DISTRIBUTION, live (populations: 919 NORMAL / 215 MODEL /
    // 1473 WORLDMODEL / 224 SPRITE / 0 LIGHT / 474 CAMERA / 278 PARTICLE). Every
    // number here is a RATE, not an invariant, with two exceptions noted below:
    //
    //   bit        NORM  MODEL  WMODEL  SPRITE   CAM   PART
    //   0x0001        2    204    1229     218     0    271   <- FLAG_VISIBLE
    //   0x0002       38      0    1306       9     0      0
    //   0x0004        0      0     114       0     0    256
    //   0x0008        0     15       0       0     0      0
    //   0x0010       27    167    1089       0     1      0
    //   0x0020        0      7     853       0     0      0
    //   0x0040        0      0      51       0     0      0
    //   0x0080        0      1       0       0     0      0
    //   0x0100        0     16       0       0     0      0
    //   0x0200        0     27       0       0     0      0
    //   0x0800        0      0       0       0   474      0   <- CAMERA-EXCLUSIVE
    //   0x1000        0    155    1306       0     0      0
    //   0x2000        0      0    1306       0     0      0
    //   0x20000       0      1       0       0     0      0
    //   0x80000       1      0       0       0     0      0
    //
    // Two things in that table are worth acting on. Bit 0x0800 is set on ALL 474
    // cameras and on ZERO of the other 3109 objects -- the cleanest single-bit
    // discriminator in the word, though nothing read so far TESTS it, so it stays
    // an observation rather than an "is a camera" flag. And no camera carries bit 0,
    // which is exactly why cameras hold no spatial associations despite being given
    // AABB volumes (see LTSpatialRecord.entry_list).
    // Also visible here: 0x0002 and 0x2000 both sit on exactly 1306 worldmodels and
    // nothing else, so they co-occur on that population -- unexplained, but a pair
    // worth remembering when either one gets a meaning.
    uint32_t flags        @0x3C   // CONFIRMED 32-bit (SetFlags does a DWORD read/modify/write; LTObject_IsRenderable reads it as this[15]). Bit 0 is FLAG_VISIBLE: SetFlags special-cases `diff & 1`, and the reference SDK defines FLAG_VISIBLE as (1<<0) -- live it is the single most common bit (1924 objects across five types). ctor zeroes it. See the bit survey above for what else is known, and note that everything there is a rate, not an invariant.
    uint32_t user_flags   @0x40   // CONFIRMED as the engine's THIRD flag kind, and the naming comes from FEAR2's own indexing rather than from guesswork: LTObject_SetFlagsByType (0x44E53B) switches on a kind argument and routes 0 -> vtable slot 8 (SetFlags, +0x3C), 1 -> slot 9 (SetFlags2, +0x44), 2 -> here, 3 -> the byte at spatial_record+0x2F. The reference SDK's matching enum is OFT_Flags / OFT_Flags2 / OFT_User / OFT_Client, so kind 2 is the USER flags word. LTObject_SetUserFlags notifies with change code 8, the same code SetFlags uses. Live: 866 objects read 0, and the rest spread over 68 distinct values (0x4000 x506, 3 x471, 0x4001 x409, 0x21 x357). Bit meanings unverified. NOTE `flags3` at +0x46 is NOT part of this family -- the dispatcher never touches it.
    uint16_t flags2       @0x44   // CONFIRMED 16-bit, and CONFIRMED distinct from `flags` above -- SetFlags2 (0x4200D6) does a WORD read/modify/write here while SetFlags uses the DWORD at +0x3C. Was mapped as `flags` before +0x3C was found. Tested against 0x2/0x600/0x700; bit meanings unverified.
    uint16_t flags3        @0x46  // CONFIRMED 16-bit and distinct from flags2 (SetPos reads it as a separate WORD). Live values: 0x400 x3529, 0x420 x53, 0x490 x1. Bit 0x400 is set on 3583/3583, which is exactly why SetPos's "Object going outside world" branch never runs -- it is gated on that bit being CLEAR, so do not treat the record fields that branch touches as validated. Bit 0x20 is set by LTObject_DetachFromParent. Bit 0x80 means NO CULL VOLUME: LTObject_GetCullVolume_AABB tests the byte here as SIGNED (`(char)this[70] < 0`) and bails when negative, and the single object with that bit set -- the level geometry -- is exactly the single object whose spatial_record volume is all zeros.
    LTVector aabb_min     @0x48   // CONFIRMED == position - dims on 3583/3583 live objects. Written by 0x42015D from SetPos, SetPosRot and SetDims.
    LTVector aabb_max     @0x54   // CONFIRMED == position + dims on 3583/3583 live objects
    float radius          @0x60   // CONFIRMED, and TWO-STATE. SetDims computes sqrt(dot(dims,dims)) and adds the double at 0x66FBB8, which is exactly 0.1 -- but the ctor zeroes both this and dims, so an object SetDims never ran on sits at radius 0 WITH dims 0, not at 0.1. Live partition: 2126 sized (radius == |dims| + 0.1), 1457 pristine (both zero), 0 in neither. My first pass claimed the single formula held on 3583/3583 -- that was wrong, produced by a check with a 1.0-wide acceptance window; the fixture's tighter assertion caught it. Do NOT re-widen the tolerance to make one formula fit.
    LTVector dims         @0x64   // CONFIRMED half-extents, now from BOTH a writer and a reader: SetDims (0x420358) stores its argument here and derives the AABB as position +/- it, and ILTPhysics_GetObjectDims copies out `obj[25..27]` -- exactly +0x64/+0x68/+0x6C. Live all three components are >= 0 on 3583/3583 (never negative, which a half-extent cannot be), all-zero on 1902 and positive on 1681, with a maximum of 13375.7 belonging to the level's own worldmodel. ILTPhysics_GetStandingOn also uses `pos.y + dims.y` as the surface height of whatever is stood on, which is a third consumer agreeing on the offset.
    float unk_70          @0x70   // ctor zeroes it and live it is still exactly 0.0 on 3583/3583, so nothing in a loaded level writes it. Do not read that as "unused": it means unexercised at the states sampled.
    CClientMgrListLink objects_standing_on @0x74   // CONFIRMED the head of the list of objects STANDING ON this one. LTObject_ReleaseObjectsStandingOn (0x4205BC) walks it from +0x78 and clears every entry. Field order (prev@0x00 / next@0x04) verified by that walk. // RENAMED FROM child_list: an earlier pass mapped this mechanism correctly and named the CONCEPT wrong -- see standing_on below for what settled it. The reference SDK's field order agrees: m_ObjectsStandingOn and m_StandingOnLink sit exactly here, ahead of the m_pStandingOn / m_pNodeStandingOn pair.
    CClientMgrListLink standing_on_link @0x7C  // CONFIRMED THIS object's link into the list of whatever it stands on. LTObject_SetStandingOn (0x4205D8) inserts it at that object's +0x74 and LTObject_ClearStandingOn (0x420585) removes it, then sets flags3 bit 0x20. Live biconditional: standing_on == nullptr on 3582/3582 objects whose link is self-pointing, and the one object that IS standing on something has its link present in that object's list (1/1). // Renamed from parent_link with the pair below.
    void* self               @0x84   // CONFIRMED == this object's own address on 3583/3583. Not vestigial: it exists so a list walker can recover the OBJECT from a bare link -- LTObject_ReleaseObjectsStandingOn reads link[2], which is exactly this field at standing_on_link + 0x08.
    LTObject* standing_on    @0x88   // CONFIRMED the object this one is STANDING ON, and the correction is the engine's own doing: ILTPhysics_GetStandingOn reads `*(a1 + 136)` -- this field -- treats it as an LTObject (gating on its type byte at +0x10 being 2 or 5), and computes the surface height as `pos.y + dims.y` from it. Live the single non-null case points at a type-2 WORLDMODEL whose dims are (13375, 9149, 10200), i.e. the level geometry, which is exactly what something standing on the floor should reference. // AN EARLIER PASS CALLED THIS `parent` and marked it CONFIRMED. The mechanism it described was right -- SetStandingOn does write this alongside the link above -- but the concept was borrowed from LithTech's parent/child attachment, which FEAR 2 keeps elsewhere (LTObject.attachments at +0xB4, see LTAttachment).
    void* standing_on_node   @0x8C   // CONFIRMED a WORLD NODE pointer describing the SURFACE, not per-attachment state. ILTPhysics_GetStandingOn reads it, dereferences `*node`, and takes a float vector at `*node + 28` plus a scalar at `*node + 24` -- a plane. Live that plane reads normal (0.000, 1.000, 0.000) with distance 1406.0: a level floor. // TWO EARLIER GUESSES HERE WERE WRONG and both are recorded so neither is repeated. It is not a socket/node INDEX (it holds a pointer, 0x2622EA78), and it is not an LTAttachment record (reading it as one gave a non-unit rotation and a nonsense next-pointer). It is the node the engine reports the standing surface from -- which is why the Attachment reading failed: right shape family, wrong subsystem.
    // slot_index's WRITER IS NOT IDENTIFIED, and one plausible candidate has
    // been RULED OUT by measurement. Recorded so nobody re-walks this path:
    //
    // SlotIndex_AcquireOrRelease (0x444B9B) is a textbook acquire/release on a
    // +0xA8 field -- it calls SlotTable_Acquire (0x459CB3) when a predicate holds
    // and no slot is held, and SlotTable_Release (0x4599DC) plus a -1 store when
    // the predicate fails. Its gate, SlotIndex_WantsSlot (0x44365E), even reads
    // offsets that look exactly LTObject-shaped: a BYTE type at +0x10, +0x38, a
    // DWORD flag word at +0x3C, a WORD flag word at +0x46, and +0xEC.
    //
    // But transcribing that predicate and evaluating it over live memory gives
    // TRUE on 0 of 3583 objects, while 3248 hold slots. The blocker is its
    // `flags3 & 4` clause, which passes on 0/3583 -- every OTHER clause passes on
    // 2138..3583. So either it operates on a different class that happens to
    // share the layout, or it is a real LTObject path for a state that does not
    // occur at the main menu; either way it did NOT assign the values that are
    // there. A scan for writes to [reg+0xA8] found 70 sites across many unrelated
    // classes, so offset coincidence is the likely explanation.
    uint32_t slot_index   @0xA8   // CONFIRMED uint32, NOT a float. The ctor's value renders as `NAN` in the decompiler because the constant is 0xFFFFFFFF, and read as a float the live values are denormals (max 5.4e-42) -- which is what exposed the mistake. Read as uint32: 0xFFFFFFFF on 335 objects (a "none" sentinel), and on the other 3248 the values are ALL DISTINCT (zero duplicates) in the range 0..3885, 83.6% dense with 461 gaps. It is NOT `handle`: it matches +0x12 on 0/3248. // BICONDITIONAL WITH THE HANDLE, which is the strongest thing known about it: slot_index present and handle present are the SAME 3248 objects. 3248 hold both, 335 hold neither, and ZERO hold one without the other (3583/3583). An object therefore carries both identities or none. // PER-TYPE, the objects with no slot index are: ALL 278 particle systems (0 have one), 37 of 919 OT_NORMAL, 15 of 215 models, 4 of 224 sprites, 1 of 1473 worldmodels, and 0 of 474 cameras. That population reads as client-side effects, and the reference SDK names the concept: its LTObject::m_ObjectID is "the object ID (and its index into CClientStruct::m_ObjectInfos), -1 for client-created objects", with the same -1 sentinel. Treat the reference as the EXPLANATION that fits, not as proof: nothing here watched an id being assigned. // WHICH TABLE it indexes is still unmapped, and two searches came up empty. (1) No base/stride in CClientMgr's first 0x8000 bytes maps slot_index to the object pointer for three sample objects at once, so the table is not there -- consistent with the reference putting it on a client STRUCT rather than the manager. (2) If SlotIndex_* runs on the SERVER's copy of LTObject (the class is shared -- the reference has it in runtime/world/src with `cd`/`sd` tails for client and server data), a second object manager should exist; scanning globals in 0x680000..0x700000 for an instance whose seven buckets hold objects whose type equals the bucket index found NONE. That does not disprove a server manager -- the range is only 512KB of the image and the sampled state is a menu -- but it is not there.
    LTAttachment* attachments     @0xB4   // CONFIRMED the head of this object's ATTACHMENT list, from the engine's own walker: 0x4094B6 (behind CLTClient_ProcessAttachments) reads `owner + 180` and follows +0x24 from there. Live 139 of 3583 objects hold one, 362 records in total, and every chain terminates -- verified with cycle detection, lengths 1..16, zero cycles. Distinct from the parent/child pair above: child_list/parent link objects directly, while this holds records that also carry an offset transform and a bone socket. Note it sits INSIDE what an earlier reading might take for list_link's tail -- CClientMgrListLink is 8 bytes, so list_link ends at 0xB4 and this field is its own.
    CClientMgrListLink list_link  @0xAC   // CONFIRMED: the object_lists[] threading point (walkers do `link - 172`); the ctor self-points it, matching an unlinked object
    CClientMgrListLink owned_list @0xB8   // CONFIRMED list head, self-pointed by the ctor, and CONFIRMED NON-EMPTY in practice: 1931 of 3583 live objects hold entries, 3260 entries in total (by owner type: 1168 OT_NORMAL, 910 OT_MODEL, 662 OT_WORLDMODEL, 474 OT_CAMERA, 45 OT_SPRITE, 1 OT_PARTICLESYSTEM). An earlier draft of this comment claimed every list was empty -- that was written without checking and was wrong. LTObject_ReleaseOwnedList (0x4206E8) drains it, recovering each element as `link - 4` (the element's own link pair sits at element+0x04/+0x08) and calling the element's vtable slots 3 and 1. The recovery is right and the elements ARE vtable-bearing: the three dominant vtables (x2372, x534, x346) are heap addresses whose slots point into GameClient.dll, so these are GAME-side objects owned by an engine object -- the engine/game boundary showing up in data. 7 more entries use an exe-side vtable at 0x66F6A0. Element layout unmapped.
    LTWorldTreeLink world_tree_link @0xC4   // CONFIRMED: the world-tree bucket link. Live, 2142 objects are linked and 1441 sit self-pointing (unlinked), and every linked object's list reaches a node whose parent chain terminates at the single root. LTWorldTree_AddObject descends from a node and links here; LTWorldTree_RemoveObject unlinks and decrements occupied_count up the parent chain. Ends at 0xCC == the class size.
}

// LTMemory.dll's fixed-size pool allocator. NOT a FEAR2.exe type -- both
// vtable pointers land inside LTMemory.dll's image (live 0x10004274 and
// 0x10004254, each dereferencing to code in that module), so LTMemory
// constructs these and FEAR2.exe only holds references.
//
// TWO vtable pointers at +0x00/+0x04 = multiple inheritance, which is why this
// is not modelled with a single vptr.
//
// CONFIRMED LIVE:
//   * 277 of these are threaded into one circular doubly-linked list. Walking
//     forward from CClientMgr's first bank returns to its own start after 257;
//     walking backward reaches 20 more and then a non-pool head sentinel in
//     LTMemory.dll's own data (0x100050AC). LTMemory owns the list; FEAR2's
//     six object banks are a subset of it.
//   * The links are at +0x34/+0x38 and point at the NEIGHBOUR'S +0x34, not at
//     its base (obj[i].next == obj[i+1] + 0x34 for every pair walked).
//   * +0x3C holds the object's OWN address (6/6 across CClientMgr's banks).
//   * block_size == (requested element_size + 8) & ~7, exactly, 6/6 -- an
//     8-byte allocation header plus 8-byte alignment.
//   * chunk: the first element slot begins at chunk + 0x10 (a 16-byte chunk
//     header), and slots are block_size apart. Verified by landing exactly on
//     live objects from that slot base.
//
// elems_per_chunk is the best-supported READING of +0x2C, not a proven
// contract: block_size * it clusters just under a page (4032/4048/3960...) for
// 248 of 257 pools and just under 16K for the other 9, so the chunk size is
// not fixed and the name describes the observed relationship only.
class LTMemoryPool 0x40 {
    void* vftable_a          @0x00 [[code]]  // CONFIRMED inside LTMemory.dll (live 0x10004274)
    void* vftable_b          @0x04 [[code]]  // CONFIRMED inside LTMemory.dll (live 0x10004254); multiple inheritance
    uint32_t unk_08          @0x08           // unverified; live 0xFFFFFFFF on all six banks
    uint32_t unk_0C          @0x0C           // unverified; live 0xFFFFFFFF on all six banks
    uint32_t unk_1C          @0x1C           // unverified; live 0x020007D0 identically on all six banks
    uint32_t unk_20          @0x20           // unverified; 1..12 across pools, tracks the chunk-size cluster
    uint32_t unk_24          @0x24           // unverified; live 0x00020001 or 0x00000001
    uint32_t block_size      @0x28           // CONFIRMED == (element_size + 8) & ~7, 6/6
    uint32_t elems_per_chunk @0x2C           // relationship confirmed, contract not -- see above
    void* chunk              @0x30           // CONFIRMED: element slots start at chunk + 0x10, block_size apart
    void* list_prev          @0x34           // CONFIRMED: points at the previous pool's +0x34
    void* list_next          @0x38           // CONFIRMED: points at the next pool's +0x34
    LTMemoryPool* self       @0x3C           // CONFIRMED: equals this object's own address (6/6)
}

// One CClientMgr object-type bank: the LTMemory pool plus the element size
// requested from it. See CClientMgr.object_banks for the type mapping proof.
class CClientMgrObjectBank 0x8 {
    LTMemoryPool* pool     @0x00   // CONFIRMED LTMemory pool (vtables in LTMemory.dll)
    uint32_t element_size  @0x04   // CONFIRMED: pool->block_size == (this + 8) & ~7, 6/6
}

// Row-major 3x4 rigid transform: three rows of (basis.x, basis.y, basis.z, t).
// CONFIRMED as a real transform, not a plane set or a loose float blob -- see
// LTCameraObject, where the 3x3 part was matched against the object's own
// rotation quaternion exactly (max component difference 0.00000 across 40
// objects) with determinant 1.0 across all of them.
class LTMatrix3x4 0x30 {
    float m[12]   @0x00   // row-major; row r = m[r*4 .. r*4+3], translation is m[r*4+3]
}

// The concrete class behind object type 2 -- and, as it turns out, the BASE of
// type 5. 316 bytes (0x13C) from its bank's element_size.
//
// THE HIERARCHY IS PROVEN BY THE DESTRUCTORS, which is also how an earlier
// mis-attribution here was caught. OT_CAMERA_scalar_dtor installs
// vtbl_OT_CAMERA and then calls OT_WORLDMODEL_dtor_body (0x465344), which
// installs vtbl_OT_WORLDMODEL and then calls LTObject_dtor_body. That is the
// MSVC derived-destructor chain, so:
//     LTObject  <-  WorldModel  <-  Camera
// It explains what the vtable survey had already shown without explaining: the
// two types share slots 2..15 and differ only in slots 0 and 1.
//
// The sizes clinch it. WorldModel is 0x13C and the transform pair below ends at
// exactly 0x13C; Camera is 0x140 and adds ONLY a uint16. An earlier pass mapped
// the transform pair onto LTCameraObject as though it were camera-specific --
// wrong, and the fix matters for a mod: 1473 worldmodels carry these matrices,
// not just 474 cameras.
//
// CONFIRMED live on OT_WORLDMODEL (1473 objects):
//   * determinant of world_transform's 3x3 is 1.0 on 1473/1473 -- every matrix
//     is a proper rotation.
//   * the 3x3 equals R(base.rotation) on 1464/1473, and inverse_transform is the
//     exact rigid inverse on 1450/1473. The shortfalls are NOT asserted: a
//     worldmodel is the engine's moving level geometry (doors, lifts), so a
//     cached transform can legitimately lag the quaternion between updates.
//     Cameras show no such lag -- 474/474 on all three.
class LTWorldModelObject 0x13C {
    LTObject base                  @0x00    // CONFIRMED: the first 0xCC bytes are an LTObject
    void* unk_CC                   @0xCC    // CONFIRMED as WorldModel's FIRST own field: OT_WORLDMODEL_dtor_body branches on `this[51]` (+0xCC) and releases it via 0x43B85C, and OT_WORLDMODEL_ctor (0x4651D1) initialises it to null. Live 1034 of 1473 are null and the rest are 439 distinct heap pointers. Pointee unmapped.
    uint16_t unk_D0                @0xD0    // ctor writes 0. Unmapped.
    uint16_t unk_D2                @0xD2    // ctor writes 0xFFFF -- the same "none" sentinel idiom as LTObject.handle. Unmapped.
    uint32_t unk_D4                @0xD4    // ctor writes 0. Unmapped.
    uint32_t unk_D8                @0xD8    // ctor writes 0. Unmapped.
    LTMatrix3x4 world_transform    @0xDC    // CONFIRMED rigid transform; 3x3 == R(base.rotation) on 1464/1473, det 1.0 on 1473/1473. CORROBORATED FROM THE CTOR: OT_WORLDMODEL_ctor calls LTMatrix3x4_SetIdentity (0x421010) on this offset AND on 0x10C -- the same function, on both, which is independent of the destructor/size argument that first established the pair.
    LTMatrix3x4 inverse_transform  @0x10C   // CONFIRMED exact rigid inverse on 1450/1473; also identity-initialised by the ctor (see above). Ends at 0x13C == the class size.
}

// The concrete class behind object type 5. Derives from WorldModel (see above),
// which is why it inherits the cached transform pair and adds only 4 bytes:
// 320 - 316 == the uint16 below plus padding.
//
// NAME IS A LithTech-SDK ANALOGUE (AGENT.MD rule 9): the shipping build has no
// RTTI, so "camera" comes from the reference enum's ordering, not from FEAR2.
// The inherited transform-plus-inverse is exactly a view-matrix pair, which fits
// a camera -- but now that the pair is known to come from WorldModel it is much
// weaker corroboration than it looked, since 1473 worldmodels have it too. 474
// live instances is also more than a player-camera count. Treat the name as a
// label.
//
// On the inherited fields, cameras are the well-behaved case: 3x3 == R(rotation),
// exact inverse and det 1.0 all hold on 474/474.
//
// unk_13C is a uint16 (not a dword): dump 0x46510E -- now named OT_CAMERA_Init, the
// ONLY vtable slot camera overrides besides its destructor -- writes it as `this[158]`
// through a WORD* (158 * 2 == 0x13C), copying a WORD from the CREATION REQUEST's +0x02.
// So it is a creation PARAMETER the game chooses per camera, not engine state.
//
// FULL DISTRIBUTION over all 474 live instances, because an earlier note here listed
// "observed values 1/6/7/9" and MISSED the dominant one:
//     value 10 -> 465 cameras      value 7 -> 4
//     value  9 ->   3 cameras      value 6 -> 1      value 1 -> 1
// Small integers with one overwhelming default. Role still unverified -- but a reader
// deciding whether this looks like an enum, an index or a count needs the shape, and
// "1/6/7/9" implied a spread where there is really one value and a handful of exceptions.
//
// AND THE CLASS SIZE IS NOW CORROBORATED THREE WAYS, which is why 0x140 can be trusted:
// OT_CAMERA_ctor writes at byte 316; CClientMgr's OT_WORLDMODEL bank requests exactly
// 316 bytes (so the base class ends there); the OT_CAMERA bank requests 320. One 4-byte
// slot added at the first byte past the base, holding a uint16 plus 2 bytes the ctor
// never touches (live residue makes +0x13E non-zero on 80 of 474 -- it is padding, not
// a field).
//
// THESE ARE NOT THE VIEW CAMERA, and a VR mod needs to know that before it starts
// looking. Measured against the player: the nearest instance is 84.8 units away and
// none tracks him; their positions are INTEGER and grid-aligned (2259.0, 1536.0,
// -2196.0 / 2334.0, 1516.0, -2196.0 / 2059.0, 1586.0, -2196.0 -- note the shared z),
// spread out to 16110 units. That is bulk static level furniture, 474 of it. No FOV
// field exists anywhere on the class either, and FEAR2.exe contains no "fov" string at
// all, so the view's projection is not an engine-side camera-object property. Where it
// IS: rendering is in FEAR2.exe after all -- the exe loads d3d9.dll and d3dx9_40.dll
// directly and there is no render DLL -- so see g_Renderer (exe+0x32E118), whose
// D3DPRESENT_PARAMETERS and D3DCAPS9 are the real render-side state. An earlier version of
// this note sent the reader to gameclient.dll for it, which is where the FOV VALUE may be
// chosen but not where the projection is built.
class LTCameraObject 0x140 {
    LTWorldModelObject base @0x00    // CONFIRMED: type 5 derives from type 2, proven by the destructor chain AND by the bank sizes (316 -> 320)
    uint16_t unk_13C        @0x13C   // A CREATION PARAMETER, copied by OT_CAMERA_Init from the request's +0x02. The only field camera adds. Live 465/474 hold 10; 1, 6, 7 and 9 account for the rest. Meaning unverified -- no reader has been found yet.
}

// Node CClientMgr registers for itself in its own counter_list_head list
// (see CClientMgr::Init, dump 0x40AEC6, embedded debug string
// "CClientMgr::Init": `v8 = sub_415B54(a1+5100); *(a1+5108) = v8;` -- the
// list-insert call's return value, the raw allocated node, is what
// CClientMgr.own_counter_node points at).
//
// Bytes 0x00-0x13 are the generic list machinery's own bookkeeping
// (allocator header etc.) -- NOT investigated here. self_link @0x14 IS
// investigated (see below).
//
// elapsed_ms/elapsed_time: CONFIRMED CORRELATED live -- sampled
// elapsed_ms=2169885 and elapsed_time=2169.885 in the SAME live snapshot;
// the digits match exactly (elapsed_ms == elapsed_time * 1000), far too
// precise to be coincidence -- both represent the same measurement in
// different units/precision. Read by several small accessor functions
// spread across the engine, not just CClientMgr's own code (dump
// 0x406DED/0x406DFC/0x406E0B/0x4692B1 all read this exact node).
//
// Advancement semantics: UNVERIFIED. The value is not static -- it was
// observed at 2169885 and later at 3243286 in this session. Beyond "it
// changed between observations", nothing about it is established: not the
// rate, not what it measures (wall time? accumulated frame time? time
// since a load/session event?), not its zero point. No controlled
// known-running interval has been measured.
//
// RETRACTED: an earlier note here claimed the value "did NOT advance when
// re-sampled minutes apart". Those samples were taken while the game
// process was suspended, so they say nothing about advancement. Do not
// re-derive that claim without sampling a confirmed-running engine.
//
// Only the elapsed_ms/elapsed_time correlation is confirmed.
//
// unk_28/unk_2C: read by CClientMgr::Update itself (dump 0x40B665) --
// unk_28 gates its FPS-limiter code block (checked truthy); unk_2C is read
// as a float alongside that block's target-frametime computation. Neither
// confirmed beyond "CClientMgr::Update reads and uses it here".
class CClientMgrCounterNode 0x40 {
    CClientMgrListLink self_link @0x14   // CONFIRMED via CClientMgr_Init's insertion code (`*(result+20)=*this`, i.e. this node's OWN link portion begins here) AND live: ADDRESS of this field (own_counter_node+0x14) == the owning CClientMgr.counter_list_head.next exactly (NOT self_link.next -- the field's address itself)
    uint32_t unk_28    @0x28   // gates CClientMgr::Update's FPS-limiter block (checked truthy); role beyond that unverified
    float unk_2C       @0x2C   // read as float in CClientMgr::Update's FPS-limiter block; role unverified
    uint32_t elapsed_ms @0x30   // CONFIRMED the CLIENT CLOCK in MILLISECONDS, and no longer only by correlation: the engine exports a 15-byte leaf accessor for exactly this field -- ClientTime_GetMilliseconds (0x406DFC) is `mov eax, g_pClientMgr; mov eax, [eax+13F4h]; mov eax, [eax+30h]; retn`. So the field is public engine API, not internal state, and the +0x13F4 route from the manager to this node is confirmed a third time. Live 127286 alongside elapsed_time's 127.286.
    double elapsed_time @0x38   // CONFIRMED the SAME instant in SECONDS, with its own exported accessor: ClientTime_GetSeconds (0x406DED) is the identical leaf ending in `fld qword ptr [eax+38h]`. Two accessors, two units, one instant -- and the pair is 1000x on every sample. // IT IS GAME TIME, NOT WALL TIME, which is the fact a consumer needs most: sampled twice across a full second of real time with the game at a menu, both this and elapsed_ms were byte-identical. Anything that must keep running while the game is paused cannot be driven from this clock.
}

// ---- THE DEVICE VTABLE, READ FROM THE LIVE PROCESS ----
//
// A SECOND INSTRUMENT AGREES ABOUT Present, AND BOTH SEE THE SAME RESTRICTED POPULATION.
//
// The first tracker keyed on the VTABLE register, so a cached vtable defeated it. A second keys on the DEVICE
// PUSH instead: COM stdcall passes `this` on the stack, so `mov R, g_Renderer` ... `push R` ...
// `call [Rv+off]` flags a nearby INDIRECT-CALL CANDIDATE whatever register the vtable came from -- but only
// for calls that begin with that read of g_Renderer, the same entry condition the first tracker has. It flags
// 151 candidate sites across 31 offsets, reproduces the first distribution closely (SetRenderState 64 against
// 66, same leaders below), and flags none at Present, BeginScene, EndScene, SetTransform, SetVertexShader or
// SetVertexShaderConstantF. They are candidates and not established device-method calls: see the receiver
// caveat below.
//
// EVERY RAW-DISPLACEMENT "Present CANDIDATE" IS A COLLISION, demonstrated rather than assumed. Restricting a
// raw `call [reg+0x44]` scan to the 90 g_Renderer readers yields exactly one hit, in sub_615CC1 -- the same
// function that genuinely calls the device elsewhere, which makes it maximally tempting. Reading it settles it:
//
//     call sub_612E8B          ; returns some other object
//     mov  edi, eax            ; edi = that object
//     mov  eax, [edi]          ; its vtable, NOT the device's
//     push ebx / push edi
//     call [eax+44h]           ; +0x44 on THAT object
//
// The receiver is sub_612E8B's return value. Likewise the three `[reg+0x38]` "GetSwapChain" hits: two are on
// g_pILTClient_Default_72EBDC -- an ILTClient interface in the exe, at 0x72EBDC -- and one on another local
// object. A worked example of why displacement scanning cannot answer this question, kept because it is more
// convincing than the warning alone.
//
// AND THE MISSING GetSwapChain DOES NOT WEAKEN THE SWAP-CHAIN HYPOTHESIS. Every tracker here shares the same
// entry condition, so a swap chain obtained once from a cached device and kept in heap state would be invisible
// to all of them, exactly as a cached-device Present would be. The hypothesis space is unchanged by these
// scans; only a verified call site or a runtime trace moves it.
//
// BUT THE TWO DO NOT HAVE DIFFERENT BLIND SPOTS, which an earlier draft of this note claimed. Both START from
// a read of g_Renderer. If Present is called on a device obtained from a heap field, a parameter or a register
// that was never reloaded from the global, NEITHER instrument can see it -- they differ only in how they
// locate the vtable AFTER that read. Their agreement therefore says nothing about the cached-device
// hypothesis, which is the live one.
//
// A further limit on the push key: `push <device>` shows the device is an ARGUMENT to the following call, not
// that the call's receiver IS the device. It could be passed to a helper. Confirming a site means checking the
// indirect target derives from the same value.
//
// SO Present REMAINS OPEN, and only a runtime trace settles it -- hook the live Present cell, capture return
// addresses, map them back. Recorded above as a deliberate step.
//
// A HYPOTHESIS WORTH TESTING FIRST, because it would explain the null cheaply: the engine may present through
// IDirect3DSwapChain9, a separate interface with its own vtable where Present is index 3 (offset 0xC). That
// needs finding where a swap chain is obtained and kept.
//
// WHERE THE DEVICE POINTER IS CACHED: NOT IN ANY .data GLOBAL. Scanning FEAR2.exe's writable data range
// (IDB 0x6E3000..0x733000) for copies of the live device value found exactly ONE -- g_Renderer itself. That
// eliminates a second exe-global holding a copy.
//
// It does NOT eliminate caching. A heap object's field would not appear in that range at all, and the narrow
// store-scan below ("all 152 sites push, none store") only covers stores within a few instructions of a
// g_Renderer read -- a cache written through an alias, after a spill, or further away is outside its window.
// "No stores found by a narrow tracker" and "no caches exist" are different statements.
//
// IT DOES NOT SETTLE WHERE Present IS CALLED, and cannot. A call path may keep the device only in registers,
// in a stack local, in a field of a heap object, or receive it as a parameter -- none of which a data scan
// sees. Nor does a matching dword in .data prove the copy is used for dispatch. One hit is an elimination,
// not an answer.
//
// THE DECISIVE ROUTE, when it is worth doing: hook the live Present vtable cell temporarily, record return
// addresses, and map those callers back into the IDB. That needs the mod's own hooking mechanism pointed at a
// render-thread entry point, so it belongs to a deliberate session rather than a recon pass -- and note the
// vtable cell address must be re-read after a device reset, per Render.hpp.

//
// Where the static tracker could not settle things, the running game answers directly. Reading g_Renderer's
// value and following its vptr:
//
//   device          0x0EE053C0   heap, module-unowned
//   device vtable   0x0EE0831C   heap, OUTSIDE d3d9.dll (0x66830000..0x669C2000)
//   containing region 0x0EBA0000..0x0EF9F000, committed, read=1 write=1 execute=0
//
// Every sampled entry points into d3d9.dll -- Present d3d9+0xE6120, BeginScene +0x647F0, Clear +0x64720,
// SetTransform +0x608D0, SetVertexShaderConstantF +0x67420 and so on -- which independently corroborates the
// corrected offsets, since eleven of them all land in one module at distinct addresses.
//
// WHAT THIS MEANS FOR A STEREO PATH: on this machine the table is module-unowned WRITABLE storage, so patching
// it needs no VirtualProtect -- unlike the engine's own class vtables in .rdata. sdk::Render::device_vtable()
// and device_vtable_writable() expose that, and the fixture asserts only that both are QUERYABLE, then reports
// what they say. Storage location and protection are runtime and machine properties, the same reason
// Render::interface_impl_owner() reports an owning module rather than hard-coding one -- a D3D9 keeping its
// vtable in a read-only module table would be entirely valid and would simply need VirtualProtect.
//
// TWO THINGS DELIBERATELY NOT CLAIMED. Heap storage does NOT prove the table is per-device: D3D9 may hand one
// heap vtable to several devices, and with a single device in this process there is nothing to compare
// against. And the address is NOT stable -- a device reset or recreation, which is exactly what resolution and
// mode changes provoke, can replace device or table, so a consumer must re-read rather than cache and
// reinstate any hook afterwards.
//
// The overlay question was already answered by an earlier pass and is unchanged: Steam wraps
// IDirect3D9::CreateDevice, so the FACTORY's methods point into gameoverlayrenderer.dll while the DEVICE it
// returns is genuine d3d9.dll. Live vtable ownership shows what implements a method now, not where FEAR2
// calls it from.

// ---- THE ENGINE'S NAMED SHADER PARAMETERS ----
//
// SIXTY NAMED PARAMETERS IN A STATIC DOUBLY-LINKED LIST, which is where the shader constants
// this pass spent so long failing to find statically actually live. FEAR 2 does not sprinkle
// SetVertexShaderConstantF through its render code: it keeps records holding a NAME, a type, a
// binding index, a byte size and the value inline, and uploads them through one function.
//
// FOUND BY FOLLOWING CODE, NOT BY SCANNING FOR A SHAPE. Render_ClearRenderTargetTexture
// (0x615CC1) calls RenderTarget_GetD3DTexture; a neighbour (sub_61312E) passes three such
// textures plus a float2 to what an earlier pass had misnamed Renderer_UploadBoneMatrices. The
// float2 was k_vScene_ScreenRes, and its inline value read 5120.0f x 1440.0f -- the resolution
// the machine is actually running. A record whose value matches the live display is not a
// guessed layout.
//
// THE RECORD, every offset taken from LTShaderParam_Flush's own field accesses:
//
//     +0x00  vtable            g_LTShaderParam_vftable, shared by all 60
//     +0x04  const char* name
//     +0x08  u16 type          see the table below
//     +0x0A  u16 binding index 0xFFFF = unbound
//     +0x0C  void* value       always node + 0x1C
//     +0x10  u16 size          bytes
//     +0x12  u16 pending       byte count recorded when set while unbound; cleared on upload
//     +0x14  prev, +0x18 next
//     +0x1C  value storage, inline
//
// THE TYPE TAG IS CONFIRMED TWICE, which is why it is written as a type and not a guess: the
// u16 at +0x08, and the engine's own Hungarian prefix on the name. All 60 agree.
//
//     tag  size            type       prefix   n
//     01   4               texture    t        23
//     02   12              float3     k_v       7
//     03   16 (96 = cube)  float4     k_v      13
//     05   4               float      k_f       3
//     08   64              float4x4   k_m       5
//     09   48 (1152 = 24)  float4x3   k_m       6
//     0A   8               float2     k_v       3
//
// WHAT A VR MOD WOULD WANT, named: k_mObjectToClip and k_mObjectToClip_Previous (64),
// k_mObjectToWorld, k_mCustomTransform, k_mDrawPrimToClip, k_vScene_ScreenRes,
// k_vScene_ZRange, k_vHalfViewPlane, k_vWorldSpaceCameraDir, k_vObjectSpaceEyePos, and
// k_mModelObjectNodes -- 1152 bytes = 24 float4x3 node transforms, which independently
// corroborates what the old Renderer_UploadBoneMatrices name was reaching for even though that
// function is generic.
//
// THE UPLOAD PATH, renamed from evidence:
//
//     LTShaderParam_SetValue  0x60C5B9   value = *src; then Flush(param, bytes)
//     LTShaderParam_Flush     0x60C20A   binding == 0xFFFF ? record pending : upload, clear
//     LTShader_SetConstantByRegister 0x618D4E
//                                        method 20 on *(g_pLTShaderSystem+0x10), passing
//                                        table[binding].+0x08 as a handle, plus value + size
//
// THE BINDING INDEX IS NOT A D3D CONSTANT REGISTER, though it sits exactly where one would and
// an earlier draft of the SDK called it that. Flush uses it to index a 12-byte-stride table at
// g_pLTShaderSystem+0xBC and hands the entry's +0x08 field to the upload method, so it selects
// an ENGINE handle. A consumer treating it as a c# register number would write wrong tooling.
//
// WHAT IS STILL OPEN:
//   - The interface behind the upload. (handle, void*, byteCount) at method index 20 resembles
//     ID3DXEffect::SetValue, but g_pLTShaderSystem is NULL at the main menu, so it could not be
//     identified live. NOT confirmed as D3DX.
//   - WHY NOTHING IS EVER SEEN BOUND. With a level loaded and the suite fully green, all 60
//     records still read binding 0xFFFF while 33 carry pending byte counts. That is TWO
//     SAMPLES, both taken from an HTTP handler thread between frames, so what it establishes
//     is narrow: at those instants nothing was bound. Transient draw-time binding is the
//     obvious explanation but NOT a measurement -- equally live: this build never assigns
//     these records a handle at all, or the handles live in a structure elsewhere. Settling
//     it needs a breakpoint or hook inside LTShaderParam_Flush observing the other branch
//     being taken. Until then "nothing is bound when we look" is the whole finding, and it is
//     already enough to make writing a value here futile.
//
// EXPOSED AS sdk::ShaderParams, read-only on purpose: k_mObjectToClip is the COMPOSED
// object-to-clip transform, set per draw, so a write would be overwritten before a shader saw
// it. Reading is genuinely useful now; a setter would be a lie about what it achieves.
//
// ---- WHO WRITES THE SHADER PARAMETERS, AND THE CAMERA ONES IN PARTICULAR ----
//
// A TYPED SETTER PER SIZE, each __thiscall on a parameter record, each copying to +0x1C and
// calling Flush with its own byte count. That third independent confirmation of the +0x1C
// inline value is worth as much as the setters themselves.
//
//     LTShaderParam_SetMatrix4x4  0x60C396  rep movsd 16 dwords, Flush(64)
//     LTShaderParam_SetMatrix4x3  0x60C3D0  12 fld/fstp,         Flush(48)
//     LTShaderParam_SetFloat4     0x60C3B4  LTRotation_Copy,     Flush(16)
//     LTShaderParam_SetFloat3     0x60C3F3  3 fld/fstp,          Flush(12)
//     LTShaderParam_SetFloat      0x610859  fld/fstp,            Flush(4)
//     LTShaderParam_SetDword      0x60C5B9  integer mov,         Flush(4)
//
// 64, 48, 16 and 12 each belong to exactly one registry type, so those four names are exact.
// THE TWO 4-BYTE ONES ARE NOT SEPARATED BY SIZE -- texture (tag 1) and float (tag 5) are both
// 4 bytes -- but by MOVE KIND: fld/fstp is a float assignment, a plain mov is not. So the FPU
// one is SetFloat on that evidence, and the integer one is left generic as SetDword rather
// than SetTexture, even though textures are what its caller sub_61AA17 feeds it.
//
// 161 FUNCTIONS TOUCH PARAMETER RECORDS. The heaviest: sub_62C61D and sub_60F877 (7 each),
// SceneRenderer_ResetObjectShaderParams 0x60C765 (6, including k_mObjectToClip), sub_60C4FA
// (the DrawPrim video planes), sub_61312E (the frame maps plus screen res).
//
// ---- THE SCENE CAMERA ----
//
// g_SceneRenderer 0x72E788 is an OBJECT, not a flag, and its first dword is the state that
// earlier passes saw compared against 1..4. Proven by the receiver: sub_60FBD2 does
// `mov edi, offset g_SceneRenderer` then `mov ecx, edi` into
// SceneRenderer_SetupCameraShaderParams (0x610E21), which gates on *this == 3 and sets it to 4.
//
// NOT NAMED BeginScene despite that 3 -> 4 hop: no D3D BeginScene call is evidenced anywhere in
// this exe's g_Renderer readers, so the name would assert something unmeasured. It is named for
// what it does -- publish the camera parameters.
//
// A SceneCamera RECORD AT g_SceneRenderer+8, filled by sub_610DA2 from that function's
// arguments:
//
//     +0x00  mode           2 = the screen/2D pass
//     +20    view transform LTTransform_Copy
//     +48/52 half view-plane extents  -> k_vHalfViewPlane
//     +56/60 a second pair, role not established
//     +64/68 z range source           -> k_vScene_ZRange
//
// k_vHalfViewPlane IS (x, y, 1/x, 1/y), CONFIRMED IN LIVE MEMORY rather than read off the code:
// it held (2.2651, 0.6371, 0.4415, 1.5697), and 1/2.2651 = 0.4415, 1/0.6371 = 1.5696. The
// engine stores the reciprocals so a shader can avoid a divide.
//
// THE UNITS FOLLOW THE PASS MODE, which is how the meaning got settled instead of guessed.
// Sampled live in mode 2, the record's own extents read (2560.0, 720.0) -- exactly half of the
// 5120x1440 screen, so PIXELS. The parameter left by a 3D pass read (2.2651, 0.6371), whose
// ratio 3.5556 equals the screen aspect 5120/1440. Same field, two passes, both consistent with
// "half extent of the view plane".
//
// WHICH ALSO EXPLAINED AN APPARENT CONTRADICTION rather than leaving it hanging: the z range
// source at +64/68 read (0.0, 1.0) while k_vScene_ZRange held (4.3, 100000.0). Not a bad
// offset -- SetupCameraShaderParams SKIPS both the half-plane and z-range writes when mode == 2,
// and the last pass to touch the record was mode 2. The parameter was simply older than the
// record.
//
// NO FOV ACCESSOR IS EXPOSED, on purpose. tan(fov/2) is the natural reading of a unit-depth
// half-extent, but the SDK cannot tell a caller which pass left the value it read, and
// 2*atan(2560) is about pi radians -- a plausible number that means nothing. The precondition is
// not checkable there, so the arithmetic stays with whoever can establish it.
//
// Exposed as sdk::ShaderParams::half_view_plane() / z_range() / world_space_camera_dir(), with
// HalfViewPlane::reciprocals_consistent() and aspect() as the invariant checks a consumer can
// call on its own read. The suite asserts both: the reciprocal identity, and agreement between
// k_vHalfViewPlane's aspect and k_vScene_ScreenRes.
//
// THAT SECOND CHECK IS CONSISTENCY, NOT CORROBORATION, and an earlier draft of this note
// oversold it as "two parameters nothing forces to agree". The mode-2 sample is what disproves
// that: the half-plane extents were literally half the screen dimensions, so both parameters
// descend from the same viewport. Agreement catches a misread of either record -- wrong offset,
// wrong order, torn value -- which is worth asserting, but it cannot independently confirm the
// viewport, because there is only one upstream.
//
// ---- THE SCENE CAMERA'S MATRICES ----
//
// sub_610BA1 BUILDS THEM, and +184 is the finished VIEW-PROJECTION. This is the structure a
// stereo path actually needs, and it is reachable by a read -- unlike the D3D interception this
// project spent two passes failing to locate statically.
//
// THE FULL RECORD, at g_SceneRenderer+8, 360 bytes:
//
//     +0x00   u32 pass mode        2 = the engine's screen/2D pass
//     +0x04   i32 viewport left, then top, right, bottom at +0x08/+0x0C/+0x10
//     +0x14   CAMERA POSE, an LTNodeTransform: LTVector position + LTRotation rotation
//     +0x30   half view-plane x, y -> published as k_vHalfViewPlane
//     +0x38   projection CENTRE OFFSET x, y
//     +0x40   depth min, max       -> fed to the projection builder
//     +0x48   view matrix, 3 rows of 4
//     +0x78   projection = proj(depth) * shear
//     +0xB8   VIEW-PROJECTION = projection * view
//     +0xF8   WORLD -> SCREEN PIXELS = viewportTransform * viewProjection
//     +0x138  SCREEN PIXELS -> CLIP, from the VIEWPORT's half-extents
//
// THE CENTRE OFFSET IS APPLIED AS A SHEAR, straight out of the builder:
//
//     [ 1 0 -offX 0 ]
//     [ 0 1 -offY 0 ]
//     [ 0 0   1   0 ]
//
// so the projection need not be centred. It read (0, 0) in the screen pass. That IS the
// mechanism an off-centre or per-eye projection would use, but the engine's own use of it is not
// established, so it is named for the maths and not for a purpose.
//
// EVERY OFFSET ABOVE IS CONFIRMED BY A LIVE READ, not by reading the arithmetic:
//   - The viewport ints read (0, 0, 5120, 1440) -- exactly the screen.
//   - The projection's [0][0] read 0.00039063 against 2/5120 = 0.00039063, and [1][1] read
//     -0.00138889 against -2/1440, to EIGHT DECIMALS, with [0][3] = -1 and [1][3] = 1. So the
//     screen pass builds a screen-to-clip orthographic matrix, and these matrices are ROW-MAJOR
//     with translation in column 3. That settles a convention that would otherwise have been a
//     coin flip.
//   - THE COMPOSE IS VERIFIED, not assumed: with the view matrix identity, +0xB8 equalled +0x78
//     exactly, which is what P*I = P requires.
//   - The half view-plane read (2560, 720) -- exactly half the viewport, in pixels, which is the
//     independent confirmation of the units established last pass.
//
// THE POSE LAYOUT COMES FROM THE COPY ROUTINE, not from guessing at 28 bytes. LTTransform_Copy
// (0x407CC1) does three fld/fstp into +0x00/+0x04/+0x08, then `lea ecx, [esi+0Ch]` and calls
// LTRotation_Copy -- so position at 0x00, rotation at 0x0C, 0x1C total. That is exactly the
// already-generated regenny::LTNodeTransform, so the SDK reuses it rather than declaring another
// 7-float type.
//
// AND THE QUATERNION IS w-LAST, which the screen pass settles for free: the pose reads position
// (0,0,0) with rotation (0,0,0,1) there, an identity that only parses as identity with w last.
// That agrees with regenny::LTRotation's x,y,z,w.
//
// // ---- WHAT THE PERSPECTIVE PASS ENTRY TAKES, AND THE TWO SURPRISES IN IT ----
//
// SLOT 15'S FULL SIGNATURE, read out of the wrapper (retn 14h = 20 bytes, matching five arguments):
//
//     SetupPassPerspective(const LTNodeTransform* camera,   position + quaternion
//                          const float fov[2],              ANGLES IN RADIANS, x then y
//                          const float rect[4],             NORMALISED viewport, 0..1
//                          float depthMin, float depthMax)
//
// SURPRISE ONE: FOV GOES IN AS AN ANGLE. LTRenderer_FovPairToHalfViewPlane (0x610A1D) clamps each
// component to [0, g_LTMaxFovRadians] and computes tan(angle * 0.5). So a caller sets the field of view
// DIRECTLY in radians and builds no projection at all. The ceiling is 3.1241393, exactly 179 degrees,
// lazily initialised from g_LTMaxFovRadiansDefault, and requests above it are CLAMPED rather than
// refused -- asking for 180 silently yields 179.
//
// That also confirms half = tan(fov/2) from the INPUT side, entirely independently of the earlier
// derivation from LTMatrix_BuildPerspectiveProjection's 1/half x scale. Two directions, same identity.
//
// SURPRISE TWO: THE VIEWPORT IS FRACTIONAL. LTRenderer_NormalizedRectToPixels (0x610952) clamps each
// component to [0,1] and scales by the render target's dimensions at this+0x174, rounding with +0.5:
//
//     out[i] = trunc(clamp01(rect[i]) * (i even ? width : height) + 0.5)
//
// so {0, 0, 0.5, 1} is the left half of the target and {0.5, 0, 1, 1} the right. A side-by-side pair
// therefore needs NO matrix work -- two calls with two transforms, two FOVs and two sub-rects.
//
// WHAT IS NOT AVAILABLE HERE: the projection CENTRE OFFSET is hardcoded (0, 0) by this entry -- `fldz`
// at 0x610FB7 fills both halves of the pair passed as SetupCameraShaderParams's a4. So the off-centre
// frustum that record+0x38 can express is NOT reachable through slot 15. Symmetric per-view FOV plus a
// sub-rect is reachable; an asymmetric frustum would need the field written after setup, or another
// path. This settles a question left open when the offset was first found -- the capability exists in
// the record, and this entry never uses it.
//
// THE STATE MACHINE GAINED ITS FIRST STEP: SceneRenderer_BeginRenderTarget (0x610727) goes 2 -> 3, and
// records the target dimensions at this+0x174 plus an offset pair at this+0x17C. Those dimensions are
// exactly what the fractional viewport is multiplied by, and the offset is added to the resulting rect.
// Full cycle: 2 -> 3 (begin target) -> 4 (configure pass) -> 3 (end pass).
//
// EXPOSED AS sdk::SceneCamera::kMaxFovRadians, predicted_half_view_plane() and
// predicted_viewport_pixels(), which reproduce the engine's arithmetic INCLUDING its clamps so a
// consumer can predict what a call will produce before making it, and compare against what the record
// holds afterwards. Both clamp rather than reject, because the engine does.
//
// Also named the small math helpers this uncovered: LTMath_Clampf, LTMath_Maxf, LTMath_Minf.
//
// ---- HOW THE ENGINE BUILDS A CAMERA TRANSFORM ----
//
// THERE IS NO CAMERA OBJECT TO CONSTRUCT, which is the useful part. Renderer_MakeCubicEnvMap writes a
// position into a stack slot, writes a quaternion into the four floats immediately after it -- forming
// an LTNodeTransform in place -- and passes that address to SceneRenderer_SetupPassPerspective. So an
// alternate view needs {position, rotation} on the stack and nothing else.
//
// THE ROTATION COMES FROM A LOOK-AT: LTRotation_FromForwardUp (0x612827), named for what it computes
// rather than its one caller, since nothing in it is cube-specific.
//
//     dot = LTVisPlane_DotNormal(forward, up)
//     if dot > 0.99 or dot < -0.99                 <- g_LTLookAtParallelMax / Min
//         up = (forward.y, forward.z, forward.x)   swizzle, so a forward parallel to the hint still
//                                                  yields an independent second axis
//     LTVector_Cross, LTVector_NormalizeInPlace, LTVector_Cross
//     LTMatrix3x4_FromBasisColumns  then  LTRotation_FromMatrix3x4
//
// THE HANDEDNESS IS NOW PINNED, and the reason it took a second look is worth recording: the cross
// products' receivers live in ECX, so Hex-Rays showed `sub_407936(v4, &v5)` with the operand that
// decides the sign invisible. The disassembly has it:
//
//     ecx = forward, out = right, a3 = up          and LTVector_Cross computes a3 x this
//         -> right = up x forward
//     LTVector_NormalizeInPlace(right)
//     ecx = right,   out = up,    a3 = forward
//         -> up = forward x right
//     LTMatrix3x4_FromBasisColumns(out, a2=right, a3=up, a4=forward)
//         -> columns (right, up, forward)
//
// CONSISTENT WITH LithTech's +X right, +Y up, +Z forward: feed forward = +Z and up = +Y and the basis
// is the identity matrix, so the rotation is the identity -- which the suite asserts directly, and
// which would fail on any flipped cross or swapped column.
//
// THE DEGENERATE CASE IS A SWIZZLE, NOT A FAILURE. Beyond a dot of +/-0.99 the hint becomes
// (forward.y, forward.z, forward.x), so a caller may pass an up parallel to forward and still get a
// usable orientation with arbitrary roll. Transcribed rather than replaced, because a caller relying on
// that behaviour needs the engine's.
//
// EXPOSED AS sdk::SceneCamera::rotation_from_forward_up, and VERIFIED BY THE PROPERTY a consumer
// depends on rather than by matching the transcription to itself: rotating +Z by the result must
// reproduce the requested forward. That single check exercises both crosses, the column order and the
// quaternion conversion together, across a spread of directions plus the parallel-hint case.
//
// THE PRIMITIVES, all pinned:
//
//     LTVector_Cross                 0x407936  out = this x a3, the standard formula
//     LTVector_NormalizeInPlace      0x410150  length, reciprocal square root, scale
//     LTMatrix3x4_FromBasisColumns   0x40799C  vectors into COLUMNS 0, 1, 2 -- not rows, consistent
//                                              with this engine's column-vector convention
//     LTRotation_FromMatrix3x4       0x407A76  matrix -> quaternion, trace branch above -0.999 and
//                                              largest-diagonal fallback below it
//
// LTRotation_FromMatrix3x4 IS THE INVERSE OF LTRotation_ToMatrix3x4, and that pairing is worth more
// than either alone: the SDK transcribes both from separate engine functions, so requiring them to
// round-trip catches a sign or index error in either. The suite does exactly that, and covers both
// branches -- a 180-degree rotation drives the trace to -1 and forces the fallback path.
//
// w IS AT INDEX 3 in the trace branch, a FOURTH independent confirmation of the component order after
// the identity pose, LTRotation's declaration and LTRotation_ToMatrix3x4.
//
// EXPOSED AS sdk::SceneCamera::rotation_from_matrix / matrix_from_basis_columns /
// make_camera_transform. The last is trivial by design: it documents the shape the engine wants, which
// is the whole point -- any orientation built with matrix maths has to return to a quaternion before
// the engine will take it.
//
// ---- WHERE THE CAMERA TRANSFORM ENTERS THE ENGINE, i.e. WHERE TO HOOK ----
//
// CLTRenderer_vftable SLOTS 15, 16 AND 17 are the pass setup entry points, and slot 15 takes the
// CAMERA TRANSFORM as its first stack argument. That makes it the single most useful interception
// point found in this whole chain.
//
//     slot 15  CLTRenderer_SetupPassPerspective  0x60B520  mode 0 -> perspective projection
//     slot 16  CLTRenderer_SetupPassAffine       0x60B560  mode 1 -> affine projection
//     slot 17  CLTRenderer_SetupPassStored       0x60B5A0  mode not an immediate; NOT established
//     slot 18  CLTRenderer_EndPass               0x60B5C3  no args; state 4 -> 3
//     slot 20  CLTRenderer_DrawScene             0x60AF1B  the whole scene
//     slot 21  CLTRenderer_DrawObjectList        0x60AF32  object list + count, both validated
//
// THE STATE MACHINE IS NOW CLOSED. The 1..4 comparisons scattered through the render code resolve to:
// 3 = ready for a pass, 4 = a pass is configured. SetupCameraShaderParams does 3 -> 4,
// SceneRenderer_EndPass does 4 -> 3, and SceneRenderer_DrawScene refuses to run outside state 4.
//
// AND DrawScene ALSO REFUSES MODE 2, which answers a question this project kept circling: the screen
// pass cannot draw the 3D scene at all. That is why the camera record sits in mode 2 between frames
// and why 4000 consecutive samples never caught a perspective pass -- mode 2 is the state the engine
// PARKS in, and every 3D pass exists only between a setup and an end.
//
// A WORKED EXAMPLE ALREADY EXISTS IN THE BINARY. Renderer_MakeCubicEnvMap (0x6128C3, self-named in six
// of its own error strings) renders the same scene SIX times from six transforms:
//
//     Renderer_BuildCubeFaceTransform(face)          build the transform
//     SceneRenderer_SetupPassPerspective(transform)   3 -> 4, mode 0
//     SceneRenderer_DrawScene(...)                    requires 4, refuses mode 2
//     SceneRenderer_EndPass()                         4 -> 3
//
// per face. Renderer_PlatformCaptureOrthoProjection (0x612660) does the same through the affine setup.
// So multiple views per frame are something this engine ALREADY DOES through its public pass API -- a
// stereo path is that sequence run twice with two eye transforms, not a new mechanism.
//
// All three gate on g_SceneRenderer == 3 and return 0 without doing anything otherwise, so a caller
// cannot assume a pass was configured. The mode is what distinguishes them: the wrappers pass 0 and 1
// as SceneRenderer_SetupCameraShaderParams's a6, and sub_610BA1 branches on exactly that to pick
// LTMatrix_BuildPerspectiveProjection or LTMatrix_BuildAffineProjection.
//
// THE ARGUMENT'S PATH TO THE RECORD IS FULLY TRACED, which is what makes this an intervention point
// rather than just a call site:
//
//     slot 15 arg_0
//       -> SceneRenderer_SetupPassPerspective forwards it
//       -> SceneRenderer_SetupCameraShaderParams takes it as the transform argument
//       -> sub_610DA2 copies it to SceneCamera+0x14, the pose
//       -> LTTransform_CopyInverted + LTTransform_ToMatrix3x4 make the view matrix at +0x48
//       -> the view-projection at +0xB8 and world-to-screen at +0xF8 follow from that
//
// So substituting a transform at slot 15 moves the view matrix, the view-projection and the
// world-to-screen matrix together and consistently. Patching those matrices individually would mean
// keeping three derived values in agreement by hand; this changes their single common input.
//
// EXPOSED AS sdk::SceneCamera::renderer_fn(RendererSlot), resolved from the LIVE vtable through the
// interface registry rather than a fixed address, and bounds-checked against the exe -- the whole
// point of this address is that something will WRITE to it, so a plausible pointer from an unexpected
// table is worse than none. The suite checks all three resolve to the offsets static reversing
// recorded (exe+0x20B520/560/5A0), which is two independent paths agreeing: IDA read the table out of
// the file, the DLL walks it in the running process.
//
// ---- WHERE THE VIEW MATRIX COMES FROM ----
//
// view = matrix_from(inverse(camera pose)), which is the textbook construction and, more usefully,
// SETTLES THAT THE POSE AT +0x14 IS THE CAMERA'S WORLD TRANSFORM rather than something already
// view-relative. Read out of the builder rather than assumed:
//
//     LTTransform_CopyInverted  0x41DB87   ecx = record+0x14 (the pose), arg = out
//                                         LTTransform_CopyFrom then LTTransform_InvertInPlace
//     LTTransform_ToMatrix3x4   0x62E31E   ecx = transform, arg = out 3x4
//                                         LTRotation_ToMatrix3x4 then position into COLUMN 3
//
// Note the `push ecx` inside LTTransform_CopyInverted: the incoming ecx is the SOURCE, passed on as
// the copy's argument, which is what identifies the pose as the input rather than the destination.
//
// LTRotation_ToMatrix3x4 (0x40FC87) is the standard quaternion expansion and confirms w-LAST for a
// third independent time -- the scale is 2/(x^2+y^2+z^2+w^2) with this[3] as w, and the products
// land as 1-2(y^2+z^2), 2(xy-wz), 2(xz+wy) and so on, with column 3 zeroed.
//
// THAT SCALE MATTERS AND WE HAD IT WRONG. sdk's rotation_matrix() hardcoded 2 while the engine
// divides by the squared norm. Identical for unit quaternions, wrong for every other, and the header
// promised "any LTRotation". Now one shared converter matching the engine, used by both Object and
// SceneCamera, returning nullopt for a zero-norm or non-finite quaternion.
//
// THE INVERSION, exactly: LTRotation_Conjugate (0x41DAB6) negates x, y, z and keeps w, then
// LTRotation_RotateVector rotates the position by that conjugate and the result is negated. So
// q' = conj(q), p' = -(q' . p) -- the standard rigid inverse, valid as a QUATERNION inverse only for
// unit q, which is the engine's assumption everywhere.
//
// EXPOSED AS sdk::SceneCamera::transform_to_matrix / invert_transform / view_matrix_from_pose, plus
// promote_affine for widening the engine's 3x4 storage to the 4x4 its own multiply consumes. A
// consumer overriding the camera must produce the matching view matrix, and view_inverts_pose()
// is the validator for a pose it built itself -- a wrong conjugate sign, a transposed rotation or a
// mis-signed translation all yield a plausible-looking matrix that renders wrongly.
//
// WHY THAT VALIDATOR EXISTS AT ALL: in every pass reachable from outside a render hook the engine's
// pose is the identity, so comparing our recipe against the record cannot distinguish a correct
// recipe from several wrong ones. The round trip on a pose with a real rotation and translation can.
// Its translation allowance scales with distance from the origin, because column 3 of the product is
// a cancellation back to zero whose float residual grows with |p| -- an absolute epsilon passes a
// pose at 137 units and fails the same pose at 98000.
//
// ---- THE LAST TWO FIELDS, AND THE RECORD IS COMPLETE ----
//
// +0x138 IS SCREEN PIXELS -> CLIP, built by LTMatrix_BuildScreenOrthoProjection from the VIEWPORT's
// own half-extents at ebp-8/ebp-4 -- not from the half view-plane pair the other two builders take:
//
//     [ 1/halfW      0        0   -1 ]
//     [ 0        -1/halfH     0    1 ]
//     [ 0            0        1    0 ]
//
// Read live at 0.00039063 and -0.00138889 for the 5120x1440 viewport, matching the prediction to
// eight decimals.
//
// IT IS THE VIEWPORT TRANSFORM'S INVERSE ONLY FOR AN ORIGIN-ANCHORED VIEWPORT, which is worth
// stating rather than rounding off. The viewport matrix is
// [halfW,0,0,centreX; 0,-halfH,0,centreY; 0,0,1,0], whose true inverse carries -centreX/halfW and
// centreY/halfH in column 3. This builder writes -1 and +1 there, and those agree exactly when
// centreX == halfW and centreY == halfH, i.e. left == top == 0. True for the full-screen viewport
// measured here; a sub-rect viewport would make the engine's own two matrices NOT inverses. The suite
// REPORTS that rather than asserting it, since a sub-rect viewport is a legitimate state.
//
// AND sub_60C2FE IS THE PROMOTION, now LTMatrix_PromoteAffineTo4x4: it copies twelve floats and
// appends (0,0,0,1). Worth having explicitly, because until now that row was only IMPLIED by
// LTMatrix_Mul4x4ByAffine's arithmetic. Here the engine writes it out, so
// sdk::SceneCamera::promote_affine matches an observed convention instead of an inferred one.
//
// THE RECORD IS NOW FULLY ACCOUNTED FOR -- mode, viewport rect, pose, half view-plane, projection
// centre offset, depth range, view, projection, view-projection, world-to-screen and screen-to-clip.
// Nothing in its 360 bytes is unexplained.
//
// ---- HOW THE ENGINE MULTIPLIES MATRICES ----
//
// TWO MULTIPLIES, DIFFERING IN WHICH OPERAND IS AFFINE. Both are out = A * B; the difference is
// whose fourth row is assumed rather than read, and that is legible directly in the arithmetic.
//
//     LTMatrix_Mul4x4ByAffine  0x610193   B is affine 3x4 (row 3 taken as 0,0,0,1)
//     LTMatrix_MulAffineBy4x4  0x610333   A is affine 3x4
//
// For 0x610193, columns 0..2 of each output row sum only THREE products, and column 3 adds A[r][3]
// on its own -- precisely what B[3] = (0,0,0,1) contributes. All four rows of A are computed, so A
// is a full 4x4. Its two call sites agree with the storage: B is the 12-float shear, then the
// 48-byte view matrix, both 3x4 in memory, so the implicit row is the layout rather than a guess.
//
// For 0x610333 the mirror holds: rows 0..2 are full four-term products and the output's row 3 is
// B's row 3 COPIED, which is what A[3] = (0,0,0,1) would produce.
//
// SO THE COMPOSITION IS view_projection = projection * view, points as COLUMN vectors, row-major
// with translation in column 3. A consumer building a per-eye matrix needs that order; the
// transpose produces a plausible-looking wrong answer, which is why sdk::SceneCamera exposes
// multiply_by_affine() and compose_view_projection() rather than leaving each caller to guess.
//
// VERIFIED AGAINST THE ENGINE'S OWN OUTPUT, which is stronger than the synthetic probes elsewhere
// in this file: the record holds the projection at +0x78, the view at +0x48 and the engine's own
// product at +0xB8, so running the transcription over the first two must reproduce the third. It
// does. The strength is pass-dependent and the suite says so -- while the view matrix is identity,
// which is every sample reachable from outside a render hook, the product cannot distinguish a
// transposed implementation. What covers the ORDER is a synthetic case checked against the closed
// form of P * T in all sixteen coefficients, including the homogeneous row, since a bug confined to
// row 3 passes both an identity multiply and a translation checked only at [3] and [7].
//
// +0xF8 IS THE WORLD-TO-SCREEN MATRIX -- viewportTransform * viewProjection. Closing this needed the
// 48-byte operand identified, and it was hiding in a register: the builder does
// `lea ecx, [ebp+var_BC]` at 0x610BD4, and ecx survives that whole span -- one write, no intervening
// calls -- to LTMatrix3x4_Set12Thunk at 0x610C71. So var_BC is what that call fills, and its argument
// setup names it outright:
//
//     [ halfW    0       0   centreX ]     halfW   = (right - left) / 2
//     [ 0      -halfH    0   centreY ]     centreX = left + halfW  (`fild [ebx+4]`, `fadd halfW`)
//     [ 0        0       1   0       ]     centreY = top  + halfH
//
// the VIEWPORT TRANSFORM: clip -> pixels with y flipped.
//
// AND IT EXPLAINS THE IDENTITY THIS FIELD READS LIVE, which had been recorded as an oddity. In the
// screen pass the view-projection IS the screen ortho -- 1/2560, -1/720, biases -1 and +1 -- and the
// viewport transform is its exact inverse -- 2560, -720, centres 2560 and 720. So 2560 * (1/2560) = 1
// along the diagonal and -2560 + 2560 = 0 in the translation column: the product is the identity BY
// CONSTRUCTION, not by coincidence, and the measured identity is the confirmation.
//
// That makes it the matrix a consumer actually wants -- world point straight to pixel -- so
// sdk::SceneCamera exposes project_point(), viewport_transform() and world_to_screen_is_coherent().
// The last ties FOUR separately-written regions (the rect, the view, the projection and the composed
// result) and holds in whatever pass is live, so it is the widest coherence check on this record. The
// suite also projects a point in the screen pass and requires it to come back UNCHANGED, which is a
// real round trip rather than a tautology: that identity is the ortho and the viewport transform
// cancelling, and an error in either breaks it.
//
// ---- THE PROJECTION BUILDERS, AND WHAT THEY PROVE ABOUT THE HALF-PLANE ----
//
// THE HALF-PLANE UNITS ARE NOW PROVEN, not inferred from a ratio. Two earlier passes could only
// say "consistent with tan(fov/2)"; LTMatrix_BuildPerspectiveProjection settles it. The caller does
// `lea eax, [ebx+30h]` -- the SceneCamera's half view-plane pair -- and the builder emits
//
//     [ 1/halfX   0        0    0     ]
//     [ 0         1/halfY  0    0     ]
//     [ 0         0        1  -near   ]
//     [ 0         0        1    0     ]      m[3][2] = 1, so w = z
//
// A perspective projection's x scale IS 1/tan(fovX/2). Here it is literally 1/halfX, so
// halfX = tan(fovX/2), and the reciprocals the engine caches in k_vHalfViewPlane are exactly these
// matrix scales -- which finally explains WHY it stores them at all.
//
// LTMatrix_BuildAffineProjection (mode 1) is a DIFFERENT matrix, not a rescaled one, and checking
// that mattered because homogeneous matrices are scale-equivalent and the mislabel would have been
// invisible. With k = far - near:
//
//     [ k/halfX   0        0    0     ]
//     [ 0         k/halfY  0    0     ]
//     [ 0         0        1  -near   ]
//     [ 0         0        0    k     ]      m[3][2] = 0, so w ignores z
//
// Scaling the perspective matrix by k would give m[2][2] = k, m[2][3] = -k*near, m[3][2] = k and
// m[3][3] = 0. This has m[2][2] = 1, m[2][3] = -near, m[3][2] = 0, m[3][3] = k: the nonzero moved
// from m[3][2] to m[3][3], which no scaling can do.
//
// SO THE CLASSIFIER MUST KEY ON m[3][2], NOT m[3][3]. Three shapes exist here:
//
//     builder                                m[3][2]  m[3][3]  m[0][0]
//     LTMatrix_BuildPerspectiveProjection       1        0      1/halfX
//     LTMatrix_BuildAffineProjection            0       f-n     (f-n)/halfX
//     the screen pass's stored matrix           0        1      2/width
//
// An earlier version of sdk::SceneCamera tested m[3][3] == 1, which quietly meant "the screen
// pass's normalisation" and mislabelled mode 1. And the comparison must be RELATIVE to the w row
// m[3][0..3] -- not to the whole matrix's largest coefficient, because a narrow field of view makes
// m[0][0] enormous and a perspective m[3][2] of 1 then falls under max*epsilon and reads as affine.
//
// tan(fov/2) = m[3][2] / m[0][0] is the scale-invariant form, and the one the SDK uses.
//
// LTMatrix4x4_SetRowMajor16 (0x60C23C) is why every builder's argument list reads directly as the
// matrix: it stores 16 floats to [ecx+0x00..0x3C] in argument order. Row-major with translation in
// the last column, which a live read of the screen pass independently confirmed.
//
// THE THIRD BUILDER: LTMatrix_BuildScreenOrthoProjection (0x610658), the mode-2 stored matrix.
// eax = the half-extent pair, and it emits a 3x4:
//
//     [ 1/halfX      0         0   -1 ]
//     [ 0        -1/halfY      0    1 ]
//     [ 0            0         1    0 ]
//
// IT REPRODUCES THE LIVE MEASUREMENT EXACTLY, not approximately: with the record's half-extents at
// (2560, 720), 1/2560 = 0.00039063 and -1/720 = -0.00138889 -- the values read out of the running
// game to eight decimals, biases included. LTMatrix3x4_SetRowMajor12 (0x4207A7) stores its twelve
// arguments in order, which is why the builder's argument list reads directly as the matrix.
//
// AND IT CORRECTS AN IDENTITY THIS FILE HAD SLIGHTLY WRONG. The x scale is 1/halfX, NOT 2/width.
// Those agree only because the screen pass's half-extents happen to be exactly half the viewport --
// separately true, but a different fact. Every one of the three builders divides the HALF-EXTENT into
// its scale, never the viewport.
//
// WHICH YIELDS ONE IDENTITY COVERING ALL THREE PASSES: m[0][0] * halfX equals whichever element of
// the w row is nonzero, because that element IS the matrix's overall scale.
//
//     perspective   m[0][0] = 1/halfX       product 1     = m[3][2]
//     affine        m[0][0] = (f-n)/halfX   product f-n   = m[3][3]
//     screen ortho  m[0][0] = 1/halfX       product 1     = m[3][3]
//
// That matters for more than tidiness. The earlier version of the check handled only the perspective
// case and returned false otherwise, so it could NEVER run on a live snapshot -- the engine leaves
// this record in its screen pass between frames. Generalised, it is now the one matrix identity in
// the suite verified against the running game rather than against a matrix we built.
//
// THE PERSPECTIVE PATH IS NOT REACHABLE BY SAMPLING. 4000 consecutive reads of the record all found
// mode 2: the engine leaves it in the affine screen pass between frames, since the UI draws last.
// The 3D pass does write this record -- k_vHalfViewPlane still holds (2.2651, 0.6371) from one --
// but mode 2 overwrites the record afterwards while the shader parameter keeps its older value.
// So sdk::SceneCamera exposes the builders as pure functions, and the suite exercises the
// classifiers and fov_*_radians() on a matrix of known shape. Building one with the engine's own
// layout recovers 65.002 degrees vertical from half_y = 0.6371, and multiplying every coefficient
// by 137.5 returns the identical angle. That tests the CLASS; it is not corroboration of the engine.

//
// EXPOSED AS sdk::SceneCamera, and the shape of that class is dictated by a hazard: THE RENDER
// THREAD REWRITES THIS RECORD ONCE PER PASS. A field-by-field read can pair one pass's viewport
// with the next pass's matrices, fault nothing, and look entirely plausible. So snapshot() takes
// the whole 360 bytes in ONE guarded memcpy, which bounds the window without closing it.
//
// projection_matches_viewport_ortho() is the useful validator -- for an orthographic pass
// [0][0] must be 2/width and [1][1] -2/height, which ties the viewport INTS to the projection
// FLOATS. It catches a wrong offset and a tear between those two regions. It is NOT an atomicity
// check: a tear confined to the view, derived or trailing matrices satisfies it, and no invariant
// here proves the whole record came from one pass.
//
// is_orthographic_projection() improves the precondition that made an FOV accessor impossible
// last pass, without completing it. [3][3] is 1 for orthographic and 0 for row-major perspective,
// so a consumer can rule out the screen pass FROM THE DATA rather than by trusting `mode`. That is
// NECESSARY BUT NOT SUFFICIENT: a false answer only rejects this ortho shape, and says nothing
// about whether the projection is a standard unit-depth perspective matrix or where its extents
// are taken. tan(fov/2) stays provisional until sub_610560 / sub_6105DA are read.
//
// THE POSE INVARIANTS NEED A GATE, and finding out why is worth recording. The camera pose's
// quaternion being unit-length is the project's usual offset proof, and it holds in any PASS --
// but not in any STATE. This is static data, so before the first pass configures it the whole
// record is zeroes, and a zero quaternion has magnitude 0, not 1. The suite therefore gates the
// pose checks on a valid viewport rect, which is the builder's own evidence that it ran.
//
// ---- THE D3D9 DEVICE AND ITS CALL SITES ----
//
// WHICH DEVICE METHODS THE ENGINE IS SEEN TO CALL -- CANDIDATES, NOT A CENSUS. Extracted by tracking
// the two-hop the engine emits -- `mov R, g_Renderer` (device), `mov R2, [R]` (its vtable),
// `call [R2+off]` -- across all 90 functions that read the global. Because the receiver is pinned to
// g_Renderer, an unrelated object's member offset cannot masquerade as a D3D method, which is what ruined two
// earlier displacement scans.
//
//   SetRenderState        66 calls / 22 fns    <- dominates everything else
//   SetSamplerState        9 / 3               SetSetIndices 0x1A0: 7 / 4
//   Clear                  8 / 5               GetRenderState 6 / 6      SetVertexDeclaration 6 / 6
//   CreateTexture          4 / 3               CreateIndexBuffer 4 / 3   UpdateTexture 4 / 1
//   CreateOffscreenPlainSurface 4 / 4          SetRenderTarget 4 / 3     SetViewport 4 / 3
//   DrawIndexedPrimitive   4 / 4               SetStreamSource 3 / 3     CreateQuery 3 / 2
//   Set/GetDepthStencilSurface 3 each          CreateVertexBuffer 3 / 3
//   GetRenderTarget, GetDeviceCaps, SetClipPlane, GetRenderTargetData, StretchRect, DrawPrimitive 2 each
//   TestCooperativeLevel, SetGammaRamp, CreateVolumeTexture, CreateCubeTexture,
//   CreateDepthStencilSurface, GetFrontBufferData, ColorFill, GetViewport, GetClipPlane,
//   GetSamplerState, SetScissorRect, CreateVertexDeclaration 1 each
//
// NO ABSENCE MAY BE CONCLUDED FROM THIS, and an earlier draft of this note did exactly that. The tracker
// finds no Present, BeginScene, EndScene, SetTransform, SetVertexShader or SetVertexShaderConstantF -- but it
// has a MEASURED false-negative rate, and its one known miss is a CACHED-VTABLE pattern
// (`v22 = *g_Renderer` ... `call [eax+9Ch]`), which is precisely the shape a cached device pointer would take.
// The tool's blind spot is aligned with the very thing the absence was about, so "not found" here carries no
// information about those methods. Where Present and the shader constants are called remains OPEN and
// untouched by this pass.
//
// TOOL CALIBRATION, and it is weaker than a first look suggested. Against sub_615CC1 the tracker recovers 10
// of the 11 device calls actually present -- a 7-of-7 figure quoted earlier compared DISTINCT OFFSETS and hid
// the repeats that a save/set/restore flow produces. The single miss is at 0x615DDC, where the vtable had been
// cached in a local and the receiver reloaded separately.
//
// So: one function validated, one false negative measured, no bound on false positives anywhere else, and the
// tracker carries register state across calls and branches, which is unsound in principle -- a call clobbers
// eax/ecx/edx. A stricter variant that clears state at those boundaries loses a DIFFERENT true positive, which
// says its transfer rules are also wrong, not that linear tracking is right. Treat every count below as a
// candidate needing per-function reading, and do not lean on "66 SetRenderState calls" as a measurement.

//
// g_Renderer (exe+0x32E118, absolute 0x0072E118) holds the IDirect3DDevice9 POINTER. shared/sdk/Render.cpp
// already records the renderer object at that address with the device at +0x00, so the dword there IS the
// device -- and the code agrees: consumers do `(**(g_Renderer))(g_Renderer, ...)`.
//
// TWO ACCESS PATTERNS, visible in the disassembly and easy to confuse:
//   `mov eax, g_Renderer`         takes the DEVICE (this global's value)
//   `mov ecx, offset g_Renderer`  takes the renderer OBJECT's address, used as `this`
// 90 functions read it. Heaviest: 0x6152D4 (24 refs) and 0x615CC1 (10).
//
// D3D9 DEVICE VTABLE OFFSETS, an enum in the IDB named D3D9DeviceVtableOffset so call sites read as names.
// THE VALUES ARE BYTE OFFSETS, NOT SLOT INDICES -- index = offset / 4, so Clear is offset 0xAC and index 43.
// The distinction is worth labouring because getting index and offset arithmetic mixed up is exactly what put
// this mapping +3 slots out on the first attempt:
//   0x40 Reset   0x44 Present   0x94/0x98 Set/GetRenderTarget   0x9C/0xA0 Set/GetDepthStencilSurface
//   0xA4 BeginScene   0xA8 EndScene   0xAC Clear   0xB0/0xB4 Set/GetTransform
//   0xBC/0xC0 Set/GetViewport   0x148 DrawIndexedPrimitive   0x170 SetVertexShader
//   0x178 SetVertexShaderConstantF
//
// THE INDICES WERE WRONG FIRST TIME, +3 slots too high, from a header parse that counted IUnknown's three
// methods inside the interface block and then added 3 again. What settles them is not the parse but
// sub_615CC1: it calls SEVEN distinct offsets which decode as one coherent family -- save render target,
// depth-stencil and viewport, Clear, draw, restore. A wrong base would scatter those across unrelated
// methods.
//
// A CAUTION THAT COST A WHOLE SCAN: searching for `call dword ptr [reg+OFFSET]` finds mostly NOISE, because
// small displacements like 0x44 or 0xB0 are ordinary member-call offsets for any LithTech object. The first
// scan "found" Present being called from CClientMgr_StartShell. Validation has to tie the receiver to the
// intersecting call sites with functions that read g_Renderer is what produced a narrower CANDIDATE list.
//
// NOT ESTABLISHED: where the view/projection reaches the shaders. There are ZERO `call [reg+0x178]` sites,
// i.e. no direct memory-indirect call of SetVertexShaderConstantF anywhere -- but that rules out one
// syntactic form only. The slot can be loaded into a register first, reached through a state-manager wrapper,
// or constants set via D3DX effects, and with 90 device consumers a wrapper is likely. Not traced yet.

// ---- HOW FAR THE REFERENCE SDK'S INTERFACES DIVERGE FROM THIS BUILD ----
//
// With extents measured, the reference headers can be checked instead of trusted. Counting virtuals per
// CLASS BODY (forward declarations excluded -- they otherwise overwrite a real body with zero) and adding 2
// for the leading pair every table has -- the implementation-only slot 0 and IBase's single virtual at
// slot 1 -- gives a predicted entry count:
//
//   interface           declared  predicted  measured   divergence
//   ILTCursor                  8         10        10   MATCH
//   ILTTextureString          21         23        22   reference has 1 more
//   ILTPhysics                19         21        19   reference has 2 more
//   ILTCommon                 24         26        19   reference has 7 more
//   ILTModelClient            59         61        83   FEAR2 has 22 more
//   ILTModel                  56         58        81   FEAR2 has 23 more
//   ILTClient                102        104       147   FEAR2 has 43 more
//   ILTServer                 75         77       138   FEAR2 has 61 more
//
// TWO THINGS COME OUT OF THIS.
//
// THE LEADING PAIR IS INDEPENDENTLY CORROBORATED FOR ILTCursor -- and only for it. Its 8 declared methods
// plus 2 predict exactly the 10 entries measured, AND for that table both leading entries are directly
// identified rather than inferred from the arithmetic: slot 0 is abstract_base_dtor and slot 1 is
// CLTCursor_InterfaceImplementation. So the accounting is complete for CLTCursor: 2 observed + 8 declared =
// 10 measured, with nothing left over.
//
// THAT IS CONSISTENCY EVIDENCE, NOT A GENERAL RESULT. One exact match cannot establish the formula for
// interfaces that diverge, and every other one checked does diverge. The direct evidence for the leading pair
// stays what it always was -- slot 1's literal body, which makes slot 0 implementation-only -- and this
// arithmetic agrees with it on the one table where the counts can agree at all.
//
// AND THE REFERENCE CANNOT ALIGN THE BIG INTERFACES. ILTServer diverges by 61 methods, ILTClient by 43,
// ILTModel by 23. Divergence also runs BOTH ways: the reference declares more than this build for ILTCommon,
// ILTPhysics and ILTTextureString, so it is not simply an older, smaller version. Any slot mapping for those
// interfaces has to come from FEAR2's own bodies, callers and strings -- which is what the error-string chain
// and the vtable-membership tests are for.
//
// ILTCursor is the ONE table whose shape the reference matches, which makes it the only sensible candidate
// for trying the reference's declaration ORDER. Not attempted here, and it would still be a hypothesis per
// slot: a matching count constrains nothing about which method sits where, and order has already failed
// twice in this project.

// ---- THE ENGINE'S POLYMORPHIC CLASSES, FROM THEIR OWN SLOT 1 ----
//
// VERIFIED LIVE (2026-07) IN TWO SEPARATE SENSES, because the weaker one is easy to mistake for the stronger.
//
//   IDENTITY, 30 of 30: every table in this index was read in the running process and each one's slot 1
//   returned exactly the class name recorded here. That confirms content and relocation -- nothing more. A
//   first pass sampled 15 and was written up as "15/15", which reads as full coverage of a 30-entry index;
//   the other 15 were then checked rather than the sentence reworded.
//
//   USE, 27 of 29: reading a table's bytes says nothing about anything USING it. Each table also has an
//   aligned data slot holding its address, but such a slot could be a registry entry or a plain table
//   pointer rather than an object's vptr -- so the slots were CLASSIFIED against the engine's own interface
//   registry, which publishes the object pointer for each interface name. 27 slots are exactly a registry
//   object's address, which makes them objects whose vptr sits at +0x00, and in every case the registry's
//   INTERFACE name pairs with the class name the vtable reports for ITSELF:
//
//     ILTClient.Default -> CLTClient            ILTServer.Default -> CLTServer
//     ILTModel.Client -> CLTModelClient         ILTModel.Server -> CLTModelServer
//     ILTCommon.Client -> CLTCommonClient       ILTCommon.Server -> CLTCommonServer
//     ILTPhysics.Client -> CLTPhysicsClient     ILTPhysics.Server -> CLTPhysicsServer
//     ILTTimer.Client -> CLTTimerClient         ILTTimer.Server -> CLTTimerServer
//     ILTSoundMgr.Client -> CSoundMgr           ILTSoundMgr.Server -> CLTSoundMgrServer
//     ILTInput.Default -> CLTInput              ILTCursor.Default -> CLTCursor
//     ILTUI.Default -> CLTUI                    ILTRenderer.Default -> CLTRenderer
//     ILTCustomRender.Default -> CWin32CustomRender
//     ILTTextureMgr.Default -> CLTTextureMgr    ILTTextureString.Default -> CLTTextureString
//     ILTVideoTexture.Default -> CLTVideoTexture
//     ILTFileMgr.Default -> CLTFileMgr          ILTResourceMgr.Default -> CLTResourceMgr
//     ILTLoadingProgress.Default -> CLTLoadingProgress
//     ILTClientContentTransfer.Default -> ILTClientContentTransfer
//     ILTServerContentTransfer.Default -> ILTServerContentTransfer
//     ICompress.Default -> CCompress
//     IWorldParticleBlockerData.Default -> CWorldParticleBlockerData
//
//   THE TWO LEFT UNCLASSIFIED are CLTGameUtil (slot 0x6EBCE8) and ILTOnlineService (0x6E5704): their
//   registry entries exist but no registry object sits at those addresses in this state, so the slots stay
//   unexplained rather than assumed to be vptrs. CLTTimer has no data slot at all, consistent with a base
//   whose vptr is only installed by code -- CLTTimerClient and CLTTimerServer are its 22-entry siblings.
//
// NO RTTI ON ANY OF THEM, and that is now measured rather than inferred from one sample: the image holds 206
// type descriptors, of which 5 are std::/CRT and the other 201 are ALL Havok (hk*, hkp*). So FEAR 2 ships
// Havok compiled with RTTI while the LithTech classes are built without it -- which is why [vt-4] is never a
// Complete Object Locator here, and why the self-naming slot 1 is the only class-identity signal available
// for engine classes. It also locates the physics: hkpMultiThreadedSimulation, hkpBvTreeAgent and the
// character-proxy machinery behind ILTModel's Add/RemoveCharacterProxyToWorld.

//
// Every one of these classes NAMES ITSELF: vtable slot 1 is IBase::_InterfaceImplementation, whose body is
// `mov eax, <string>; retn`, so the class's own name can be read out of the instruction without calling it.
// Scanning .rdata for that shape found 32 such tables; 26 were unnamed and are now named <Class>_vftable.
//
// TWO GATES BEFORE ANY NAME WAS APPLIED, because a `{code pointer, constant-string getter}` pair can occur
// INSIDE a table as well as at its start -- a class implementing several interfaces has one such pair per
// base:
//   * ADDRESS-REFERENCE EVIDENCE. Each address had to be NAMED somewhere -- a `mov [reg], offset table` in
//     code, or an aligned dword in initialised data holding it. All 30 qualified, 22 by a data dword alone
//     with no code store.
//     THIS DOES NOT REJECT AN INTERIOR COINCIDENCE, and the analyzer rates the same signal as WEAK for
//     exactly that reason: an interior slot's address is legitimately referenced for patching or
//     registration. What it does is make a candidate worth classifying at all. IDENTITY comes from slot 1's
//     literal; TABLE START and USE are separate questions, and use is settled for 27 of them against the
//     engine's interface registry -- see the VERIFIED LIVE block above.
//   * EXTENT. Reported by reversing/ida_vtable_boundary.py, and recorded only where a defined data item
//     follows the run AND no interior address looks like a table start. All 30 came out that way.
//     THESE COUNTS ARE STRONGLY BOUNDED, NOT PROVEN. The trailing string bounds the SCANNED RUN; that the
//     FIRST table spans all of it rests on no interior start being DETECTED, by two recognizers -- a vptr
//     field in initialised data (.data, .rdata and .bss) and a vptr store in code. A start installed some
//     other way would go unseen. The counts did survive broadening both recognizers, which is worth more
//     than the original run: same 30 numbers under a strictly stronger test.
//
// That second gate needed the analyzer fixed first: it detected interior starts only through code vptr
// stores, so for the statically initialised classes -- most of this list -- an adjacent table's start was
// invisible and a run could quietly continue into the next class. It now also treats an aligned dword in
// initialised data that points at an interior address as a start candidate. Note that is a START signal, not
// a claim about what the dword IS.
//
//   CLTClient                 0x0066F258  147     CLTServer                 0x00675670  138
//   ILTOnlineService          0x00678A60  129     CLTRenderer               0x0068FD20   92
//   CLTModelClient            0x0066E7E8   83     CLTModelServer            0x00674CD8   81
//   CSoundMgr                 0x00676520   52     CLTResourceMgr            0x00672708   35
//   CWin32CustomRender        0x0068FEA0   29     CLTInput                  0x00677FA0   28
//   CLTGameUtil               0x006D3270   24     CLTTextureString          0x00672808   22
//   CLTTimer                  0x00672878   22     CLTTimerClient            0x006728E0   22
//   CLTTimerServer            0x00672948   22     CLTCommonClient           0x0066E600   19
//   CLTCommonServer           0x00674BD8   19     CLTPhysicsClient          0x0066EA70   19
//   CLTFileMgr                0x00672130   18     CLTPhysicsServer          0x00674E90   17
//   CLTSoundMgrServer         0x00674F60   15     CLTVideoTexture           0x00690090   13
//   CCompress                 0x0066FC38   11     CLTTextureMgr             0x006900D4   11
//   CLTUI                     0x0067820C   11     CLTCursor                 0x00677E3C   10
//   ILTClientContentTransfer  0x006720C8    9     ILTServerContentTransfer  0x006727A4    9
//   CWorldParticleBlockerData 0x0067764C    6     CLTLoadingProgress        0x00672184    4
//
// WORTH NOTING for future work: CLTTimer, CLTTimerClient and CLTTimerServer are all 22 entries, the shape of
// a base and two derived classes; and the client/server pairs (CLTCommon*, CLTPhysics*, CLTModel*) differ in
// size, so they are separate implementations rather than one table shared two ways -- which the
// GetModelAnimUserDims case shows can also happen at the individual-slot level.

// ---- ILTClient's VTABLE: A 147-ENTRY RUN, BOUNDED BY A STRING ----
//
// Instance g_CLTClient_instance (FEAR2.exe 0x6E3138), vtable CLTClient_vftable (0x66F258). This is the
// object gameclient.dll's g_pILTClient holds, so the game's 787 reads of that global all dispatch here.
//
// THE END OF THE RUN IS EVIDENCED, NOT SCANNED. Reading forward until a pointer stops looking like code
// would be unsound in both directions: a valid slot may target another module, and the next vtable's entries
// look executable too. What bounds it is a static xref -- the dword at 0x66F4A4 is referenced as
// `offset aCltclient`, i.e. it IS the string literal "CLTClient" -- so the pointer array ends at 147.
//
// That the 147 are ONE table is the weaker half, and it rests on no interior vptr store being DETECTED,
// by a check matching a single instruction shape. RTTI cannot corroborate ([vt-4] is string bytes, not a
// Complete Object Locator, though the image carries RTTI for std:: types), and there is no constructor to
// read: the instance is statically initialised. Treat 147 and the slot indices as build observations.
//
// SLOT 1 is IBase::_InterfaceImplementation, returning "CLTClient" -- the same anchor that fixed
// CGameClientShell's +2 offset in gameclient.dll. Its body is `mov eax, <str>; retn`, an entry sequence
// the SDK reads WITHOUT calling (sdk::interfaces::slot1_constant_string). Measured live: all 36 resolved
// interfaces carry that same entry sequence at slot 1.
//
// WHAT IS NOT ESTABLISHED ABOUT THE OBJECT. Only +0x00 is proven: it holds the vtable above (live read,
// and slot 1 returns "CLTClient"). The dwords that FOLLOW +0x00 in .data are function addresses, and it
// is tempting to read them as a block of direct method pointers -- five CLTClient_* methods do exist that
// are absent from the vtable (GetServiceList, SelectService, GetTcpIpAddress, IsLobbyLaunched,
// GetLobbyLaunchInfo), which makes that story attractive. It is NOT supported:
//   * a run of .text addresses in .data is equally consistent with neighbouring globals, and at least two
//     of them ARE independent -- 0x6E31B0 and 0x6E31B4 are pushed as their own globals (off_6E31B0,
//     off_6E31B4) from 0x406829 and 0x40686A;
//   * no constructor or static initializer has been traced writing 0x66F258 together with those pointers
//     as one aggregate, and no code was found accessing them as [g_pILTClient + offset].
// Methods missing from a vtable need no exotic explanation anyway -- non-virtual members do not appear
// there. Nothing past +0x00 is modelled until an initializer or an indexed access proves the extent.
//
// A STORE THAT LOOKED LIKE A CONTRADICTION, AND IS NOT: sub_66B35F does
// `mov [0x6E3138], offset off_678C80`, writing a different 151-entry vtable into that same first dword,
// while the live field reads CLTClient_vftable. Both are true, of different lifecycle phases:
//   * sub_66B35F is in .text (perm R+X, and .rdata does not start until 0x66D79C, so this is not data
//     being disassembled as code) but has ZERO code xrefs and one DATA xref: `push offset sub_66B35F;
//     call sub_6527B9` at 0x6668DB -- an atexit registration, matching the identical pair one line above.
//     So it runs at STATIC DESTRUCTION, never during play, which is exactly why the live read differs.
//   * the mechanism is recognisable: off_678C80's first entry is sub_475455, whose body is
//     `mov dword ptr [esi], offset off_678C80` -- a destructor setting the vptr, the ordinary MSVC
//     pattern -- and that same function is CLTClient_vftable's slot 0.
//
// off_678C80 IS TWO ENTRIES, not the 151 first claimed here. That claim came from a forward scan whose own
// output refuted it -- it found the vptr-reset destructor THIRTEEN times, and a class has one -- so the run
// had walked through many adjacent tables. Withdrawn along with everything derived from it ("137 distinct",
// "one _purecall", "a fully implemented class").
//
// The extent now rests on a boundary reference: 0x474A9A and 0x475A4D both do
// `mov [esi], offset off_678C88`, so two independent sites treat the very next dword as a table start.
//
//   slot 0  abstract_base_dtor (0x475455) -- writes off_678C80 into [this], the MSVC base-dtor vptr reset
//   slot 1  _purecall
//
// So the SHAPE is an abstract base with exactly one pure virtual, and it is stored as the vptr by 47
// distinct sites. CLTClient_vftable shares slot 0 and overrides slot 1 with CLTClient_InterfaceImplementation
// returning "CLTClient" -- precisely the relationship the reference SDK describes for IBase, whose single
// virtual _InterfaceImplementation is pure. That independently corroborates the slot-1 anchor this project
// used for CGameClientShell's +2 offset, arriving from the base's side rather than the derived one.
//
// STILL NOT ESTABLISHED: that those 47 share one base CLASS. One shared table is equally consistent with
// many identical abstract-base tables folded together by /OPT:ICF, which this binary does heavily. The
// shape is evidence; the class identity is not.
//
// 44 of the 147 implementations were already named from earlier passes, which the slot indices now
// attach to the interface. A sample, and note these are the ENGINE's implementations in FEAR2.exe:
//    16/17  GetObjectRotation / SetObjectRotation      18/19  GetObjectPos / SetObjectPos
//    25/26  GetObjectScale / SetObjectScale            27..30 GetObjectColor / SetObjectRGB/Alpha/Color
//    46..65 the light block (type, radius, texture, spot info, directional dims, detail settings)
//    77/78  Register/UnregisterConsoleProgram          82/83  ClientTime_GetSeconds / GetMilliseconds
//    87     RemoveObject                              111/112 IsKeyDown / TranslateKey
//    118    GetLocalClientID                          120/121 GetSConValueFloat / GetSConValueString
//    122    ClientShell_GetRealTime                   123    SendToServer
//    140    cis_GetEngineHook                         143    IsServerObject
//
// SLOT 122 IS THE SHELL'S real_time CLOCK, already mapped as ClientShell_GetRealTime (0x406BDC) -- it
// loads g_pClientMgr, follows +0x1434 and reads the double at shell+0x10. So the clock the CClientShell
// class exposes and this interface method are the SAME accessor, and per that mapping it is ~2 Hz
// quantised: accurate in aggregate, useless per frame. CGameClientShell_Update calls it and compares
// against a stored double, which makes that a ~2 Hz periodic branch rather than a per-frame one.
//
// NINE MORE SLOTS NAMED (2026-07) from the binary's own error strings, reached through the pointer-variable
// indirection IDA does not xref -- see MAPPING_WORKFLOW.md:
//   20 ForceCurrentObjectPos   31 GetObjectShadowLOD   35 SetObjectShadowLOD
//   50 SetLightIntensityScale  51 GetLightIntensityScale
//   21/22 GetObjectTransform, 23/24 SetObjectTransform -- TWO ENTRY POINTS EACH for one operation, kept as
//         _slotNN because what the pairing is stays open: overloads look like this, and so does one method
//         inherited from each of two interfaces. Both of each pair pop two dwords, so arity cannot separate
//         them; their bodies differ (direct object+0x14 read versus LTTransform_Copy), which is a difference
//         and not an identification.
// Five other names have a same-string twin OUTSIDE this vtable, in the 0x449000-0x44AFFF block; those twins
// are left unnamed, since sharing an error string does not make a function that method.
//
// The rest are unnamed. NOT attempted: matching them against the reference iltclient.h declaration order --
// CGameClientShell's slot map already showed that order does not transfer.

// ---- CAPIHolder IN gameclient.dll: HOW THE GAME DLL GETS ITS INTERFACES ----
//
// The SDK already scans FEAR2.exe for CAPIHolder call sites (shared/sdk/interfaces/Registry.cpp).
// gameclient.dll links its OWN copy of the same base ctor at 0x101781D0 and has 46 holders of its own,
// so the same class shows up twice in the process with separate instances.
//
// HOLDER LAYOUT, 12 bytes -- proven by the ctor's stores, the dtor's reads, AND the 0xC stride across
// the seven consecutive holders at 0x101FC180..0x101FC1C8:
//   +0x00 void*  vftable        ONE PER INTERFACE NAME, shared by that interface's holders. Measured:
//                                 46 holders, 13 distinct vtables -- all 9 ILTInput holders share
//                                 0x101C1F24, all 18 ILTOnlineService share 0x101C1F34. (Two adjacent
//                                 vtables differing is NOT evidence each holder has its own: those two
//                                 belonged to two different interfaces.)
//   +0x04 char*  name           "ILTClient.Default" etc -- read live to confirm
//   +0x08 void** ppInterface    address of the pointer variable; zeroed at ctor, filled at runtime
//
// IDENTITY COMES FROM +8. The holder that names an interface stores the ADDRESS OF that interface's
// pointer variable, so name -> global is a decoded relationship, not a guess from adjacency. Verified
// live for all seven (holder+8 == &g_pXxx, and holder+4 reads back the expected name).
//
// THE VTABLE CORROBORATES BUT MUST NOT BE USED AS IDENTITY, and the reason is specific to this DLL.
// What was measured is narrow: among these 46 holders, 13 observed names map one-to-one onto 13
// vtable addresses. That is an observation, not a rule -- nothing here shows two interfaces CANNOT
// share a vtable address.
//
// And this is the DLL where ~133 identical retn-only methods were measured folded onto ONE address
// (see shared_empty_stub). Identical CAPIHolder<T> vtables are exactly the kind of thing that folding
// merges, and it would break the inference in the DANGEROUS direction: a folded vtable shared between
// two interfaces makes "same vtable => same interface" false, silently. The one-to-one seen here is
// contingent on those 13 vtables happening to differ, not on any guarantee that they must.
//
// So grouping holders by vtable is a cheap heuristic worth cross-checking, never the evidence.
// Semantic identity stays where it was decoded: the name at +4 and the ppInterface at +8.
//
// WHY ADJACENCY IS A TRAP HERE: the seven pointers sit consecutively at 0x101FC160..0x101FC178, which
// makes them LOOK like one table with an obvious order. They are seven separate variables, and an
// interface can have several -- ILTInput has 9, ILTOnlineService 18. Reader counts settle which copy
// the DLL actually uses (ILTClient: 787 readers at 0x101FC170 versus 2 at 0x102042F4), and getting
// that backwards is easy: ILTCustomRender's most-read copy is 0x1020172C, NOT the one in this band.
//
// UNRESOLVED: whether g_pAPIHolderList (0x1020458C, this module's holder list) is handed to the
// engine's interface database or stays module-local. Not traced. The SDK's Registry scanning the exe
// only is a fact about our scanner, not evidence about the game's topology.

// ---- IClientShell: THE GAME DLL'S PER-FRAME ENTRY POINTS ----
//
// TWO DIFFERENT VTABLES ARE IN PLAY AND THIS NOTE IS ABOUT THE OTHER ONE. The class below,
// CClientShell, is the ENGINE-side object; its own vtable lives in FEAR2.exe and its `vtable`
// field is at +0x00. Nothing here describes those slots.
//
// The slots below belong to ICLIENTSHELL, the interface the GAME DLL implements. CClientShell::Update
// (0x40CC5E) does NOT reach it through any field of the class below -- it dispatches through the
// GLOBAL g_pIClientShell (0x6ECD3C), whose object is gameclient.dll's
// CGameClientShell. So "slot 2" here means IClientShell slot 2, never CClientShell slot 2.
//
// Update calls three of those slots every frame, at vtable offsets 8, 16 and 12 -- slots 2, 4, 3, in
// THAT order. The implementations are in gameclient.dll (see that IDB, where they are named), and
// the slot map rests on evidence rather than on matching the reference SDK's declaration order,
// which does NOT line up:
//
//   slot 0  an IMPLEMENTATION-ONLY leading slot. The reference's IBase declares exactly one
//           virtual, so this one is not in the published interface -- and it is what explains the
//           +2 shift between the reference's order and the real indices. Its body looks like an
//           MSVC vector-deleting destructor but that is not proven, so it stays unnamed.
//   slot 1  _InterfaceImplementation -- returns the literal "CGameClientShell", which is what
//           anchors slot 1 to IBase and therefore slot 0 to the gap.
//   slot 2  PreUpdate  -- points at the DLL's SHARED EMPTY STUB. gameclient.dll is linked with
//           an address that ~133 pointer-array entries reach -- measured as 133 code xrefs plus 133 .rdata
//           pointer-array entries out of 138 data xrefs, the likely cause being identical-COMDAT
//           folding of every retn-only method. Update itself calls it twice for other empty methods. The SLOT is PreUpdate by layout; the ADDRESS is nobody's in particular,
//           so its emptiness corroborates nothing and a detour there fires for ~138 virtuals.
//   slot 3  PostUpdate -- 0x1A2 bytes.
//   slot 4  Update     -- 0x940 bytes, by far the largest of the triple.
//
// So the call order 2 -> 4 -> 3 is Pre -> Update -> Post, the natural sequence, and it matches the
// reference's note that "Update() is called immediately after PreUpdate()" even though the header
// declares them Pre/Post/Update. The odd call order is explained by the odd declaration order.
//
// FOR A MOD: these are the GAME-side per-frame hook points, distinct from the ENGINE-side
// CClientShell::Update that the fear2vr framework currently detours.


// The CLIENT SHELL, reached from CClientMgr.client_shell (+0x1434). Mapped from the
// ENGINE'S OWN ACCESSORS rather than by staring at bytes: 25 functions reach the shell
// through that displacement, and the small ones are each a getter for one field, which
// makes the field's type and its bounds self-evident.
//
// PARTIAL BY CONSTRUCTION. The size below covers only the region those accessors and
// CClientShell::Update touch; the class certainly continues past it. There is exactly
// ONE live instance, so nothing here has a population behind it -- every value is a
// single sample from one paused main-menu state, which is much weaker evidence than
// this file's object-level claims. The CODE that reads each field is the real
// evidence; the values are illustration.
class CClientShell 0x80 {
    void* vtable            @0x00   // live 0x66F9E8
    uint32_t unk_04         @0x04   // live 1440
    double game_time        @0x08   // CONFIRMED a clock that STOPS with the game: read by ClientShell_GetGameTime (0x407490), and across 1.5s of measured wall time at a paused menu it did not move at all (1186.6610 three times). Its origin differs from the counter node's clock (1186 vs 127), so the two are different quantities, not the same clock scaled.
    double real_time        @0x10   // CONFIRMED a clock that KEEPS RUNNING while the game is paused: read by ClientShell_GetRealTime (0x406BDC), and over the same paused window it advanced 1.5070 against 1.5000 of wall time (ratio 1.005). QUANTISED, which matters more than it sounds: polled 58 times over 2.97s it took only 6 distinct values, stepping 0.5010..0.5060 -- a ~2 Hz clock. Accurate in aggregate, useless per-frame. CClientMgr.last_sample_time_ms is the fine-grained wall clock (57 steps of 46..54ms over the same window).
    float frame_interval    @0x18   // CONFIGURED, not measured: bit-identical 0x3C888889 across 8 samples, which is exactly 1/60 as a float. A measured frame delta would jitter in the low bits; this does not move at all. WHICH subsystem consumes it is unmapped -- the nearby FPS-limiter block in CClientMgr::Update is the obvious candidate and was not traced.
    void* unk_1C            @0x1C   // heap pointer, live 0x05F8CB90 (near the shell itself)
    void* subobject_20      @0x20   // CONFIRMED a vtable-bearing sub-object, not a flag, even though one getter treats it as a boolean: sub_40713C returns `shell && *(shell+0x20)` (i.e. mere presence), while sub_406BF4 calls its vtable SLOT 12 with two arguments and maps the result to 0/63. Live the pointee's vtable is 0x674228, inside FEAR2.exe.
    uint8_t local_client_ids[4] @0x24 // CONFIRMED a 4-entry table of LOCAL CLIENT IDs with 0xFF meaning "none", named by the engine itself: CLTClient_GetLocalClientID (0x408D59) is `if (index < 4) { v = *(uint8_t*)(shell + 0x24 + index); if (v != 0xFF) { *out = v; return 0; } } return 63;` and logs the string "CLTClient::GetLocalClientID" when index >= 4. The bound 4 is the engine's, not a guess. Live 0x00,0xFF,0xFF,0xFF -- one local client, id 0, which is what single-player should look like.
    uint8_t unk_28          @0x28   // a GATE byte: sub_40C8C2 proceeds only when this is non-zero (alongside two unrelated globals), and sub_406F6F copies it out through an out-parameter with LTRESULT-style 0/1. Live 1.
    uint32_t unk_2C         @0x2C   // live 0x0066EAE4 -- an address inside FEAR2.exe's data, so a pointer to static data rather than a number
    uint32_t unk_30         @0x30   // live 1792 (0x700)
    uint32_t unk_34         @0x34   // read out by sub_406F18 through an out-parameter with 0/1 return. Live 1200.
    uint32_t unk_38         @0x38   // live 32
    CClientMgrListLink list_50 @0x50 // CONFIRMED an intrusive list head, currently EMPTY: both words equal the field's own address (0x5F87080). Reusing CClientMgrListLink for field order (prev@0x00/next@0x04) as elsewhere.
    CClientMgrListLink list_58 @0x58 // CONFIRMED a second empty list head, self-pointing at 0x5F87088
    uint16_t local_player_handles[4] @0x60   // CONFIRMED the LOCAL PLAYERS' object HANDLES, one slot per local client, 0xFFFF for an empty slot. Resolved through CClientMgr's handle table, slot 0 gives handle 7394 -> an OT_MODEL whose .mdl is `char\player\player\fp_playerm05.mdl` -- the first-person player viewmodel -- with dims (40, 95, 40), i.e. a player-sized collision box. Slots 1..3 are 0xFFFF, matching local_client_ids at +0x24, which has one occupied slot and three at 0xFF: the two arrays are index-aligned by local-client slot. // An earlier note here said only "the 0xFFFF-sentineled uint16 table CClientShell::Update walks... what they index is unmapped". It indexes the handle table, and what comes out is the player. // 0xFFFF IS THE EMPTY SLOT, from the resolver: CClientShell_ResolveLocalPlayerObject (0x450784) bounds-checks the index against 4, reads this array, returns null on 0xFFFF, and otherwise calls CClientMgr_HandleToObject. So an empty slot is 0xFFFF rather than 0.
    LTObject* local_player_objects[4] @0x6C  // CONFIRMED the SAME objects as the handles above, already resolved to pointers: slot 0 holds 0x2876BDA0, which is exactly what resolving handle 7394 returns, and slots 1..3 are null where the handles are 0xFFFF. Two routes to the local player that agree -- the handle for anything the engine's ILT* API needs, the pointer for a direct read. This is the anchor object a VR mod needs, reachable without scanning or heuristics. // REFRESHED EVERY FRAME, not a cache to distrust: CClientShell::Update ends by looping index 0..3 and, for each, calling CClientShell_ResolveLocalPlayerObject and storing the result here when it differs. So this array is the handles above resolved through the manager once per frame -- which is why sdk::CClientShell::local_player() can hand out the pointer without a staleness caveat, unlike the model bone caches.
    uint8_t unk_69          @0x69   // copied out by sub_408D2F, which substitutes 5 when no shell exists -- so 5 is a meaningful default for whatever this selects. Live 1 (from the 0x401 dword at +0x68).
}

// One slot of CClientMgr's object handle table. This is the mapping every ILT*
// call goes through: the engine's HOBJECT is an INDEX into this vector, not a
// pointer, which is why no global in the module holds an object pointer.
//
// CClientMgr_RegisterObjectHandle (0x40BEC2) is the whole story: it grows the
// vector to handle+1 if needed, then writes {1, object} at index `handle`. So a
// live slot is tagged 1 and holds the object; anything else is a free slot.
class LTObjectHandleEntry 0x8 {
    uint32_t tag       @0x00   // CONFIRMED 1 on every live entry (3248/3248). The registration writes it from a caller-supplied word that is always 1 at the one call site, so it reads as an occupancy/kind tag rather than a refcount.
    LTObject* object   @0x04   // CONFIRMED: for every live object with a handle, table[handle].object == that object, 3248/3248 with ZERO mismatches across all seven type buckets.
}

// std::vector<LTObjectHandleEntry> -- same _SECURE_SCL shape as the other vectors
// here, and the engine's own size/index helpers (StdVector8_Size / StdVector8_At)
// confirm the 8-byte element from its arithmetic rather than from our assumption.
class LTObjectHandleTable 0x10 {
    void* proxy                  @0x00   // live 0 here, unlike StdString's -- this vector is not iterated through a checked iterator
    LTObjectHandleEntry* first   @0x04
    LTObjectHandleEntry* last    @0x08
    LTObjectHandleEntry* end_cap @0x0C
}

// FEAR2.exe's engine-side client manager singleton (see
// shared/sdk/CClientMgr.hpp/.cpp -- already deployed via a hand-derived
// offset before this pass; this formalizes it into the regenny convention).
// Live instance via g_pClientMgr: FEAR2.exe base + RVA 0x2ECCA0
// (FEAR2_dump.exe VA 0x6ECCA0; FEAR2.exe loads at its preferred base
// 0x400000 at runtime -- see AGENT.MD's "IDB truth vs runtime truth" note --
// so the dump VA is directly usable as the RVA source, not just a hint).
//
// client_shell/updating: CONFIRMED live (2026-07) via TWO independent paths
// agreeing exactly: (a) raw memory read through g_pClientMgr -> +0x1434/
// +0x143C, (b) the ALREADY-DEPLOYED sdk::CClientMgr (pre-dating this .genny
// mapping, hardcoded offset 0x1434) reporting the identical addresses live
// via /sdk/targets. Field evidence: CClientMgr::Update (dump 0x40B665).
//
// counter_list_head/own_counter_node: CONFIRMED via CClientMgr::Init (dump
// 0x40AEC6) wiring the two together, live-verified exactly (see
// CClientMgrListLink/CClientMgrCounterNode above).
//
// start_shell_list: CONFIRMED STRUCTURALLY -- CClientMgr::StartShell
// (dump 0x40A90A, embedded debug string "CClientMgr::StartShell") inserts
// 272-byte allocated nodes into a list at this exact offset (found via a
// level/archive file scan -- "Arch01"/findfirst-findclose evidence in that
// function) using the SAME insertion pattern as counter_list_head. Live-
// verified EMPTY at the main menu (next == head, i.e. no entries). Named
// for the confirmed insertion site, NOT "loaded_shell" -- what the 272-byte
// nodes actually represent (levels? archives? something else StartShell
// tracks) is NOT confirmed; node payload not investigated.
//
// object_lists: CONFIRMED, and the biggest find of this pass. An array of
// SEVEN CClientMgrListLink sentinel heads. Static evidence: two independent
// loops iterate them identically -- dump 0x40CB24 (`for (i = 0; i < 0x38;
// i += 8) sub_40B52A(i + g_pClientMgr, 1)`) and dump 0x40D065 (two more
// `i < 0x38; i += 8` loops walking `*(v1+4)` until it returns to the head).
// 0x38 / 8 == 7 heads.
//
// Live: walked all 7 in one main-menu snapshot -- 3490 objects reached,
// every list terminating cleanly back at its own head. The elements are
// LTObjects (see LTObject above), recovered as `link - 172` exactly as the
// engine's own walkers do.
//
// BUCKETED BY TYPE -- PROVEN PER-OBJECT, not inferred from totals: in a
// SINGLE traversal, for every object reached from head N, read that same
// object's LTObject.type and compared it to N.
//   RESULT: 0 mismatches / 3490 objects.
// Because both values come from the same object in the same pass, live
// churn cannot explain the agreement. object_lists[N] holds exactly the
// objects whose .type == N. (Per-list counts in that pass: 914 / 183 /
// 1476 / 221 / 0 / 474 / 222 -- these drift between runs as the game
// creates and destroys objects, which is why the PER-OBJECT check, not the
// totals, is the evidence.)
//
// INVESTIGATED, UNCONFIRMED: an `ObjectMgr` sub-object
// wrapping these lists. The FEAR1/LithTech source drop nests them one level
// deeper -- `CClientMgr::m_ObjectMgr` (clientmgr.h:238),
// `ObjectMgr::m_ObjectLists` (objectmgr.h:90) -- so mirroring that here is
// tempting. Every checkable point of that reference LAYOUT is contradicted
// by FEAR2:
//   1. Reference `ObjectMgr : public WorldTreeHelper` has virtuals
//      (IncFrameCode/GetFrameCode), so ITS offset 0 is a vptr. FEAR2's
//      CClientMgr+0x00 is part of a list head: live it holds the head's OWN
//      address -- a heap value outside the exe image, structurally
//      incompatible with a vptr. (Why it self-points on a POPULATED list --
//      list[0] had 914 entries in that snapshot -- is exactly why the field
//      is still typed `prev` unverified; see CClientMgrListLink.)
//   2. Reference `m_ObjectLists` is the LAST member of ObjectMgr, preceded
//      by m_CurFrameCode, m_InternalLink, 4 StructBanks, 12 ObjectBanks and
//      a bank-pointer array. FEAR2 puts the 7 heads at offset 0, with
//      nothing ahead of them. (What actually follows at +0x38 is not mapped
//      yet -- see the unclaimed span below; it was not matched against the
//      reference's members and no such correspondence is asserted.)
//   3. Reference element type `LTList` is 16 bytes (`m_nElements` + a
//      12-byte `LTLink` carrying `m_pData`). FEAR2's heads are 8 bytes at
//      stride 8 with no count, and its walkers recover the object by
//      `link - 172` (INTRUSIVE) rather than reading `m_pData`. Different
//      list implementation, not just a different offset.
//   4. Every reference `om_*` routine takes an explicit `ObjectMgr*`
//      (om_Init/om_Term/om_CreateObject/om_DestroyObject). The FEAR2 object
//      routines examined here take no manager at all: 0x40CB24 and 0x40D065
//      read the g_pClientMgr global directly, 0x40B52A takes a bare list
//      head, and 0x40B287 takes only the object. 0x40BDC4 is a CClientMgr
//      __thiscall (touches this[1294], this+1285, this+26) that walks the 7
//      lists from `this + 0` inline. (Those five are the walkers/teardown
//      path, not an exhaustive sweep of every object routine.)
// Note (4) is suggestive, not decisive -- an embedded subobject at offset 0
// is layout-INDISTINGUISHABLE from direct fields, so no binary access
// pattern can prove or disprove a purely nominal wrapper. That cuts both
// ways: it cannot be confirmed either, and AGENT.MD rule 9 says FEAR2 is
// ground truth and the source drop is a NAMING hint only. So the lists stay
// declared directly on CClientMgr. Do not re-import this nesting from the
// source drop without FEAR2-side evidence.
//
// unk_68: a container/vector-like object, NOT a plain field. dump 0x44ED89
// uses `g_pClientMgr + 104` as a DROP-IN FALLBACK for `dword_6F3080 + 1064`
// and feeds it to sub_61C92C -- which computes `(this[2] - this[1]) >> 2`,
// i.e. a size() over 4-byte elements -- and to sub_46D362, which is its
// operator[] (`return this[1] + 4*index`, bounds-checked against that same
// size()). So relative to unk_68: +0x04 = begin, +0x08 = end. Live: begin=
// 0x175CA208 end=0x175CA20C, size 1. The DWORD at unk_68+0x00 itself is
// separately read as a BYTE flag by dump 0x40CB42 (`if (this[104])
// { ... } this[104] = 0;` -- a commit-and-clear), and read 0 live.
// Modelled as CClientMgrPtrVector below.
//
// last_sent_bandwidth: CONFIRMED EXACTLY. dump 0x40B562 computes
// `clamp(BandwidthTargetClient / 8000, 0, 0xFFFF)`, compares it against
// this field, and ONLY IF IT CHANGED calls the connection object's vtable
// slot 16 and re-sends -- then stores it back here. The value is written
// into a bit-packed network message (sub_438CE5 is a bitstream writer:
// `this[1] |= (val & mask) << bitpos`) as message id 7 in 4 bits followed
// by this value in 16 bits. dword_6E34E4 is the **BandwidthTargetClient**
// cvar -- proven from the engine's own cvar registration table at
// 0x6E3944 = {name="BandwidthTargetClient", &dword_6E34E4, type 2}.
// Live check: BandwidthTargetClient=256000, /8000 = 32, and this field
// read exactly 32. This is a change-detection cache of the last bandwidth
// value transmitted to the server, NOT a live bandwidth measurement.
//
// unk_4E4: explicitly zeroed inside CClientMgr::Init
// (`*(_DWORD*)(a1+1252)=0`) and observed live holding a heap pointer
// (0x05F30498) -- actively written post-init, role otherwise unverified.
//
// pending_shell_release @0x1438 + what `updating` is FOR: CONFIRMED, and it
// turns `updating` from "a flag we observed" into a mechanism we understand.
// Both halves are visible:
//
//   SET -- dump 0x409DDF (the shell-release path):
//     if (client_shell) {
//         if (updating) { <world/level teardown>; pending_shell_release = client_shell; }
//         else          { (**client_shell)(client_shell, 1); }  // virtual delete now
//         client_shell = 0;
//     }
//
//   CONSUME -- dump 0x40B665 (CClientMgr::Update), immediately after it
//   clears `updating`:
//     updating = 1;
//     CClientShell::Update(client_shell);       // dump 0x40CC5E
//     updating = 0;
//     if (...) sub_409DDF(this);                // may set pending_shell_release
//     if (pending_shell_release) {
//         (**pending_shell_release)(pending_shell_release, 1);  // vtable slot 0, arg 1
//         pending_shell_release = 0;
//     }
//
// So `updating` is a RE-ENTRANCY GUARD: it exists so a shell cannot be
// destroyed while its own Update is on the stack. A release requested from
// inside the update is parked in this field and performed by Update the
// instant the guard drops. The `(ptr)(ptr, 1)` shape is the usual MSVC
// scalar-deleting-destructor call through vtable slot 0.
//
// This also explains why a diagnostic sampling `updating` over IPC sees
// false essentially always: the true window is one CClientShell::Update
// call on the engine thread.
//
// Still identified but NOT mapped (see reversing/MAPPING_WORKFLOW.md --
// don't force a field without confident evidence): an embedded blob @0x90
// passed BY ADDRESS to a global subsystem's (dword_6ECC98) vtable slot 20
// during Init -- size/type/purpose unknown.
//
// Struct size below is a HEADROOM MINIMUM matching the highest mapped
// field + alignment, exactly like DatabaseMgr's own "unconfirmed beyond
// +0x18" note -- do NOT treat 0x1468 as the confirmed total object size,
// only as "safe to reinterpret up to here".
//
// object_banks: CONFIRMED. Six {LTMemoryPool*, element_size} pairs filling the
// 0x38..0x67 span that used to be the largest unmapped hole in this class.
// Each is the fixed-size allocator for ONE object type.
//
// THE INDEX IS NOT THE TYPE. OT_LIGHT (4) has no bank, so the array is
// compacted around it:
//   bank[0] -> type 0 OT_NORMAL         element_size 204  block 208
//   bank[1] -> type 1 OT_MODEL          element_size 408  block 416
//   bank[2] -> type 2 OT_WORLDMODEL     element_size 316  block 320
//   bank[3] -> type 3 OT_SPRITE         element_size 340  block 344
//   bank[4] -> type 5 OT_CAMERA         element_size 320  block 328
//   bank[5] -> type 6 OT_PARTICLESYSTEM element_size 264  block 272
// That OT_LIGHT is skipped is no longer just "consistent with" an empty bucket --
// it is PROVEN UNCREATABLE. CClientMgr_CreateObjectOfType (0x437E2E) switches on
// the requested type byte and has cases for 0,1,2,3,5,6 only; type 4 falls to
// `default: return 0`. So no code path can construct one, which is why its
// object_lists bucket reads 0 entries in every sample and why it needs no bank.
// The switch is also the ground truth for this whole table: each case calls one
// per-type creator (CClientMgr_NewObject_OT_*) whose base ctor identifies the
// class, and the case labels match the reference SDK's enum ordering exactly.
//
// HOW THE MAPPING WAS PROVEN -- three checks, because the obvious one is not
// sufficient on its own:
//   1. Minimum live address spacing per type equals exactly one bank's
//      block_size, and the six values form a bijection with the six types
//      (208/416/320/344/328/272, all distinct).
//   2. NOT sufficient alone: those block sizes are NOT unique across the
//      wider LTMemory pool list -- 4 of the 6 are shared with 1-2 other pools.
//      So spacing alone cannot prove the objects come from THESE pools.
//   3. Membership, which does prove it: each bank's pool->chunk, taken at
//      chunk + 0x10 with block_size stride, contains ONLY objects of its
//      mapped type and none of any other -- 6/6 banks, 0 foreign objects
//      (56/20/15/35/9/55 in-chunk hits respectively). The first slot's own
//      type byte also equals the mapped type, 6/6.
//
// This is also where every object type's allocation size comes from; see the
// LTObject comment for why that pins its size at 0xCC rather than headroom.
class CClientMgr 0x1468 {
    CClientMgrListLink object_lists[7]       @0x00     // CONFIRMED: 7 heads, bucketed by LTObject.type (index == type)
    CClientMgrObjectBank object_banks[6]     @0x38     // CONFIRMED per-object-type pool banks; index != type (OT_LIGHT has none) -- see the class comment
    CClientMgrPtrVector unk_68               @0x68     // CONFIRMED container shape; what it holds is unverified
    void* unk_4E4                            @0x4E4
    CClientMgrListLink counter_list_head     @0x13EC   // CONFIRMED: iterated per-frame by EngineList_ForEach(this+0x13EC) in CClientMgr::Update (dump 0x40B6A3)
    CClientMgrCounterNode* own_counter_node  @0x13F4
    uint32_t last_sample_time_ms             @0x1400   // CONFIRMED milliseconds. CClientMgr::Update computes `sub_409FD0(now - this->last_sample_time_ms)` with now = dump 0x60AAF2 (dump 0x40B6AD/0x40B6C6), and sub_409FD0 divides that delta by exactly 1000.0 (dbl_66E738) to get seconds -- so this field's unit is ms. Live: advanced 1672342 -> 1673346 (delta 1004) across ~1.00s of wall clock, i.e. tracks real time 1:1 and is re-sampled continuously. The instruction that writes it was NOT located in the functions read so far.
    LTObjectHandleTable handle_table         @0x1414   // CONFIRMED the engine's HOBJECT -> object map, indexed directly by LTObject.handle. CClientMgr_RegisterObjectHandle (0x40BEC2) writes {1, obj} at index `handle` during CClientMgr_CreateObject, growing the vector when the handle exceeds its size. Live: 7719 slots of which 3248 are tagged live, and for EVERY object carrying a handle, table[handle].object is that object -- 3248/3248, zero mismatches, all seven buckets. The other 335 objects hold handle 0xFFFF, exactly the same 335 that hold slot_index 0xFFFFFFFF. This is how a mod turns an HOBJECT from any ILT* call back into an object, and why no module global holds an object pointer: the engine passes indices, not addresses.
    float unk_1424                           @0x1424   // unverified float. Live: advances while the engine runs, but NOT by whole numbers and NOT at a fixed rate -- observed +168.000 over ~1.0s in one sample and +21.987 over ~2.0s in another. RETRACTED HYPOTHESIS: dump 0x409FD0 does `*(float*)(<ecx>+0x1424) += 1.0` (dbl_66EDF0 == 1.0), and this field was briefly named frame_counter on that basis. That was WRONG: the decompiler never established that 0x409FD0's ecx is CClientMgr, and the non-integral live deltas here disprove it -- either that function operates on a different object, or something else writes this field. Offset/type are sound (read as a float that changes); the meaning is not.
    LTConVarTable console_vars               @0xC0     // CONFIRMED the CONSOLE VARIABLE table (see LTConVarTable): CLTClient_GetSConValueFloat and GetSConValueString both pass `g_pClientMgr + 0xC0` to ConVarTable_Find, which adds 0x24 to reach the 128 buckets. Live 192 entries. The class size ends at 0x4E4, exactly where unk_4E4 begins -- so the span is pinned by adjacency at both ends rather than assumed.
    uint16_t last_sent_bandwidth             @0x1430   // CONFIRMED == clamp(BandwidthTargetClient/8000, 0, 0xFFFF); live 256000/8000 == 32 == field
    CClientShell* client_shell               @0x1434   // CONFIRMED the client shell instance; 25 functions reach it through this displacement and its small accessors are what mapped the class (see CClientShell). Live 0x5F87030 with vtable 0x66F9E8.
    void* pending_shell_release              @0x1438   // CONFIRMED deferred-destruction slot; see the class comment. Set only when `updating`, consumed at the end of CClientMgr::Update.
    bool updating                            @0x143C
    CClientMgrListLink start_shell_list      @0x1460
}

// ---- The per-type cull-volume interface (object vtable slot 2) -------------
//
// LTObjectOwner_UpdateSpatialRecord asks each object for its culling volume
// through vtable slot 2, and dispatches on the RETURN VALUE:
//   0 = no volume -> LTSpatialRecord_Release (the object leaves the index)
//   1 = sphere    -> out[0..2] = centre, out[3] = radius
//   2 = AABB      -> out[0..2] = min,    out[3..5] = max
// The AABB form is written by LTMath_WriteAABB (0x40DD51), a plain 6-float
// copy, which is what pins the out-buffer layout.
//
// Per type, live:
//   OT_NORMAL          returns 0 unconditionally -- these objects are NEVER in
//                      the spatial index (OT_NORMAL_GetCullVolume is `return 0`)
//   OT_MODEL           1, from vis_radius * LTObject.scale (see LTModelObject)
//   OT_WORLDMODEL      2, straight from LTObject.aabb_min / aabb_max
//   OT_CAMERA          2, same shared body as OT_WORLDMODEL
//   OT_SPRITE          2 when its kind byte @0x106 is 3/4/7/9, else 1
//   OT_PARTICLESYSTEM  returns its own mode byte (see LTParticleSystemObject)
//
// The shared OT_WORLDMODEL/OT_CAMERA body also returns 0 when the byte at
// LTObject.flags3's low end has bit 0x80 set. The code is `if ((char)this[70] <
// 0) return 0` -- a SIGNED BYTE test, so the mask is 0x80, NOT 0x8000 as an
// earlier draft of this comment said. That draft went on to call the path
// unexercised, having looked for the wrong bit.
//
// It IS exercised, by exactly one object: the level geometry (flags3 == 0x490,
// handle == 0xFFFF, slot_index == -1, dims of (13375, 9149, 10200) spanning the
// whole map). Its spatial_record volume is all zeros while every other
// OT_WORLDMODEL's holds a real AABB -- so the single live exception to the
// record mapping is explained by this gate rather than left as residue.

// One entry of a model's animation-name lookup table. Sorted by hash, because
// LTModelAsset_FindAnimByName (0x424A48) BINARY SEARCHES it -- which makes the
// ordering a functional requirement rather than an incidental property: if it
// stopped holding, the engine's own lookups would start missing silently.
class LTAnimNameEntry 0x8 {
    uint32_t name_hash  @0x00   // CONFIRMED String_HashI of the animation's name. Live, all 42 entries of a character asset matched hashes of strings harvested from its own string_blob -- 42/42 -- which both identifies the table and confirms the hash function on a SECOND, independent name population (the first was skeleton node names).
    uint32_t value      @0x04   // the paired value the search returns; used to index back into this same table (`return table[table[hit].value].value`), so the table is chained rather than a plain map. Role unmapped.
}

// MSVC std::vector over 8-byte elements, same _SECURE_SCL shape as StdString: a
// proxy pointer ahead of first/last/end. The element size is not assumed -- the
// engine's own size helper is `(last - first) >> 3` (StdVector8_Size) and its
// indexer is `first + 8 * i` (StdVector8_At).
class LTAnimNameTable 0x10 {
    void* proxy                @0x00
    LTAnimNameEntry* first     @0x04
    LTAnimNameEntry* last      @0x08
    LTAnimNameEntry* end_cap   @0x0C
}

// ---- The ANIMATION RECORD table: index -> record -> NAME ---------------------
//
// An asset carries TWO animation tables and they are complementary, not redundant:
// LTAnimNameTable at +0x6C is sorted by name hash for LOOKUP BY NAME, and this one at
// +0x5C is indexed directly for LOOKUP BY INDEX. Their entry counts agree on 34/34
// live assets, so they describe the same animation set from two directions -- which
// also settles that the count taken from the name table is the correct bound for an
// index into this vector (verified: the current index is inside it on 215/215).
//
// Read straight out of ILTModel_GetAnimName:
//   v4 = asset + 92;                                   // +0x5C
//   if (index < StdVector8_Size(v4)) {
//       rec = *(void**)(StdVector8_At(v4, index) + 4);  // slot+0x04 -> the record
//       if (rec) copy(dst, *(char**)(rec + 32), cap);   // record+0x20 -> the NAME
//   }
//
// Live this resolves the animations models are ACTUALLY PLAYING: base (x128), World,
// World_Physics, Ragdoll, PostFire, Corpse_surface_faceup, Alma_Stand_Searching,
// ghostChild_Stand4. Counts run 1..1039 per asset -- 1 for a shell casing, 34 for an
// assault rifle, 846 for a grunt.
//
// CAUTION ON THE ENGINE'S OWN LOGGING: GetAnimName's not-found path logs the string
// "GetNodeName", which is a copy-paste bug in the shipped binary. The error-string
// naming technique is excellent and this is its failure mode -- a function can name
// somebody else. Trust the identification here because the CODE reads an animation
// table, not because of what it prints.
class LTAnimRecord 0x24 {
    char* name @0x20   // CONFIRMED the animation's name, from GetAnimName's own `*(char**)(rec + 32)`. Live it yields real animation names on 214 of 215 models. Everything below +0x20 is unmapped -- this class is deliberately a partial view of a record whose true size is unknown.
}

// One slot of the record vector: 8 bytes, of which the engine only ever reads the
// second dword.
class LTAnimRecordSlot 0x8 {
    uint32_t unk_00        @0x00   // never read by GetAnimName; unmapped
    LTAnimRecord* record   @0x04   // CONFIRMED: the slot field GetAnimName dereferences, and it null-checks it before use, so a null record is a real state
}

// The vector itself -- MSVC's std::vector shape, same as LTAnimNameTable's.
class LTAnimRecordTable 0x10 {
    void* proxy               @0x00
    LTAnimRecordSlot* first   @0x04   // CONFIRMED the data pointer: StdVector8_At returns `this[1] + 8*i`
    LTAnimRecordSlot* last    @0x08   // CONFIRMED the end pointer: StdVector8_Size is `(this[2] - this[1]) >> 3`
    LTAnimRecordSlot* end_cap @0x0C
}

// One skeleton node. 64 bytes, and the size is pinned from both ends: the reader
// strides by 64 (`this + 64 * i`) and the two transform pairs below end at exactly
// 0x40. Written by LTModelAsset_ReadNodeTree (0x4261B0), a recursive descent that
// passes 255 as the root's parent.
//
// The tree is stored as an array in TOPOLOGICAL ORDER, which is worth stating
// because it makes traversal trivial: a parent always precedes its children, so a
// single forward pass can accumulate world transforms without recursion. Live,
// across 34 assets and 660 nodes: node[0].parent is 255 on 34/34, own_index equals
// the array index on 34/34, every non-root parent index is LESS than its own index
// on 34/34, and sum(child_count) == node_count - 1 on 34/34 -- which is the
// defining property of a tree with one root and no cycles.
//
// BOTH POSES ARE NAMED BY THEIR READERS, and +0x08's DIRECTION is now settled too.
//
// ILTModel_GetBindPoseNodeTransform (0x42C958) does exactly two things: LTTransform_Copy from
// `node_records + (index << 6) + 8` -- this pair -- and then LTTransform_InvertInPlace (0x41DB20)
// on the result, which conjugates the rotation (LTRotation_Conjugate, 0x41DAB6, negating x/y/z
// and keeping w) and replaces the position with -(conjugate * position).
//
// So the engine RETURNS the inverse of what is STORED here, and which of the two is "the bind
// pose" comes from the binary rather than from the reference: that function pushes the literal
// 'ILTModel::GetBindPoseNodeTransform' for its own error report. The value it returns is the bind
// pose; therefore THIS RECORD STORES THE INVERSE-BIND TRANSFORM -- the inverse bind matrix that
// skinning consumes, which is exactly what a model file would keep. LithTech's reference
// implementing the same-named method as `mat = pNode->GetGlobalTransform()` agrees.
//
// That closes a question this file carried for several passes as "the bind pose's coordinate space
// is still open", and it was closed by reading the READER, not by measuring the values again. Four
// separate experiments on the values had failed to settle it; none of them needed to.
//
// The other pair, +0x24, is the ANIMATION FALLBACK that LTModelObject_EvaluateSkeleton substitutes
// for a node whose animation index is 0xFF. Still a genuinely different pose from +0x08, not one
// pose in two spaces: composing +0x24 from the root reproduces +0x08 on only 268 of 2196 nodes --
// about one per skeleton, i.e. the roots where composition is the identity.
//
// VERIFIED AGAINST THE ENGINE: sdk::ModelSkeleton::bind_pose() applies that same inversion to this
// stored pair, and agreed with a live vt[22] call on 1994 of 1994 nodes, worst combined error
// 0.0058 (float precision, not a discrepancy in kind).
class LTModelNode 0x40 {
    uint8_t parent_index   @0x00   // CONFIRMED: 255 on the root (the reader's sentinel), and always < own_index otherwise, on 34/34 assets
    uint8_t unk_01         @0x01
    uint8_t own_index      @0x02   // CONFIRMED == this node's index in the array, on all 660 live nodes
    uint8_t first_child_offset @0x03 // CONFIRMED by a READER: LTModelObject_GetNodeChildIndex (0x429066) resolves a child as `nodes[i + nodes[i].first_child_offset + ordinal]`, so a node's children are a CONTIGUOUS BLOCK starting this many slots after it. The reader writes it as (next free index - own index), which is exactly that distance. Live, across 626 child links in 34 assets: the block [i+off, i+off+child_count) stays inside the array 34/34, every node in it names i as its parent 34/34, and each one's own_index matches its slot 34/34. Contiguity is what lets the engine walk children without a per-node child list.
    uint8_t child_count    @0x04   // CONFIRMED: the reader stores the low byte of a dword read from the file, and live the counts sum to node_count - 1 on 34/34 -- one root, no cycles. Paired with first_child_offset it fully describes the child set, and the recursive walk at 0x4290A8 uses exactly that pair.
    uint8_t unk_05         @0x05   // CONFIRMED read as a single byte straight from the file
    uint16_t unk_06        @0x06
    LTVector inverse_bind_position @0x08   // CONFIRMED THE INVERSE-BIND TRANSFORM'S position, by its own reader: ILTModel_GetBindPoseNodeTransform (0x42C958) copies `(node_index << 6) + asset->node_records + 8` -- stride 0x40, offset +0x08, i.e. exactly this pair -- and then INVERTS it (LTTransform_InvertInPlace). So what the engine hands out is the inverse of this, and since that getter's own error string names it GetBindPoseNodeTransform, the RETURNED value is the bind pose and this is its inverse. Being ASSET data it is staleness-free and identical on every instance of the model, unlike the per-object node caches. CONFIRMED finite on 660/660.
    LTRotation inverse_bind_rotation @0x14 // CONFIRMED the second half of the pair ILTModel_GetBindPoseNodeTransform reads and inverts; the engine returns its CONJUGATE. CONFIRMED unit-length on 660/660, so a real quaternion -- which also means the conjugate is a true inverse rather than merely a transpose-like approximation.
    LTVector anim_fallback_position @0x24 // CONFIRMED A LOCAL, PARENT-RELATIVE POSITION BY THE SKELETON EVALUATOR ITSELF. LTModelObject_EvaluateSkeleton (0x428670) is what fills the per-node cache, and per node it takes the local position from the animation buffer or, when that node has no animation (its anim index is 0xFF), from `node_records + (index << 6) + 36` -- this field -- then composes it onto THE PARENT'S ALREADY-CACHED TRANSFORM via LTTransform_ComposeIntoIdentity and stores the result at cache stride 28. So the field is local, the cache is a composed space, and both facts come from the producer rather than from a query. Also found by its other reader: ILTModel_GetAnimNodeTransform (0x42C9CF) walks the parent chain and for each node takes `node_records + (index << 6) + 36` -- exactly this pair -- whenever that node has no animation mapping (its anim node index is 0xFF) or there is no animation state at all; otherwise it evaluates the animation instead. So +0x08 is what the bind-pose getter hands out and +0x24 is what animation composition falls back to. That the same function walks UP the parent chain establishes THIS pair is PARENT-RELATIVE, and the per-step rule is READ rather than inferred from the loop: LTTransform_ComposeIntoIdentity (0x424FF0) initialises the output rotation to identity and calls LTTransform_Compose (0x424CEB), which is `out.rot = LTRotation_Multiply(parent.rot, child.rot)` and `out.pos = LTVector_Add(LTRotation_RotateVector(parent.rot, child.pos), parent.pos)` -- the standard parent-to-child composition. The identity-zeroing momentarily looked like evidence against a plain compose and is merely output initialisation. Note this says nothing about the bind-pose getter reads a single node and composes nothing, so it evidences nothing about +0x08's space. CONFIRMED finite and sane on 660/660, and NOT the inverse of the bind pose -- see the class comment.
    LTRotation anim_getter_rotation @0x30 // NAMED AFTER ITS ONLY EVIDENCE, not after a role. Calling it a fallback rotation would assert what the producer refutes: LTModelObject_EvaluateSkeleton, the function that fills the node cache, sources local rotations from g_AnimEval_NodeLocalRotations for EVERY node whether animated or not, and never reads this. The one function that does read it is ILTModel_GetAnimNodeTransform, which copies the whole 7-float pair out with LTTransform_Copy -- so all that is established is that a secondary getter hands it to callers. ILTModel_GetAnimNodeTransform copies the WHOLE pair out with LTTransform_Copy (position and rotation, 7 floats). LTModelObject_EvaluateSkeleton takes ONLY THE POSITION from here and sources the rotation from g_AnimEval_NodeLocalRotations regardless of whether the node has animation. So on the evaluator's path this rotation is not read at all, and its role rests on the one reader that does use it. NOTE THIS ALSO EXPLAINS A FAILED EXPERIMENT recorded above: composing the full (position, rotation) pair down the hierarchy does not reproduce the bind pose, and the reason is that the engine does not treat this rotation as the node's local rotation at all on its main path. CONFIRMED unit-length on 660/660. Ends at 0x40 == the record stride. CONFIRMED unit-length on 660/660. Ends at 0x40 == the record stride.
}

// A SHARED model asset record. Live, 215 OT_MODEL objects point at only 34
// distinct instances of this, and never at null (215/215) -- so it is per-ASSET,
// not per-instance, which is what makes the asset field a resource handle rather
// than an owned sub-object.
//
// SIZE IS NOW PROVEN, and the previous reasoning about it was wrong in an
// instructive way. LTModelAsset_FindOrLoad (0x425D7E) allocates it with
// `LTMem_Alloc(0xA0)`, so the class is 160 bytes -- and LTModelAsset_ctor
// (0x425AC6) corroborates from the other side: the last field it writes is the
// dword at 0x9C, ending exactly at 0xA0.
//
// The rejected inference is worth keeping. Live, the 34 asset addresses are all
// separated by exact multiples of 0xC8, with 0xC8 the minimum -- which by the
// argument that worked for CClientMgr.object_banks would make the class 0xC8.
// It does not: these come from a GENERAL HEAP, not a fixed-size bank, so the
// spacing is only an upper bound. A "the tail 0xA0..0xC8 is all zero" check
// seemed to support 0xA0-ish too, but that held on the one asset first sampled
// and on 0 of 34 overall -- those bytes belong to the next allocation.
//
// THE .mdl FILE FORMAT, from LTModelAsset_LoadFromFile's first two reads: a
// magic dword 0x4C444D4C ("LMDL") followed by a version that must be exactly
// 42. Both are hard rejects, so any file that loads at all has them.
//
// The loader is also what filled this class in. Its writes name most of the
// fields below, and it supersedes an earlier REJECTED guess worth keeping: the
// fields after +0x04 looked like (pointer, count) array descriptors at
// +0x04/+0x0C/+0x14/+0x1C. Across all 34 assets only 69 of 136 had both a
// heap-shaped pointer and a plausible count, and the dword at +0x08 reads 0 on 14
// assets, 1 on 10 and 11 on 10. Not an array header. The real array pair sits at
// +0x24/+0x28 with its count at +0x20 -- close to where the guess was looking,
// which is exactly why guessing from shape was not good enough.
// ---- A LEAD, NOT A MAPPING: the per-node TRANSFORM arrays -------------------
//
// LTModelObject_GetNodeTransform (0x429D66) is the function every socket transform
// ultimately goes through, and it reveals two parallel per-node arrays on the MODEL
// object (not the asset) that are not yet in this schema. Recorded so the next pass
// starts from the code rather than from another stride scan:
//
//   if (index >= asset->node_count) -> fail            // it bounds-checks the asset
//   if (*(uint16_t*)(model + 0x156)) {                 // a mode selector
//       ... *(uint8_t*)(*(void**)(model + 0x140) + 3*index + 1)   // 3 bytes per node
//       ... transform at  *(void**)(model + 0x144) + 28*index     // 28 bytes per node
//   } else {
//       ... *(uint8_t*)(*(void**)(model + 0x124) + 2*index)       // 2 bytes per node
//       ... transform at  *(void**)(model + 0x128) + 28*index     // 28 bytes per node
//   }
//
// 28 bytes is LTVector + LTRotation, i.e. a position/rotation pair per node -- which
// is what an earlier pass went hunting for with stride scans and did not pin down.
// Note there are TWO of them behind a selector, and TWO companion byte arrays with
// DIFFERENT strides (3 and 2), so "the node transform cache" is not one array and a
// scan that assumed it was could not have found this shape. Nothing here is asserted
// yet: the offsets come from the decompiler and have not been read live.
//
// One SOCKET on a model asset: a NAMED, oriented attach point hanging off a skeleton
// node. This is the most directly useful table yet mapped for a VR mod, because the
// game's own art already defines the points a VR implementation needs.
//
// Found from the engine's own lookup, LTModelAsset_FindSocketByName (0x424BBC):
//   if (!asset[34]) return 0;                    // asset+0x88 = count
//   for (i = 0; ; i += 40) {                     // stride 0x28
//       rec = asset[33] + i;                     // asset+0x84 = array
//       if (String_EqualsI(*(char**)(rec + 32), wanted)) break;   // rec+0x20 = name
//       if (++index >= asset[34]) return 0;
//   }
// so the array base, the count, the stride and the name offset all come from one
// function rather than from pattern-matching bytes.
//
// Live: 186 sockets across all 34 assets, every one with a non-empty name, and every
// one naming a node index inside its own asset's node_count (186/186).
//
// WHAT THE ART ACTUALLY DEFINES, which is why this matters: a character asset carries
//   camera -> Head          socket_left_eye -> Head    socket_right_eye -> Head
//   eyes   -> Head          LeftHand -> L_Hand         RightHand -> R_Hand
//   head, nose, chin -> Head    back -> Upper_Torso    LeftFoot/RightFoot -> L/R_Foot
// and a weapon asset carries flash, breach, laser, physics, flashlight -> its own
// offset node. Several passes were spent hunting the view camera by heuristic; the
// asset names one.
//
// AND THE PLAYER'S OWN TABLE, which is not the same and is the one a VR mod needs.
// `char\player\player\fp_playerm05.mdl`, 65 nodes / 19 sockets -- the widest in the
// sample -- routes its view socket to a DEDICATED bone rather than to the head:
//
//   camera            -> node 64  Eye_Cam        <- exists only for the view
//   cameraDEAD        -> node 13  Head           <- the death camera
//   eyes/head/nose/chin -> node 13 Head
//   LeftHand          -> node 18  L_Hand
//   RightHand         -> node 38  R_Hand
//   Light             -> node 18  L_Hand         <- the flashlight mount
//   back              -> node 9   Upper_Torso
//   Torso_Forward     -> node 5   Torso_Base
//   Align, Attach     -> node 4   attach
//   LeftFoot/RightFoot, *FootScissor, RightFootIdleKick -> L/R_Foot
//   RightElbow        -> node 39  R_Arml_Ulna
//
// A generic character asset points `camera` at Head instead (and carries
// socket_left_eye / socket_right_eye, which the player's table does NOT). So "the
// camera socket lives on the head bone" is true of NPCs and false of the player.
//
// THE PART THAT DECIDES WHAT IS USABLE: at rest only 13 of the player's 65 bones are
// clean. The HANDS are among them -- LeftHand/RightHand/Light/back/Torso_Forward all
// read live -- while camera/Eye_Cam and every Head-based socket read STALE, because the
// engine recomputes the view bones inside its render path. Measured, not assumed. A mod
// wanting hand anchors can read them from any thread today; a mod wanting the eye must
// either hook the render path or force the recompute.
class LTModelSocket 0x28 {
    LTVector position     @0x00   // CONFIRMED the socket's offset from its node, and live these are real art values, not zeroes: socket_left_eye sits at (-3.013, 13.745, 2.784) and camera at (-4.251, 13.156, 0.000) on the same Head node. // AND IT IS ASSET DATA, WHICH MAKES IT THE ONLY STALENESS-FREE SOURCE OF SOCKET GEOMETRY: unlike the bone caches these offsets need no evaluation and are identical on every instance, so eye/camera relationships can be measured without touching the engine (see sdk::ModelSkeleton::eye_geometry). Measured over the 30 live rigs carrying both eye sockets: all 30 hang both eyes AND the camera socket off ONE node, which is what makes subtracting their offsets meaningful. But the art is not tidy -- separation ranges 0.000..5.537 (at least one rig puts both eyes at the SAME point), only 8 of 30 have the eyes level in y and z, `socket_left_eye` is on the -x side in just 22 of 30, and |left.x + right.x| reaches 6.013, so they are not mirrored about the node origin either. Three plausible invariants, all refuted; the numbers are recorded rather than asserted.
    LTRotation rotation   @0x0C   // CONFIRMED a UNIT quaternion: |q| == 1.00000 on the records sampled. camera's is (0.5002, -0.4998, -0.5002, -0.4998), i.e. a coordinate-frame flip rather than an identity -- which is what a camera attach point needs and what makes it clear the field is a real orientation and not padding.
    float scale           @0x1C   // CONFIRMED a SCALE, and not by the live 1.0 alone -- that would be a guess. The engine's node-transform getter fills a 0x20-byte output struct whose layout it spells out on its failure path: zeroes at +0x00..+0x14, then 1.0 at +0x18 (the quaternion's w) AND 1.0 at +0x1C. A unit written beside an identity rotation is a scale, and a socket's leading 0x20 bytes are exactly that struct -- which is why this field is where it is.
    char* name            @0x20   // CONFIRMED the socket's name, from the lookup's own String_EqualsI comparison against this offset. Live all 186 are non-empty.
    uint32_t node_index   @0x24   // CONFIRMED the skeleton node the socket hangs off: LTModelObject_GetSocketTransform reads `*(rec + 36)` and passes it to LTModelObject_GetNodeTransform. Live inside node_count on 186/186, and resolving it through node_names gives the pairings above.
}

class LTModelAsset 0xA0 {
    float radius        @0x00   // CONFIRMED: OT_MODEL_GetCullVolume reads it as `**(float**)(obj+0xEC)` for its sphere radius. Live values are round -- 10, 20, 25, 50, 100, 120, 200, 240, 300 -- and equal LTModelObject.vis_radius on 215/215 objects, i.e. that per-object field is a CACHE of this one. The ctor writes 0.0; the real value is read from the file into radius_from_file below.
    uint32_t region_count_a  @0x08   // CONFIRMED a count, from the allocation side: LTModelAsset_RegionSize_31xNodes computes `31*node_count + 4*(asset+0x08 + asset+0x10)`, so both of these scale a 4-byte-per-element region inside the model's per-object block. Live they track model complexity -- 11 and 10 on a 61-node character, 0 and 0 on a 2-node shell casing. WHAT they count is unmapped; that they ARE counts is proven, because reconstructing BindAsset's size with them puts every carved pointer inside the result on 215/215 models.
    uint32_t region_count_b  @0x10   // CONFIRMED a count, same expression and same evidence as region_count_a.
    LTModelNode* node_records @0x1C   // CONFIRMED the SKELETON NODE ARRAY: node_count records of 64 bytes, inside string_blob (34/34). Found by fingerprint rather than by a writer -- LTModelAsset_ReadNodeTree strides by 64 and stores each node's own index at byte +2, so searching the blob for a stride/base where byte[base + 64*i + 2] == i for every i landed on exactly one place, and the asset field holding that base is this one. The parent/child bytes then validated as a real tree (see LTModelNode).
    uint32_t node_count      @0x20   // CONFIRMED the SKELETON NODE COUNT. Found by arithmetic first -- the two arrays below sit end to end, so (b - a) / 4 is the count, and searching every field of all 34 assets for a match returned exactly this and 0x40, each 34/34 -- then PROVEN by reading what the arrays hold: node_names has exactly this many entries and they are bone names. Live 2..84: 2 for a shell casing, 61 and 84 for characters.
    char** node_names        @0x24   // CONFIRMED an array of node_count char* INSIDE string_blob, holding the model's SKELETON NODE NAMES. LTModelAsset_ReadNodeTree (0x4261B0) is a recursive tree reader that writes `names[index] = name_ptr` per node, with 255 passed as the root's parent sentinel. Live all 660 names across 34 assets are blob-internal and printable, e.g. Pelvis, Torso_Base, Upper_Torso, Neck, Head, L_Shoulder, L_Hand, L_Thumb0, L_Index0, Face_Jaw, aimer, attach. 11 of 34 assets have a "Head" node and 12 have a hand node. This is the field a mod uses to locate a bone by name.
    uint32_t* node_hashes    @0x28   // CONFIRMED a parallel array of node_count CASE-INSENSITIVE NAME HASHES, written by the same reader as `hashes[index] = String_HashI(name_ptr)`. The hash is `h = 0; while (*s) h = g_HashCharTable[*s++] + 919 * h;` (String_HashI, 0x4051C0; the 256-byte table is g_HashCharTable at 0x66E3D8 and is NOT identity or tolower but a custom alphabet remap that folds case). Reimplemented against live data it reproduces all 660 stored values exactly, and hash("Head") == hash("head") == hash("HEAD"). NO standard hash matched first -- FNV-1/1a, djb2, djb2-xor, sdbm and CRC32 over three case foldings scored 0 of 660 -- so this was settled by reading the writer, not by guessing.
    void* container_3C     @0x3C   // the loader uses `this + 0x3C` as a container it pushes an entry into per header item (0x628EA2, twice per iteration). Shape unmapped.
    uint32_t node_count_dup @0x40  // CONFIRMED equal to node_count on 34/34 -- found by the same arithmetic search, which returned both offsets. Which the engine treats as authoritative is unknown; they simply agree.
    void* self_ref         @0x48   // CONFIRMED live on 34/34: holds the asset's OWN address. The ctor zeroes it, so the loader writes it. A free integrity check -- see sdk::CClientMgr::check_model_assets.
    uint16_t unk_50        @0x50   // ctor writes 0
    uint16_t unk_52        @0x52   // ctor writes 1
    char** piece_names   @0x2C   // CONFIRMED the model's PIECE NAME array, from ILTModel_GetPieceName: it bounds the index with `*(asset + 48)` and reads `*(char**)(*(asset + 44) + 4*index)`. Live the names are real and meaningful -- Face, body_shadow, Clip_Group, Assault_Group, SMG_Group, Granade -- which is what makes a piece addressable by name rather than by number.
    uint32_t piece_count @0x30   // CONFIRMED the PIECE count, that same function's bound. // IT IS NOT material_count, and conflating the two was a real bug: the counts DIFFER on 17 of 34 live assets (assaultrifle 8 pieces / 7 materials, submachinegun 10 / 6, a grunt 7 / 3, atc_regular 7 / 3, grenade 2 / 1). Pieces are the addressable sub-objects; materials are what they render with, and several pieces can share one. Anything bounding a piece index MUST use this field -- an earlier version of the SDK's piece-visibility accessor used material_count and would have refused four of the grunt's seven pieces.
    LTAnimNameTable anim_names @0x6C   // CONFIRMED the model's ANIMATION-NAME lookup table (see LTAnimNameTable). Identified by hashing every string in the asset's own string_blob and intersecting: all 42 entries of a character asset matched, and the names are animations -- ATC_Corpse1_LOOP, Corpse_Drag, Corpse_surface_faceup, Corpse_edge_facedown_Hit. Live the hashes are ASCENDING on 34/34, which they must be, since LTModelAsset_FindAnimByName binary-searches them. Note the count is NOT node_count (42 against 61 nodes here), which is what first showed the table is about animations and not the skeleton.
    uint16_t material_count @0x54  // CONFIRMED the asset's MATERIAL count -- the number of .mat paths it renders with -- and the value every model's material_count is set from: equal on 215/215 live. Found from the allocation side: LTModelObject_BindAsset sizes one of its regions as `28 * asset->unk_54`, and 28 is sizeof(std::string) here, so the term is an array of that many material paths. Read as a WORD from the file behind a byte flag. Live 1..8, and 8 on the player's viewmodel. // NOT THE PIECE COUNT. An earlier version of this comment called it "the MATERIAL (piece) count", which is wrong and propagated into the SDK: piece_count at +0x30 is a separate, usually LARGER number (they differ on 17 of 34 assets). Materials are what pieces render with, not the pieces themselves.
    LTAnimRecordTable anim_records @0x5C   // CONFIRMED the ANIMATION RECORD VECTOR, indexed by animation index (see LTAnimRecordTable). ILTModel_GetAnimName reads `asset + 92`, bounds the index with StdVector8_Size, takes `slot + 4` and copies the string at `record + 32`. An earlier note called this "a sub-object starts here, unmapped" -- it was spotted because the loader finalises it through 0x458894, which turns out to BE StdVector8_Size. Live its entry count equals the name table's on 34/34 assets, so the two tables cover the same animation set by index and by hash respectively.
    LTModelSocket* sockets @0x84   // CONFIRMED the socket ARRAY, from LTModelAsset_FindSocketByName's `asset[33] + 40*i` walk. Live non-null on every asset that reports a count, and walking it yields 186 named sockets across the 34 live assets.
    uint32_t socket_count  @0x88   // CONFIRMED the socket count, the loop bound in that same function (`if (++index >= asset[34]) return 0`) and the split point of the engine's UNIFIED socket/node index space: LTModelObject_GetSocketTransform does `if (index >= socket_count) return GetNodeTransform(index - socket_count, ...)`, so a caller's "socket handle" addresses sockets first and then skeleton nodes. Live range 0..19 over 34 distinct assets, 186 sockets total. An earlier note here said "1..15" -- WRONG AT BOTH ENDS, and the low end is the one that matters: MOST assets have ZERO sockets (every shell casing, wood-debris chunk, medkit, armour pickup and collectible in the sample), because a prop has nothing to attach. Code that treats a zero count or a failed name lookup as an error is wrong; it is the common case. The widest is `char\player\player\fp_playerm05.mdl` at 19 -- see LTModelSocket for the player's own table. It is NOT the only asset with a `camera` socket (the fixture counts 32 objects carrying one); it is the only one that routes it to a bone other than Head.
    uint32_t refcount      @0x7C   // CONFIRMED the refcount, from TWO sites: LTModelAsset_FindOrLoad does `++asset[31]` (0x7C) before handing a fresh asset out, and LTModelAsset_FindCached does `++*(hit + 124)` on a cache hit -- same offset, two independent paths. The ctor zeroes it. The ONLY thing asserted is refcount >= the number of models referencing the asset (34/34). A tidier shape does NOT survive counting: refcount == 2*users + 1 fits 27 of 34, but 6 assets fall BELOW that and 1 above -- and below refutes a per-model floor outright. Eyeballing the ten biggest rows made it look exact; counting all 34 did not.
    float radius_from_file @0x80   // CONFIRMED read directly out of the .mdl: the loader does `stream->Read(this + 128, 4)`. Equal to `radius` on 34/34, so radius is a working copy of this one -- and that PROVENANCE is what the earlier "radius_dup, a second copy" note was missing.
    uint32_t string_blob_size @0x90 // CONFIRMED the size passed to LTMem_Alloc for string_blob, computed by LTModelAsset_ComputeBlobSize before the allocation. Live 336..19496, scaling with model complexity.
    void* string_blob      @0x98   // CONFIRMED an OWNED allocation of string_blob_size bytes holding the model's strings: the loader allocates it, stores it here, and copies the source filename to its FRONT. Everything else it fills -- the name table, the pointer array whose entries are fixed up from file offsets, entry_array_a and entry_array_b -- lives inside this one block, which is what makes the containment checks meaningful.
    char* filename         @0x9C   // CONFIRMED the model's .mdl PATH and the engine's own cache KEY: LTModelAsset_FindCached and LTModelObject_LoadModelAndSkins both `_stricmp` a requested path against THIS field (`*(asset + 156)`), so lookups are case-insensitive. It points at string_blob + 0 because the loader copies the name to the blob's front, which is why it equals string_blob on 34/34. An earlier note called 0x98/0x9C "filename and a second copy"; they are the blob base and a pointer into it. Live all 34 decode as printable NUL-terminated ASCII. Ends at 0xA0 == the class size.
}

// The record a model keeps its asset reference in. Constructed by 0x4297CF,
// which is called on LTModelObject+0xCC, and the model then LINKS IT INTO ITS
// OWN list (see LTModelObject.list_head). So the embedded one is the model's
// first list member, always present.
//
// This is why `asset` lives HERE and not on LTModelObject: the record's ctor
// zeroes its own +0x20, and LTModelObject+0xCC + 0x20 == +0xEC, which is the
// pointer OT_MODEL_GetCullVolume dereferences. The offset was right all along;
// the OWNER was wrong. Same error class as the transform pair on LTCameraObject,
// and again a constructor is what settled it.
//
// CONFIRMED that the extra list members are records of this same shape: across
// 215 models the lists hold 289 members (74 of them not the embedded one), and
// EVERY member's +0x20 is non-null AND equal to its owning model's asset --
// 289/289. So a model's members all bind the one asset. WHY a model wants
// several such records is unmapped; naming it after the reference SDK's
// animation tracker would be a guess, and the reference tree here has no
// ModelInstance header to check against, so the name stays structural.
class LTModelRecord 0x34 {
    CClientMgrListLink link  @0x00   // CONFIRMED: self-pointed by this ctor, then linked into the owning model's list_head by OT_MODEL_ctor, which is the write that takes list_count to 1
    void* self_ref           @0x08   // CONFIRMED the LIST-WALK RECOVERY POINTER, which an earlier note guessed was "probably the tail/head pointer of an inner list, unmapped". It is not: LTModelObject_FindTrackerById walks the owning model's list from +0x100 and recovers each record as `link[2]`, i.e. exactly this field at link + 0x08. Same device as LTObject.self at +0x84 -- a walker holding a bare link needs a way back to the object. The ctor writes `this` and live it still does on 215/215.
    uint8_t tracker_id       @0x18   // CONFIRMED the TRACKER ID a caller names this record by: LTModelObject_FindTrackerById walks the model's record list and returns the first whose `*(uint8_t*)(rec + 24)` equals its argument, and ILTModel_GetCurAnim is exactly that lookup followed by a read of current_anim. Live the EMBEDDED record is 255 on 215/215 -- so 255 is the main track -- while the 74 non-embedded records carry small distinct ids (22, 23, 24, 27, 28, 31, 32, 33). What selects a given id is unmapped.
    uint8_t anim_flags       @0x19   // CONFIRMED the byte ILTModel_GetPlaying keys on: its whole body is `return ((*(uint8_t*)(tracker + 25) & 1) == 0) | 0x56`, so BIT 0 is the playing/stopped state as the engine reports it. WHICH POLARITY IS WHICH IS NOT ESTABLISHED -- the function returns 0x56 when the bit is set and 0x57 when clear, both LTRESULT codes in the LT_YES/LT_NO family, and the reference tree available here uses those names without defining their values. Live the byte takes 0x00, 0x01, 0x02, 0x03, 0x10, 0x11, 0x12, 0x13 -- so bits 0, 1 and 4 are all in use and only bit 0 has a known reader. Bit 0 set on 99 of 215.
    uint32_t anim_time       @0x1C   // CONFIRMED the CURRENT ANIMATION TIME: ILTModel_GetCurAnimTime resolves a tracker and returns `*(uint32_t*)(tracker + 28)`, which is this field. The ctor writes 0. Live 0..3368 with 181 of 215 non-zero, and it does NOT advance while the game clock is frozen (unchanged on 215/215 across 0.8s at a paused menu) -- so it is animation time, driven by the pausable clock, not wall time. The UNIT is not proven here; milliseconds is the reference's convention and the magnitudes are consistent with it (3368 ms = 3.4 s).
    LTModelAsset* asset      @0x20   // CONFIRMED non-null and SHARED -- 34 distinct assets across 215 models. Its radius is what branch A of OT_MODEL_GetCullVolume uses (`**(float**)(obj+0xEC)`), and SlotIndex_WantsSlot requires it non-null for type 1, so it is a mandatory resource handle.
    uint16_t anim_index      @0x24   // CONFIRMED an ANIMATION INDEX by its bound: strictly less than the owning asset's animation-table entry count on 215/215 models, and the ctor writes 0. That bound is the evidence -- a field staying inside a per-asset count across 34 assets whose counts run 1..1039 is an index into that table, not a coincidence. Live non-zero on 76 of 215. NOT the one the engine calls current: see current_anim below. (An earlier version of this note said the counts ran "1 to 457"; re-measured across all 34 assets they run 1..1039.)
    uint16_t node_a          @0x26   // CONFIRMED a NODE INDEX, by two tests it passes and one it fails. It is strictly inside the asset's node_count on 215/215, and unlike a small-valued field that fits any bound, its maximum SCALES with node_count -- 9 on a 20-node model, 14 on 38, 37 on 84. (Contrast list_count, which passes the same bound while capping at 6 regardless: that is the false positive this discrimination exists to catch.) Resolved through node_names the values are real bones -- Null, Anim, joint1, cube9, Root_assault, Pelvis. Live non-zero on 80 of 215.
    uint16_t current_anim    @0x28   // CONFIRMED THE CURRENT ANIMATION INDEX, and this is the engine's own word for it: ILTModel_GetCurAnim resolves a tracker and returns `*(uint16_t*)(tracker + 40)`, which is exactly this field. That closes a question an earlier pass left open -- the pair at +0x24/+0x28 was recorded as "a current/target or current/previous couple" with WHICH being which unestablished. The engine hands out this one. // Indexing the asset's anim_records with it yields the animations models are ACTUALLY PLAYING on 214 of 215: base (x128), World, World_Physics, Ragdoll, PostFire, Corpse_surface_faceup, Alma_Stand_Searching, ghostChild_Stand4. Inside the record vector on 215/215. Still equal to anim_index on 214 of 215, so the two normally coincide; what makes them diverge is unmapped.
    uint16_t node_b          @0x2A   // CONFIRMED a second NODE INDEX, same bound and same scaling (max 38 on the 84-node model). Resolves to Anim, joint2, cube9, Pelvis, Offset_Assault, Hand_attach_Jnt. ORDERED WITH node_a: node_b >= node_a on 215/215, and the pair is either EQUAL (105) or EXACTLY ADJACENT (110) -- nothing else occurs. Their ROLE is unresolved. A subtree span was the obvious reading and it FAILS: of the 110 adjacent pairs, node_b's parent chain reaches node_a on only 104, and a real span would additionally need node_b to be the LAST descendant, which was never tested because the weaker condition already broke. Note also the interleaved layout (anim, node, anim, node) suggests two (animation, node) couples, but the correlation refutes that too -- the anim indices agree on 214 of 215 models while the node indices agree on only 105. DO NOT retry the displacement grep for a writer: +0F2h/+0F6h look distinctive but the only four matches in the image are a byte compare in unrelated code, a string-search helper whose fields are char arrays at those offsets, an immediate `push 0F2h`, and a constructor for a different class. The offsets are small enough to be a BYTE field in something else, which is what breaks the trick here.
    float anim_fraction      @0x2C   // CONFIRMED a NORMALISED fraction: live it is within [0,1] on 215/215, min exactly 0.0 and max exactly 1.0, with 33 models at zero. The ctor writes 0.0. WHAT it measures is deliberately not claimed -- playback position through the current animation and blend weight between the two indices both fit, and the data does not separate them: 178 of the 214 models whose indices are EQUAL sit at exactly 0 or 1, but 36 hold a mid-range value while their indices agree, which a pure blend weight would not do.
    uint32_t unk_30          @0x30   // NOT written by the ctor, and live it is 0 on 215/215. Included to carry the record up to the owning model's list_head at +0x100; the boundary is inferred from that adjacency, not proven.
}

// MSVC's std::string as this build lays it out: 28 bytes (0x1C), which is the
// _SECURE_SCL shape -- a _Container_proxy pointer ahead of the usual 24-byte
// body. The stride was not guessed: LTModelObject's string-array destructor
// (0x429771) is `for (i = count; i; --i) { ~string(p); p += 28; }`, so 28 comes
// from the engine's own pointer arithmetic.
//
// `buf` is the small-string buffer AND, once the string outgrows it, the heap
// pointer -- genny has no union, so read it as: capacity >= 16 means the data is
// at *(char**)buf, otherwise the data is buf itself. CONFIRMED live over 476
// strings reached this way: every one is NUL-terminated at [size], and 442 of
// them are non-empty printable ASCII (the other 34 are empty).
class StdString 0x1C {
    void* proxy       @0x00   // _Container_proxy; present only because this build compiles with _SECURE_SCL
    uint8_t buf[16]   @0x04   // small-string buffer, or a char* when capacity >= 16
    uint32_t size     @0x14   // length, NOT counting the terminator
    uint32_t capacity @0x18   // _Myres; >= 15 always, and >= size
}

// One cached per-node TRANSFORM: 28 bytes, position then rotation. The size and the
// split both come from the engine rather than from a stride scan --
// LTModelObject_TransformFromRecord (0x4292A8) is literally
// `sub_42018A(rec, rec + 12, 1.0f)`, i.e. it hands the caller (position, rotation,
// scale=1) out of a record whose rotation starts 12 bytes in.
//
// The 0x20-byte struct the public getter FILLS is this plus a scale: on its failure
// path LTModelObject_GetNodeTransform writes six zeroes at +0x00..+0x14 and then 1.0
// at BOTH +0x18 and +0x1C -- an identity quaternion whose w is +0x18, and a unit
// scale at +0x1C. That is also what retroactively settles LTModelSocket's +0x1C: the
// socket record's first 0x20 bytes are this same transform-with-scale shape.
//
// VALIDITY IS GATED, and this is the part a consumer must not skip. See the dirty
// arrays on the two blocks below: live, of 2222 node slots only 343 had a clear dirty
// byte, and EVERY one of those 343 held a sane position (0 exceptions). Of the 1879
// dirty ones, 187 held values like 7.8e37 -- stale memory the engine would recompute
// before using. Read the flag or read garbage.
class LTNodeTransform 0x1C {
    LTVector position   @0x00   // CONFIRMED position, live sane on 343/343 clean slots
    LTRotation rotation @0x0C   // CONFIRMED a UNIT quaternion on 2222/2222 slots -- notably unit even where the position is stale garbage, so the rotation alone is NOT a validity test
}

// The sub-object OT_MODEL_ctor builds at LTModelObject+0x120 (ctor 0x4257CE,
// which zeroes four dwords; dtor 0x428CAC). Its span is pinned by adjacency at
// both ends: four dwords is 0x10, and the next sub-object starts at 0x130.
class LTModelBlock120 0x10 {
    void* unk_00          @0x00   // live a heap pointer unique to each model (215 distinct, none null)
    uint8_t* node_dirty_stride2 @0x04   // CONFIRMED a per-node DIRTY-FLAG array, stride 2, and now by TWO functions rather than one indexing site. LTModelObject_MarkNodeSubtreeDirty (0x4290A8) writes `*(base + 2*node) = 1` walking the skeleton; LTModelObject_GetNodeTransform READS `base[2*node]` and, when it is non-zero, recomputes the transform instead of trusting the cache. So the element's meaning -- which an earlier pass left unmapped -- is "this node's cached transform is stale". Live 215/215 non-null. Only the FIRST of the two bytes is proven; the second is untouched by both functions.
    LTNodeTransform* node_transforms @0x08   // CONFIRMED the per-node TRANSFORM CACHE this block's dirty array guards, used when the model's mode selector (+0x156) is ZERO: GetNodeTransform reads `base + 28*node`. Live non-null on 215/215, rotations unit throughout, positions meaningful only where the dirty byte is clear. // IN MODEL SPACE, and that is NOT shared with block130's array: of the 297 clean slots on selector==0 models, ALL sit nearer the model origin than the object's position, and a root node reads exactly (0,0,0) while its object is thousands of units away. A consumer MUST compose the object's transform onto these to get world space.
    LTModelAsset* asset   @0x0C   // CONFIRMED equal to the owning model's record.asset on 215/215 -- the THIRD offset that reaches the same pointer (record.asset at 0xEC, here at 0x12C, and LTModelBlock130.asset at 0x130)
}

// The sub-object OT_MODEL_ctor builds at LTModelObject+0x130 (ctor 0x42CE7D;
// dtor 0x42DA6C). Span pinned the same way: the ctor writes through +0x20, and
// the model's next field sits at 0x154 == 0x130 + 0x24.
class LTModelBlock130 0x24 {
    LTModelAsset* asset   @0x00   // CONFIRMED equal to the owning model's record.asset on 215/215. The ctor nulls it, so the binding happens later, at load.
    uint32_t unk_04       @0x04   // ctor writes 0
    uint32_t unk_08       @0x08   // ctor writes 0
    uint32_t unk_0C       @0x0C   // ctor writes 0
    uint8_t* node_dirty_stride3 @0x10 // CONFIRMED a per-node DIRTY-FLAG array with stride 3, same pair of functions as block120's: MarkNodeSubtreeDirty writes `*(base + 3*node + 1) = 1` and GetNodeTransform tests that same byte before deciding whether to recompute. The +1 is the engine's, not an alignment guess -- the flag is the SECOND byte of each three, so the element is a small record whose other two bytes neither function touches. Live non-null.
    LTNodeTransform* node_transforms @0x14 // CONFIRMED the per-node TRANSFORM CACHE guarded by the stride-3 array, used when the mode selector (+0x156) is NON-ZERO: GetNodeTransform reads `base + 28*node` on that branch. Live non-null on 215/215 with unit rotations throughout. // ALREADY IN WORLD SPACE, unlike block120's -- the two caches have the same layout and DIFFERENT frames of reference. Of the 46 clean slots on selector!=0 models, ALL sit nearer the object's position than the model origin, and one bone read 0.00 units from its object. Composing the object's transform onto these DOUBLE-APPLIES it: doing so put a socket 5449 units from its owner, against 137 once the branch was added. The layout test cannot see this; measuring the distance to the origin versus to the object can.
    uint8_t unk_18        @0x18   // ctor writes 0
    uint8_t unk_19        @0x19   // ctor writes 0
    uint32_t unk_1C       @0x1C   // ctor writes 0xFFFFFFFF and live it is STILL 0xFFFFFFFF on 215/215 -- a "none" sentinel nothing in a loaded level sets
    float unk_20          @0x20   // ctor writes 1.0 and live it is STILL exactly 1.0 on 215/215 -- unexercised in this scene, so its role is unmapped
}

// ---- ILTModel VTABLE (client 0x66E7E8, server 0x674CD8) ----
// The two tables are parallel implementations of one interface; the client's is 83 entries.
//   slot 2  ILTModel_GetSocket            (object, name, out_index)
//   slot 3  ILTModel_GetSocketTransform   (object, handle, out[8], world_space)
//
// SLOTS 2 AND 3 TAKE THE OBJECT, NOT THE INTERFACE. `mov ecx, [esp+arg_0]` loads the FIRST STACK
// ARGUMENT into ECX and then `cmp byte ptr [ecx+10h], 1` tests the OBJECT's type for OT_MODEL
// before re-dispatching as a thiscall on it -- so the interface `this` is never read, and these are
// __stdcall wrappers over an object. What proves it BEHAVIOURALLY rather than by reading: passing the
// interface first makes the gate read iface+0x10 and return LT_INVALIDPARAMS (60) without touching
// anything, which is how that mistake surfaced -- a clean refusal, not a crash.
//
// THAT FINDING IS ABOUT SLOTS 2 AND 3. It is not a table-wide convention, and `ret N` cannot extend it:
// MSVC __thiscall ALSO uses callee cleanup, ECX may be read later in a function or forwarded to a
// callee, and a function may have several epilogues. Slot 22 was inspected individually and shows the
// same structural shape (first instruction reads the first stack argument, the OT_MODEL gate reads it,
// `retn 0Ch`) and its ECX use was then checked exhaustively: ECX is read twice, both reads dominated by a
// `mov ecx, [esp+node_index]` with no branch target in between, and there is no indirect call to forward
// it -- so the caller's ECX is dead there too. THREE stack dwords, not four. Every other slot's ABI is
// unclaimed; the list below is an inventory of observed stack-pop sizes, not a set of signatures.
//
// out[8] is position(3), quaternion xyz(3), quaternion w, scale -- read off the engine's own
// failure path, which zeroes all eight and writes 1.0 into the last two (identity quat, unit scale).
//
// world_space: 1 -> world, 0 -> model. Measured against sdk::ModelSkeleton on the 181 clean live
// sockets: flag 1 matches socket_world_transform() 181/181, and flag 0 matches socket_transform()
// on the 131 whose bone cache is model-space while coinciding with it on the other 50 whose cache
// is already world-space. 131 + 50 = 181.
//
// CALLING SLOT 3 ON A DIRTY NODE MUTATES: LTModelObject_GetNodeTransform evaluates the skeleton and
// clears the dirty flag, so it belongs on the game thread. On a clean node the check
// short-circuits and the call is a pure read.
//
// SLOT MAP (2026-07). 60 of the 83 client entries were already named by earlier passes, so walking the
// table attached the indices for free.
//
// EACH ENTRY READS `slot Name/N`, where N is the STACK DWORDS POPPED by that function's `ret N` -- an
// inventory, not a signature. N is NOT the argument count: a __thiscall member would carry an additional
// ECX `this` on top of it, hidden return-buffer or register parameters would not appear, and nothing about
// output semantics follows from it. The aggregate claim it supports is that all 83 clean up their own stack.
// Which slots take the OBJECT first is established only for 2, 3 and 22, above.
//   0 abstract_base_dtor/1  1 InterfaceImplementation/0  2 GetSocket/3  3 GetSocketTransform/4
//   7 GetPieceName/4  8 GetPieceHideStatus/3  9 srv:SetPieceHideStatus/3  10 GetLODDistanceBias/2
//   11 SetLODDistanceBias/2  12 GetNode/3  13 GetNodeName/4  18 GetNumChildren/3  19 GetChild/4
//   20 GetParent/3  21 GetNumNodes/2  22 GetBindPoseNodeTransform/3  28 UpdateMainTracker/2
//   29 GetNumAnimations/2  30 GetAnimInterpolationTime/3  31 CommonLT_GetModelAnimUserDims/3
//   33 GetAnimKeyFrames/3  34 GetAnimNodeTransform/5  36 GetPlaybackState/3  37 AddTracker/3
//   38 RemoveTracker/2  41 GetAnimIndex/3  42 GetAnimName/4  43 GetCurAnim/3  44 SetCurAnim/4
//   45 GetIsInterpolating/2  46 ResetAnim/2  47 GetLooping/2  48 SetLooping/3  49 GetPlaying/2
//   50 SetPlaying/3  52 GetCurAnimTime/3  53 SetCurAnimTime/3  55 SetAnimRate/3  56 GetAnimRate/3
//   57 GetNumWeightSets/2  60 SetWeightSet/3  61 FindPhysicsWeightSet/3  62 SetPhysicsWeightSet/2
//   63 GetPhysicsWeightSet/2  64 GetPhysicsVisNode/2  65 DirtyAllNodeTransforms/1
//   66 DirtyNodeTransform/2  67 UpdateModelAttachments/1  68 GetModelFilename/3
//   69 GetMaterialFilename/4  70 SetMaterialFilename/3  71 GetMovementEncodingTransform/2
//   72 ResetMovementEncodingTransform/1  73 SetMovementEncodingTracker/2  74 DisableMovementEncoding/1
//   75 IsAnimDataLoaded/2  78 UpdatePhysicsOnlyOnDeath/1  79 AddCharacterProxyToWorld/1
//   80 RemoveCharacterProxyFromWorld/1  81 GetMaterial/3  82 SetMaterial/3
//
// slot 22 GetBindPoseNodeTransform is the +0x08 pose reader this project reversed; the reference declares
// it on the BASE ILTModel, which fits the early slot. slot 34 GetAnimNodeTransform is the +0x24
// animation-fallback reader. Both have no callers inside FEAR2.exe, so whatever composes their output
// reaches them as vt[22] and vt[34] from gameclient.dll.
// The other 23 are unnamed.
//
// WHAT "83 ENTRIES" RESTS ON. The executable-pointer RUN ends at 83: the string "CLTModelClient" is the
// next defined item. That the 83 are ONE table is weaker -- it rests on no interior vptr store being
// DETECTED, by a check (reversing/ida_vtable_boundary.py) matching a single instruction shape. Neither
// available corroboration applies: [vt-4] is string bytes rather than a Complete Object Locator, so this
// class has no RTTI even though the image carries it for std:: types; and there is no constructor to read,
// since the table's ONLY image-wide reference is the statically initialised instance's own vptr field at
// 0x6E30EC. The reference header's ~59 virtuals across ILTModel and ILTModelClient are a different engine
// version, so context only. Build observations, not proof.


// The concrete class behind object type 1. 408 bytes (0x198) from its bank's
// element_size, and the class is now CLOSED at that boundary: the cached
// rotation below ends at exactly 0x198.
//
// OT_MODEL_ctor (0x42A4C8) is what opened the rest of this class up. It derives
// DIRECTLY from LTObject -- OT_MODEL_dtor_body installs vtbl_OT_MODEL and calls
// LTObject_dtor_body with nothing in between -- so despite having a vtable that
// shares no slots with any sibling, there is no intermediate class here.
class LTModelObject 0x198 {
    LTObject base            @0x00    // CONFIRMED: the first 0xCC bytes are an LTObject
    LTModelRecord record     @0xCC    // CONFIRMED: the embedded record, linked into list_head below. Holds `asset`, which is why no separate asset field appears on this class.
    CClientMgrListLink list_head @0x100   // CONFIRMED list head: the ctor self-points both halves (an empty list) and then links `record` in. Live it is never empty for that reason. Members are recovered as LTModelRecord addresses.
    uint32_t list_count      @0x108   // CONFIRMED the list's OWN stored count: it equals the walked member count on 215/215, and the ctor increments it to 1 as it links `record`. Live distribution 1 (x184), 2 (x6), 3 (x12), 4 (x9), 5 (x3), 6 (x1) -- so one embedded record plus up to five extras. All 289 members across 215 models bind the SAME asset as their owner (289/289), which is what identifies them as LTModelRecords; why a model wants several is unmapped.
    uint32_t piece_hide_bits[2] @0x10C  // CONFIRMED the PIECE HIDE BITMASK, and the reader leaves no room for interpretation: LTModelObject_GetPieceHideBit is the whole of ILTModel::GetPieceHideStatus's body and reads `(this[(piece >> 5) + 67] & (1 << (piece & 31))) != 0` -- dwords starting at +0x10C, one bit per piece. The LENGTH is pinned by adjacency, not chosen: material_names begins at +0x114, so exactly two dwords fit, i.e. the engine supports at most 64 pieces (live material_count never exceeds 8). // UNEXERCISED IN THIS SCENE: every bit is clear on all 215 models, so nothing here is hidden and the live data CANNOT corroborate the reader -- it is merely consistent with it. The identification rests on the code alone, which for a function the engine itself names GetPieceHideStatus is strong; a scene with a hidden piece would be worth re-measuring against.
    StdString* material_names @0x114  // CONFIRMED an OWNED ARRAY of std::string, from TWO independent routes. The teardown calls 0x429771(this+0x114, this+0x118), which is `for (i = count; i; --i) { ~string(p); p += 28; }`. And a READER agrees: LTModelObject_GetMaterialFilename (0x4291E1, reached through ILTModel's vtable slot 69) does `if (i >= this[70]) return 0; strcpy(dst, std::string::c_str(this[69] + 28*i))` -- the same base, the same length field, the same 28-byte stride, and it names the element type outright by calling c_str on it. A destructor and a getter arriving at the same layout is as good as this gets without symbols. Live these are MATERIAL PATHS -- e.g. "weapons\_global\shellcasings\assault_rifle_new\mat\assault_rifle_casing1.mat" -- 476 strings across 215 models, every one NUL-terminated at [size]. This is the first place in the mapping where an object says in plain text WHAT it is.
    uint32_t material_count   @0x118  // CONFIRMED the array length from the destructor, and CONFIRMED as a BOUND by the getter above, which rejects any index >= this value before touching the array. Live it takes six distinct values with a maximum of 8, and 1 is by far the most common (125 of 215); 34 of the 476 strings are empty. (An earlier note here said "1..6" -- an artefact of a probe that capped its own loop at 8, not a measurement.)
    uint32_t unk_11C          @0x11C  // ctor writes 0; live it is a non-null pointer unique to each model (215 distinct). Owner unmapped -- no teardown call in OT_MODEL_dtor_body reaches it directly.
    LTModelBlock120 block_120 @0x120  // CONFIRMED sub-object (see its class); its `asset` is a third route to the model's asset
    LTModelBlock130 block_130 @0x130  // CONFIRMED sub-object (see its class); its `asset` is the second route
    uint16_t sphere_source   @0x156   // CONFIRMED branch selector in OT_MODEL_GetCullVolume. The two branches differ in MORE than where they read from, which is why both exist: non-zero takes the centre from sphere_center and the radius from asset->radius UNSCALED; zero takes the centre from LTObject.position and the radius from vis_radius * LTObject.scale. Since asset->radius == vis_radius on 215/215, the real distinction is explicit-centre-and-unscaled versus object-centre-and-scaled. Live: 22 non-zero / 193 zero of 215.
    LTVector sphere_center   @0x160   // CONFIRMED: the cull-sphere centre used when sphere_source != 0 (a world position, copied out directly rather than added to LTObject.position). PROVENANCE, from the ctor: it is initialised by copying base.position. That is why it is stale on most objects -- live it still equals base.position on only 12 of 215 -- and why the 193 objects with sphere_source == 0 can safely ignore it.
    float vis_radius         @0x16C   // CONFIRMED, now by ASSIGNMENT rather than by correlation: LTModelObject_BindAsset ends with `*(float*)(this + 364) = *(float*)(asset + 128)`, i.e. this := asset->radius_from_file. The equality on 215/215 objects was the earlier evidence; this is the writer. Multiplied by LTObject.scale to give branch B's cull radius in OT_MODEL_GetCullVolume, and > 0 live on 215/215. A mod must not treat it and the asset's radius as independent knobs.
    void* per_node_alloc     @0x170   // CONFIRMED the SINGLE allocation backing every per-object array here, and the size expression is now fully decoded. LTModelObject_BindAsset computes exactly:
                                      //     align4(34 * node_count)                                  [LTModelAsset_RegionSize_34xNodes]
                                      //   + align4(31 * node_count + 4*(asset+0x08 + asset+0x10))     [LTModelAsset_RegionSize_31xNodes]
                                      //   + align4(28 * asset->material_count)                        [the material-path array]
                                      //   + align4(2 * node_count) + align4(48 * node_count)          [only when flags3 & 0x400]
                                      // then LTMem_Allocs it, stores the base here, and hands {base, size} to carvers that slice it. VERIFIED BY RECONSTRUCTION: recomputing that size from the live counts and testing every carved pointer against [base, base+size) gives 215/215 for material_names, node_matrices and per_node_stride2_b, plus 215/215 for the palette's FULL 48*node_count extent fitting. Reproducing an allocator's arithmetic and having every derived pointer land inside the result is about as strong as a layout claim gets, and it simultaneously confirms node_count, asset->material_count and the two counts at asset+0x08/+0x10.
                                      // Consequence worth knowing: material_names is NOT an independent allocation. Its std::strings are destructed by the string-array teardown, but the memory holding them belongs to THIS block -- which is why only this pointer is freed (LTModelObject_ReleaseNodeStorage) before a rebind.
    LTMatrix3x4* node_matrices @0x174 // CONFIRMED the BONE MATRIX PALETTE the renderer uploads to the vertex shader. The region's stride and length come from LTModelObject_BindAsset, which reserves exactly `48 * asset->node_count` bytes and stores the base here (only when LTObject.flags3 has bit 0x400, live set on 215/215; the region lies inside per_node_alloc on 215/215). Its MEANING comes from its two consumers, reached through the 7-byte getter LTModelObject_GetNodeMatrices: Renderer_BuildBonePalette walks a mesh's bone index list, calls Renderer_SetBoneMatrix(slot, node_matrices + 48*bone) for each, then Renderer_UploadBoneMatrices(48 * count) -- with the count CAPPED AT 24 and the whole path gated on shader-constant register indices being != -1. A 24-entry 3x4 palette uploaded to a vertex shader is skinning, and 24 is the classic D3D9 palette limit.
                                      // CONTENTS ARE PER-FRAME RENDER STATE, which a consumer must plan around. Read from an idle game these are mostly ZERO: 169 of 215 models are entirely zero, only 530 of 2222 slots are non-zero and 352 are not even finite, and the player's own viewmodel reads all zeros. That is not a mapping problem -- the palette is filled during the draw for the models actually being rendered, so anything reading it must do so from the render path or accept stale/blank data. An earlier note here guessed "world-transform cache" and tested rigidity (181/2222 with unit rows and det 1); that was the wrong question, because a palette slot is either freshly written or untouched.
    void* per_node_stride2_b @0x178  // CONFIRMED a per-node 2-byte array, also carved from per_node_alloc (the allocator reserves 2*node_count beside the 48*node_count region) and also gated on flags3 bit 0x400. LTModelObject_MarkNodeSubtreeDirty writes `*(this[0x178] + 2*node) = 0` while walking the skeleton, so it is indexed by node index. Element meaning unmapped.
    LTRotation cached_rotation @0x188   // CONFIRMED a real quaternion, not padding: the ctor writes (0,0,0,1) and live it is unit-length on 215/215. Ends at 0x198 == the class size, closing the class. It is NOT a live mirror of base.rotation (that would make it redundant); which of the two the renderer consumes is unmapped.
}

// The concrete class behind object type 6. 264 bytes (0x108) from its bank's
// element_size -- and the cull fields below end at exactly 0x108, so this part
// of the class is complete even though nothing else in it is mapped.
//
// Note both volumes are stored as OFFSETS: the provider adds LTObject.position
// to every component before handing them out, so these are object-local.
class LTParticleSystemObject 0x108 {
    LTObject base              @0x00   // CONFIRMED: the first 0xCC bytes are an LTObject
    uint32_t unk_CC            @0xCC   // ctor writes 0
    uint32_t unk_D0            @0xD0   // ctor writes 0
    uint32_t unk_D4            @0xD4   // ctor writes 0
    uint32_t unk_D8            @0xD8   // ctor writes 0
    uint8_t unk_DC             @0xDC   // ctor writes 0. Distinct from cull_volume_type beside it.
    uint8_t cull_volume_type    @0xDD   // CONFIRMED: OT_PARTICLESYSTEM_GetCullVolume RETURNS this byte, so it is literally the volume-kind selector -- 1 takes the sphere path, anything else the AABB path. Live it is only ever 1 (239) or 2 (39) across 278/278 objects, which is exactly the pair of values the interface defines, and OT_PARTICLESYSTEM_ctor initialises it to 1 -- so the sphere path is the default.
    LTVector sphere_offset     @0xE0   // CONFIRMED: added to LTObject.position to give the sphere centre (type 1)
    float sphere_radius        @0xEC   // CONFIRMED: the sphere radius (type 1)
    LTVector aabb_min_offset   @0xF0   // CONFIRMED: added to LTObject.position to give the AABB min (type != 1)
    LTVector aabb_max_offset   @0xFC   // CONFIRMED: added to LTObject.position to give the AABB max. Ends at 0x108 == the class size.
}

// The concrete class behind object type 3. 340 bytes (0x154) from its bank's
// element_size. Only the cull-volume fields are mapped.
//
// Unlike OT_PARTICLESYSTEM, the selector here is NOT a volume-kind enum: the
// provider switches on a KIND byte and hard-codes which kinds are AABB-shaped
// (3, 4, 7 and 9), returning a sphere for everything else. So the byte
// identifies what the sprite IS and the volume shape follows from that.
class LTSpriteObject 0x154 {
    LTObject base          @0x00    // CONFIRMED: the first 0xCC bytes are an LTObject
    float unk_CC           @0xCC    // ctor writes 1.0
    float angle_a          @0xE8    // ctor writes pi/2 (flt_671058 == 1.5707964). An ANGLE by that constant alone; which one is unmapped.
    float angle_b          @0xEC    // ctor writes the same pi/2 constant. The pair is initialised together.
    float unk_F0           @0xF0    // ctor writes 0.0
    float unk_F4           @0xF4    // ctor writes 0.0
    float unk_F8           @0xF8    // ctor writes 0.0
    uint8_t none_bytes[6]  @0xFC    // CONFIRMED all six set to 0xFF by the ctor -- the engine's "none" sentinel byte, six of them in a row. Note the class ALSO ends with exactly six owned pointers (see `owned`); a six-and-six correspondence is suggestive of one slot table with a byte index and a pointer each, but nothing links the two spans yet.
    uint8_t zero_bytes[4]  @0x102   // ctor writes 0 to each
    uint8_t kind           @0x106   // CONFIRMED selector in OT_SPRITE_GetCullVolume: kinds 3/4/7/9 take the AABB path, all others the sphere path. Live values span 1..9 across 224/224 objects (6 is the most common at 112), so this is a small dense enum -- but only the AABB-vs-sphere split is proven; what each kind MEANS is unmapped. The ctor writes 0, which is NOT among the live values, so 0 means "unset".
    float unk_108          @0x108   // ctor writes 0.0
    float unk_10C          @0x10C   // ctor writes 0.0
    float unk_110          @0x110   // ctor writes 0.0
    LTVector unk_114       @0x114   // ctor writes (0, 0, 1) -- a unit vector along Z, so plausibly a direction or normal. Unverified beyond the initialiser.
    LTVector aabb_min      @0x120   // CONFIRMED: passed to LTMath_WriteAABB as the min for AABB kinds. Live, min <= max componentwise on 9/9 AABB-kind sprites.
    LTVector aabb_max      @0x12C   // CONFIRMED: the max for AABB kinds
    float radius           @0x138   // CONFIRMED: the sphere radius for all other kinds, paired with LTObject.position as the centre. Live, finite and > 0 on 215/215 sphere-kind sprites.
    void* owned[6]         @0x13C   // CONFIRMED OWNED: OT_SPRITE_dtor_body (0x4150B3) runs `do { LTMem_Free(*v2++) } while(--6)` starting at this+79 dwords == +0x13C, so all six are freed unconditionally. Ends at 0x154 == the class size, which is how the count 6 and this offset corroborate each other. Live they are sparsely used -- 168 of 1344 slots non-null, and only 3 of 224 sprites fill all six -- so they are optional per-slot allocations. WHAT they hold is unmapped.
}
}
