type uint64_t 8 [[u64]]
type int32_t 4 [[i32]]
type uint32_t 4 [[u32]]
type int16_t 2 [[i16]]
type uint16_t 2 [[u16]]
type uint8_t 1 [[u8]]
type int8_t 1 [[i8]]
type double 8 [[f64]]
type float 4 [[f32]]
type char 1
type void 0
type code 4 [[code]]
type wstrptr 4 [[utf16*]]
type strptr 4 [[utf8*]]
type wchar_t 2 [[u16]]
type bool 1 [[bool]]
type char 1 [[u8]]

struct BS 0x1000 {

}

namespace regenny {

// The vtable ITSELF (pointed to by DatabaseMgr::vtable, not inlined into the
// object). 64 entries CONFIRMED live: every slot dereferences to a readable
// code pointer inside GameDatabase.dll's real image bounds
// [0x9F0000,0xA05000); vt[64] lands on string data in .rdata ("tera..."),
// which is what pins the count at exactly 64. Virtuals intentionally left
// unmapped/opaque per instruction -- data layout only for now.
class DatabaseMgrVTable 0x100 {
    void* fn[64]   @0x00 [[code]]
}

// LithTech interface holder -- what the SDK's define_holder(IFoo, ptr) macro
// emits. CONFIRMED by reversing CAPIHolder_ctor (dump 0x4050DB) and the four
// vtable slots that operate on it; see reversing/INTERFACE_HOLDERS.md for the
// full trail and for the 147-holder / 36-interface table recovered from it.
//
// DIVERGES FROM THE SOURCE DROP: ltmodule.h's CAPIHolderBase puts `int32
// version` at +0x08. FEAR2 does not -- output_slot occupies it, and all three
// non-destructor virtuals (APIRemoved `*p=0`, APIFound `*p=api`, Interface
// `return *p`) read it as the pointer slot. The base constructor takes only
// the name (`retn 4`). Do not reintroduce `version`.
//
// NOTE ON USE: sdk::interfaces::Registry does NOT read these fields. It
// recovers each holder's name and slot from the static-init CALL SITE operands
// instead (which is where they are pushed from), so it never needs a struct
// offset. This type is here because the schema is where layouts belong, and so
// that code which does want to walk a holder object has an offsetof-able type
// rather than literals.
class CAPIHolder 0xC {
    void* vftable       @0x00 [[code]]   // CONFIRMED &CAPIHolder_vftable (dump 0x66EE08); base ctor writes the base vtable first, derived ctor overwrites
    strptr api_name     @0x04            // CONFIRMED "IFoo.Instance"; stored by CAPIHolderBase_ctor (dump 0x41FEDD)
    void** output_slot  @0x08            // CONFIRMED the consumer's own pointer variable; zeroed at construction, filled by APIFound, cleared by APIRemoved
}

// One 8-byte hash-table bucket entry. CONFIRMED: `hash` values are STABLE
// across apparently-repeated entries (identical 32-bit values recur at
// different indices for what look like the same underlying name), consistent
// with a hash-of-string. The trailing byte fields' MEANING is NOT verified --
// only their raw values are recorded (neutral names on purpose).
class HashEntry 0x8 {
    uint32_t hash   @0x00   // stable/repeating values observed -- consistent with hash(name), not otherwise confirmed
    uint8_t unk_04  @0x04   // observed: 01,02,04,06,07,09 -- meaning unverified
    uint8_t unk_05  @0x05   // observed constant 0x01 in nearly all samples (rare 0x06/0x12 seen) -- meaning unverified
    uint8_t unk_06  @0x06   // observed small incrementing-looking values -- meaning unverified
    uint8_t unk_07  @0x07   // observed constant 0x00 in every sample so far
}

// 0x18-byte record: one entry of DatabaseMgrCategory.records[]. This is the
// engine's HRECORD. CONFIRMED live (4 samples across two categories):
// `name` reads as a printable ASCII string ("Default", "Rat",
// "Multi_CombatBase", "ATCPatrol") and `owner_category` reads back exactly
// the owning DatabaseMgrCategory's address in every sample.
//
// owner_category stays void* (not DatabaseMgrCategory*) because this is a
// genuine cyclic type dependency and ReGenny cannot express it:
// DatabaseMgrCategory.records needs DatabaseMgrRecord defined first, and
// DatabaseMgrRecord.owner_category needs DatabaseMgrCategory defined first.
//
// Forward declarations do NOT solve this. `struct Foo {}` parses, but it
// SHADOWS rather than merges: with a forward decl present, find_struct
// returns the EMPTY declaration (size 0, no fields) and the later real
// definition is unreachable. Measured directly -- forward-declaring
// DatabaseMgrCategory here dropped it from size 0x14 to 0x0 with `name`
// MISSING. So a forward decl is only safe for a type you never define
// fully, which is useless for a real cycle.
// (Self-reference is different and DOES work -- a class may point to
// itself inside its own body; see CClientMgrListLink.)
//
// The pointee IS DatabaseMgrCategory (verified: == the owning category's
// address in every sample); it's just not spellable here. Note which side
// carries the void*: the OWNED-array direction (Category.records ->
// DatabaseMgrRecord*) is typed, because that is the direction you actually
// browse; only the backpointer is untyped. Cast at the call site to walk
// upward.
//
// unk_04/unk_08/unk_0C/unk_14 are UNVERIFIED -- kept as opaque scalars/
// pointers rather than guessed at. This is a deliberate scope boundary: the
// vtable functions that would confirm attribute count/storage were not
// reversed this pass (see reversing/MAPPING_WORKFLOW.md for the recipe).
// Observed live: unk_04 was 3 for "Default" (AI/WeaponContext) and 5 for
// all 3 sampled AI/GoalSets records -- varies per record, plausible
// attribute count. unk_08/unk_0C are heap pointers into two DIFFERENT
// nearby regions per record (0x09B37xxx and 0x09B68xxx in the sampled
// snapshot) -- unk_08 in particular showed a consistent ~0x28-byte stride
// across consecutive records in the same category, plausible attribute-
// descriptor array. unk_14 is a small unique-per-record 32-bit value,
// plausible name hash (same pattern as DatabaseMgrCategory.unk_10).
class DatabaseMgrRecord 0x18 {
    strptr name             @0x00   // CONFIRMED live: readable ASCII in 4/4 samples
    uint32_t unk_04         @0x04   // unverified; observed 3-5, plausible attribute count
    void* unk_08            @0x08   // unverified; plausible attribute-descriptor array (~0x28-byte stride observed)
    void* unk_0C            @0x0C   // unverified
    void* owner_category    @0x10   // CONFIRMED live: == owning DatabaseMgrCategory address in 4/4 samples; see comment above for why this isn't typed DatabaseMgrCategory*
    uint32_t unk_14         @0x14   // unverified; small unique-per-record value, plausible name hash
}

// 0x14-byte record: one entry of DatabaseMgrSubRecord.categories[]. This is
// the engine's HCATEGORY. CONFIRMED 359/359 live (main menu,
// Database\Loki.gamedb): every element's `name` reads as a printable ASCII
// string (real category names: "AI", "FX", "FX/ModelDecal/Settings",
// "AI/WeaponContext", "AI/GoalSets", ...) AND `owner_database` reads back
// exactly the owning DatabaseMgrSubRecord's address -- zero exceptions.
//
// owner_database is void* for the same cyclic-dependency reason as
// DatabaseMgrRecord.owner_category above (pointee IS DatabaseMgrSubRecord,
// verified by address equality; not spelled in the type system).
//
// num_records/records: CONFIRMED via IDatabaseMgr's own vtable. IDA:
// GameDatabase.dll+0x634F (IDatabaseMgr_GetNumRecords, vt[5]/+0x14 -- ALSO
// reused at vt[18]/+0x48, i.e. one function body serves two vtable slots,
// plausibly ICF/linker-folded) does `return *(hCategory+0x8)`; GameDatabase.
// dll+0x635D (IDatabaseMgr_GetRecordByIndex, vt[19]/+0x4C) does `return
// *(hCategory+0xC) + 24*index` bounds-checked against `*(hCategory+0x8)`.
// Live-verified on "AI/WeaponContext" (num_records=1) and "AI/GoalSets"
// (num_records=83, sampled 3 records) -- every element decodes with a
// readable name and owner backpointer (see DatabaseMgrRecord above).
//
// unk_10: unverified. Small (non-pointer-range) 32-bit values, unique per
// category in every sample -- consistent with a precomputed name hash, not
// otherwise confirmed.
class DatabaseMgrCategory 0x14 {
    strptr name                @0x00   // CONFIRMED live: readable ASCII in 359/359 samples
    void* owner_database        @0x04   // CONFIRMED live: == owning DatabaseMgrSubRecord address in 359/359 samples; see comment above for why this isn't typed DatabaseMgrSubRecord*
    uint32_t num_records       @0x08   // CONFIRMED: matches IDatabaseMgr_GetRecordByIndex's bounds check exactly
    DatabaseMgrRecord* records @0x0C   // CONFIRMED: matches IDatabaseMgr_GetRecordByIndex's array base exactly
    uint32_t unk_10             @0x10   // unverified; small unique-per-category values, plausible name hash
}

// 0x1C-byte record. CONFIRMED IDENTICAL SHAPE observed independently at TWO
// live addresses (DatabaseMgrEntry.record_a and .record_b of the single
// array element currently live) -- same field layout, same self-pointer
// relationship, in both instances. This is the engine's HDATABASE: one
// loaded .gamedb file.
//
// string_data and path_data are typed strptr because their CONTENT WAS
// DIRECTLY READ as null-terminated ASCII, not inferred:
//   record_a: string_data -> "AI\0FX\0FX/ModelDecal/Settings\0..." (packed,
//             multiple concatenated strings; strptr renders only the first)
//             path_data   -> "Database\Loki.gamedb"
//   record_b: string_data -> "ObjectDB\0ObjectRec\0msg system exitlevel..."
//             path_data   -> "worlds\sp\m05_outershell\m05_out..."
// hash_entries points at HashEntry-shaped data (verified 8-byte stride, see
// HashEntry) but its LENGTH is not tied to num_categories/count_b/count_c
// with any confirmed formula -- do not assume a specific entry count from
// those.
//
// num_categories/categories: CONFIRMED via IDatabaseMgr's own vtable +
// live memory cross-check. IDA: GameDatabase.dll+0x62DA
// (IDatabaseMgr_GetNumCategories, vt[9]/+0x24) does `return
// *(hDatabase+0xC)`; GameDatabase.dll+0x62E8 (IDatabaseMgr_GetCategoryByIndex,
// vt[10]/+0x28) does `return *(hDatabase+0x14) + 20*index` bounds-checked
// against `*(hDatabase+0xC)`. Live read (main menu, Database\Loki.gamedb):
// num_categories=359, categories points at EXACTLY record+0x1C (one-past-
// the-end -- the array is allocated inline, trailing the header), and all
// 359 elements at that address with 20-byte stride decode as valid
// DatabaseMgrCategory (name readable ASCII + owner_database backpointer ==
// this record, 359/359 -- see DatabaseMgrCategory above). This supersedes
// the old "self_ref, purpose not verified" note.
//
// count_b: unverified. Live value 24270 on the same snapshot; plausible as
// the string_data pool's byte length (large, plausible-string-blob-sized),
// not otherwise confirmed.
//
// count_c: unverified as a field, but vtable evidence is suggestive: two
// vtable functions explored during category/record mapping (IDA
// GameDatabase.dll+0x62A9 and +0x6FC9, NOT renamed -- behavior partially
// understood, not enough to commit a name) increment/decrement a DWORD at
// `handle+0x18` when producing/releasing a lookup result, i.e. exactly this
// field's offset on this struct. Consistent with a refcount, not proven by
// a direct before/after live test.
class DatabaseMgrSubRecord 0x1C {
    strptr string_data              @0x00
    HashEntry* hash_entries          @0x04
    strptr path_data                @0x08
    uint32_t num_categories          @0x0C   // CONFIRMED: matches IDatabaseMgr_GetCategoryByIndex's bounds check exactly (359/359 live-verified)
    uint32_t count_b                 @0x10   // unverified; live value 24270, plausibly string_data pool byte length
    DatabaseMgrCategory* categories  @0x14   // CONFIRMED: == this+0x1C (inline trailing array); matches IDatabaseMgr_GetCategoryByIndex's array base exactly
    uint32_t count_c                 @0x18   // unverified; vtable evidence suggests a refcount (see comment above)
}

// One 8-byte array element of DatabaseMgr's internal array (confirmed size:
// (array_end - array_begin) == 8 bytes for the current 1-element span).
// Both fields point to a DatabaseMgrSubRecord (see above; verified identical
// shape at both addresses).
class DatabaseMgrEntry 0x8 {
    DatabaseMgrSubRecord* record_a   @0x00
    DatabaseMgrSubRecord* record_b   @0x04
}

// Live-memory mapped from the running FEAR2.exe (32-bit). Singleton resolved
// via gamedatabase.dll export LTGetIDatabaseMgr -> GameDatabase.dll + RVA
// 0x122BC (module-relative; use GameDatabase.dll+0x122BC in ReGenny, do not
// hardcode the absolute VA -- it moves with module placement).
//
// Mapped by READING LIVE MEMORY ONLY (regenny_lua_eval) -- no decompilation
// used for this pass. Offsets 0x00-0x14 are STRUCTURALLY confirmed: the
// begin/end/cap_end pointer math is self-consistent
// ((end-begin) == unk_14 * sizeof(DatabaseMgrEntry)) in every observed
// snapshot; vtable dereferences to 64 readable code pointers, all inside
// GameDatabase.dll's real image bounds.
//
// NOTE (2026-07): this is the LOW-LEVEL engine IDatabaseMgr singleton in
// gamedatabase.dll, NOT the game-layer CGameDatabaseMgr wrapper (which lives
// in gameclient.dll/gameserver.dll with its own std::string + HDATABASE
// fields per lithtech/FEAR/Shared/GameDatabaseMgr.h -- a DIFFERENT object,
// do not conflate the two).
//
// Snapshot (2026-07, main menu, one array element registered):
//   +0x18..+0x5C all zero -- struct size beyond +0x18 unconfirmed, sized
//   0x20 here for headroom only.
class DatabaseMgr 0x20 {
    DatabaseMgrVTable* vtable        @0x00
    uint32_t unk_04                  @0x04   // observed 0; role unverified
    DatabaseMgrEntry* array_begin    @0x08
    DatabaseMgrEntry* array_end      @0x0C
    DatabaseMgrEntry* array_cap_end  @0x10
    uint32_t unk_14                  @0x14   // observed 1; equals (array_end-array_begin)/8 in every snapshot so far
}

// 8-byte intrusive circular-list link. A generic, engine-wide list utility
// (used far outside CClientMgr; NOT reverse-engineered as a general
// facility here, only enough to explain the heads/links that embed it).
// CClientMgr embeds two sentinel heads of this shape (counter_list_head
// @0x13EC, start_shell_list @0x1460) and LTObject embeds one @0xAC.
//
// Declared HERE, above its first by-value user, on purpose: `.genny`
// forward declarations (`struct Foo {}`) make a name RESOLVABLE, which is
// enough for POINTER members, but the forward-declared type resolves with
// size 0 -- so anything embedding it BY VALUE would silently get a 0-byte
// member. By-value users therefore need the real definition first.
//
// next: CONFIRMED live (2026-07) for counter_list_head specifically:
// counter_list_head.next == CClientMgr.own_counter_node + 0x14 exactly, in
// the same live snapshot that also matched CClientMgr::Init's insertion
// code (dump 0x415B54: `*(result+20)=*this; *this=result+20;` -- i.e. the
// newly-inserted node's link portion begins at node+0x14, and the head's
// own `next` field points at it). Also confirmed by every LTObject list
// walk: 3506 objects reached by following `.next` from 7 heads.
// prev: position inferred from the same 8-byte link shape; not
// independently read live.
class CClientMgrListLink 0x8 {
    CClientMgrListLink* prev  @0x00   // CONFIRMED live: circular doubly-linked. Walked all 7 object_lists buckets (3489 nodes): every node's prev == its predecessor, and each head's prev == that list's LAST node. 0 failures.
    CClientMgrListLink* next  @0x04   // CONFIRMED live: every bucket walk closes back on its own head (see above)
}

// The world tree's link. DELIBERATELY NOT CClientMgrListLink: that type is
// prev@0x00 / next@0x04, and this one is the other way round. A node's object
// list is traversed by following +0x00 from the head, which is what reaches
// every object (verified: 2142 objects across 285 occupied nodes, every list
// closing back on its own head). Reusing CClientMgrListLink here would compile
// and walk -- a circular list walks fine in either direction -- while silently
// meaning the opposite thing.
//
// Honest limit on the naming: LTWorldTree_RemoveObject's unlink is SYMMETRIC in
// the two fields (it does link[0]->[1] = link[1] and link[1]->[0] = link[0]),
// so the code does not prove which one is "forward". `next` is the field that
// traverses, by convention.
class LTWorldTreeLink 0x8 {
    LTWorldTreeLink* next @0x00   // CONFIRMED as the traversal direction from a node head
    LTWorldTreeLink* prev @0x04
}

// A node of the client world tree -- the spatial index LTObjects are bucketed
// into for culling. Structure recovered from LTWorldTree_FindNodeForObject
// (0x46462F, the descent) and LTWorldTree_RemoveObject (0x4645E7, which walks
// UP), then verified against the live tree by walking all 649 nodes from the
// root at once:
//   * 649 nodes reachable, 285 of them holding objects, 2142 objects, depth 5.
//   * occupied_count == the number of OCCUPIED nodes in that node's subtree,
//     itself included: 649/649, zero mismatches. It is NOT an object count --
//     the root reads 285, not 2142 -- which matches RemoveObject decrementing
//     only when a node's list becomes EMPTY.
//   * parent_offset resolves to the actual parent on 649/649 (0 at the root).
//   * child_offset reproduces the whole tree: the four children live at
//     node + 24*(child_offset + k) for k in 0..3, and 0 means leaf.
//
// It splits on X and Z only -- Y is never divided -- so this is a QUADTREE over
// the ground plane, not an octree.
class LTWorldTreeNode 0x18 {
    LTWorldTreeLink objects   @0x00   // CONFIRMED: head of this node's object list; objects link in at LTObject.world_tree_link (+0xC4)
    float split_x             @0x08   // CONFIRMED as a descent comparand: compared against the object's aabb_min.x / aabb_max.x
    float split_z             @0x0C   // CONFIRMED as a descent comparand, against aabb_min.z / aabb_max.z
    uint32_t occupied_count   @0x10   // CONFIRMED 649/649 == occupied nodes in subtree (see above)
    uint16_t parent_offset    @0x14   // CONFIRMED 649/649; parent is `this - 24*parent_offset`, and 0 marks the root
    uint16_t child_offset     @0x16   // CONFIRMED; children at `this + 24*(child_offset + k)`, k in 0..3. 0 == leaf.
}

// NOT claimed: that every object on an INTERNAL node straddles one of that
// node's split planes. The descent inserts at a node when the object's AABB
// crosses a plane, so that would be the tidy story, but live only 332 of 467
// internal-node objects straddle. The counter-examples sit at the root while
// lying wholly inside one quadrant, which is what an object that MOVED after
// being linked looks like -- SetPos updates the AABB and the tree link is only
// revisited when renderability changes. Do not "fix" this by loosening the
// test; it is a property of when the engine re-inserts, not of the layout.

// A vector-like container of 4-byte elements, embedded in CClientMgr @0x68.
// CONFIRMED by its two accessors, which the engine uses on this object:
//   size():       dump 0x61C92C -- `v1 = this[1]; return v1 ? (this[2]-v1)>>2 : 0`
//   operator[]():  dump 0x46D362 -- `if (i >= size()) invalid_parameter();
//                                    return this[1] + 4*i`
// so begin is at +0x04 and end at +0x08, elements 4 bytes wide. dump
// 0x44ED89 uses `g_pClientMgr + 104` (this object) as a drop-in FALLBACK
// for `dword_6F3080 + 1064`, which is what pins it as this shared container
// type rather than something CClientMgr-specific.
//
// header: the DWORD at +0x00 is NOT part of begin/end. Its low byte is read
// and cleared as a flag by dump 0x40CB42 (`if (this[104]) {...}
// this[104] = 0;`). Read 0 live. Whether the upper 3 bytes are part of the
// same flag word, padding, or something else is unverified.
//
// Size 0xC covers only the three confirmed DWORDs -- a capacity/allocator
// field may follow; not investigated.
class CClientMgrPtrVector 0xC {
    uint32_t header @0x00   // low byte used as a commit-and-clear flag (dump 0x40CB42); rest unverified
    void** begin    @0x04   // CONFIRMED via size()/operator[] (dumps 0x61C92C / 0x46D362)
    void** end      @0x08   // CONFIRMED via size() (dump 0x61C92C)
}

// Object type. The VALUE SPACE is confirmed: CClientMgr.object_lists has
// exactly 7 buckets (0..6), every object's .type equals its bucket index
// (0 mismatches / 3490 live objects, single traversal), and each bucket
// holds exactly one distinct vtable with ZERO vtables shared between
// buckets (914/183/1476/221/-/474/222 objects behind vtables 0x00672360 /
// 0x006736B0 / 0x006776E8 / 0x00671018 / - / 0x00677728 / 0x00670FD8).
// That proves one concrete class per bucket.
//
// The NAMES below are SOURCE-ANALOGUE ALIASES, not FEAR2-confirmed. They
// come from lithtech/sdk/inc/ltbasedefs.h's object-type enum (OT_NORMAL..
// OT_PARTICLESYSTEM occupy exactly 0..6 there, and FEAR2 has exactly 7
// buckets -- a strong structural match). Per AGENT.MD rule 9 the FEAR1/
// LithTech sources are analogues for NAMING ONLY, never ground truth for
// this build, and two observations argue for caution: OT_LIGHT (4) held
// ZERO objects in a fully-loaded scene, and OT_CAMERA (5) held 474 --
// unexpected if those labels are literal. Treat a name here as "the
// LithTech slot with this index", not as a verified FEAR2 semantic.
// RTTI is stripped from the shipping build, so the real class names could
// not be recovered that way.
enum LTObjectType : uint8_t {
    OT_NORMAL = 0,
    OT_MODEL = 1,
    OT_WORLDMODEL = 2,
    OT_SPRITE = 3,
    OT_LIGHT = 4,
    OT_CAMERA = 5,
    OT_PARTICLESYSTEM = 6,
}

// 3-float vector. Confirmed by content: LTObject.position below reads as
// plausible world coordinates (e.g. 3640.5, 1424.0, -1765.8) across every
// sampled object.
class LTVector 0xC {
    float x @0x00
    float y @0x04
    float z @0x08
}

// 4-float quaternion. CONFIRMED BY INVARIANT, not by guess: sampled the
// 4 floats at LTObject+0x20 across 3506 live objects and computed the
// magnitude -- 3506/3506 (100.0%) were unit-length within 1e-2. Random
// memory does not do that; only a real normalized quaternion does.
class LTRotation 0x10 {
    float x @0x00
    float y @0x04
    float z @0x08
    float w @0x0C
}

// The engine's client-side object (LithTech "LTObject"). CClientMgr keeps
// every one of these in the 7 type-bucketed lists at CClientMgr+0x00 (see
// CClientMgr.object_lists).
//
// CONFIRMED LIVE across 3506 objects walked from all 7 lists in one
// snapshot (main menu):
//   - vtable: 3506/3506 (100.0%) point inside FEAR2.exe's image.
//   - rotation: 3506/3506 (100.0%) unit-length quaternion (see LTRotation).
//   - type: the byte at +0x10 EQUALS THE INDEX OF THE LIST the object was
//     found in. Per-type counts matched per-list counts exactly for lists
//     0/2/3/5 (914, 1480, 220, 474); lists 1 and 6 drifted slightly (192 vs
//     202, 226 vs 264) purely because the game is LIVE and creating/
//     destroying objects between the two walks. That is what makes
//     "object_lists is bucketed BY TYPE" a confirmed fact rather than a
//     hypothesis.
//
// list_link @0xAC: CONFIRMED -- every list walker in the engine recovers the
// object base as `link - 172` (dump 0x40B52A `v3 = v2 - 172`, dump 0x40D065
// `j - 172`). The lists thread through THIS field, not the object base.
//
// handle @0x12: CONFIRMED sentinel semantics -- dump 0x40B287 does
// `v2 = *(WORD*)(a1+18); if (v2 != 0xFFFF) sub_40A4A8(v2);` i.e. 0xFFFF
// means "no handle". Sampled object read exactly 0xFFFF.
//
// position/rotation: offsets confirmed by the quaternion invariant above
// (a wrong offset would not produce 100% unit-length) plus plausible
// world-coordinate content in position. What they are RELATIVE TO (world
// origin? parent?) is not investigated.
//
// unk_38: CONFIRMED as a pointer the engine treats as owned/refcounted --
// dump 0x40B287 and 0x40D065 both pass `*(a1+56)` to sub_445B16 during
// teardown; 0x40B287 also tests `*(BYTE*)(*(a1+56)+47) & 1`. Pointee not
// mapped.
//
// flags @0x44: CONFIRMED as a bitfield -- dump 0x40B287 tests
// `(*(WORD*)(a1+68) & 0x600) != 0`. Individual bit meanings unverified.
//
// unk_D8: RELOCATED OUT OF THIS CLASS. It is only touched when type == 6
// (dump 0x40B287 passes it to off_6ECC90's vtable slot 50, then zeroes it),
// and the allocator evidence below proves why: at +0xD8 it lies OUTSIDE a
// base LTObject entirely. It is a field of the particle-system subclass
// (264 bytes), not of LTObject (204). Left unmapped rather than guessed at
// on a subclass that has no other mapped field yet.
//
// SIZE 0xCC (204) is the ALLOCATION SIZE the engine requests for a type-0
// object -- not a proven nominal C++ `sizeof` of a base subobject. Stride and
// allocator size cannot distinguish "sizeof(LTObject)" from "sizeof(whatever
// concrete class OT_NORMAL uses)"; OT_NORMAL objects are plain base objects in
// the reference SDK, which makes them the same thing there, but that is
// analogue reasoning and stays labelled as such. Treat 0xCC as a hard upper
// bound for anything overlaid on a type-0 object.
//
// Derived from the engine's own per-type pool allocators (see
// CClientMgr.object_banks):
//   * CClientMgr's bank for OT_NORMAL records element_size 204, and its pool
//     has block_size 208 == (204 + 8) & ~7.
//   * Live, the MINIMUM address spacing between two OT_NORMAL objects is
//     exactly 208 across 919 objects -- consecutive slots in that pool.
//   * That bank's chunk contains ONLY type-0 objects (56 in-chunk, 0 of any
//     other type), so the size belongs to type 0 specifically.
//   * Every field mapped below ends at or before 0xB4, well inside 204.
//
// The other types' allocation sizes come from the same source (element_size
// per bank): OT_MODEL 408, OT_WORLDMODEL 316, OT_SPRITE 340, OT_CAMERA 320,
// OT_PARTICLESYSTEM 264. Those are the derived classes; only the shared
// prefix is mapped here, and no derived field is claimed.
//
// The per-object spatial/visibility record LTObject.spatial_record points at.
// Declared BEFORE LTObject because genny resolves types in file order and
// LTObject holds a pointer to this; `object` below is therefore void* rather
// than LTObject*, since typing both directions would be circular.
//
// The size here is the MAPPED EXTENT, not a proven class size: the true size is
// unknown, fields beyond +0x3C exist (0xFFFFFFFF was observed at +0x40), and
// parts of the layout are type-dependent.
//
// Its HEAD holds the CULL VOLUME the object's vtable slot 2 produced -- that is
// how the volume reaches the spatial queries. Verified against the typed sources
// on every live object, per type:
//   OT_NORMAL          919/919   all six floats zero -- slot 2 returns 0
//   OT_MODEL           193/193   position + vis_radius*scale (sphere branch)
//   OT_WORLDMODEL     1472/1473  aabb_min / aabb_max
//   OT_SPRITE          224/224   both kinds -- AABB fields, or position + radius
//   OT_CAMERA          474/474   aabb_min / aabb_max
//   OT_PARTICLESYSTEM  278/278   both kinds, offsets added to position
// The single OT_WORLDMODEL exception is the level-geometry object, whose flags3
// bit 0x80 makes slot 2 return 0, so there is no unexplained residue.
//
// This is the strongest cross-check in the schema so far, because the engine
// wrote these bytes independently of the fields they are compared against: it
// ties LTObject's position/aabb_min/aabb_max/scale, LTModelObject's vis_radius,
// LTSpriteObject's kind/aabb/radius and LTParticleSystemObject's
// cull_volume_type/offsets to one separate copy of the same values. A single
// moved offset in any of those breaks it.
// One object<->hit association. Each entry is a member of TWO lists at once,
// with DIFFERENT linkage disciplines, which is why it carries two link groups:
//   * the RECORD's list -- singly linked through record_next, head at
//     LTSpatialRecord.entry_list, length counted in LTSpatialRecord.entry_count.
//   * the HIT's list -- doubly linked through hit_prev/hit_next, whose head
//     lives elsewhere and is reached through hit_head. Being doubly linked is
//     what lets LTSpatialRecord_DetachEntries unlink an entry from the hit side
//     without walking that list.
//
// Structure recovered from LTSpatialRecord_LinkEntry (0x4456DB) and
// LTSpatialRecord_DetachEntries (0x44559D), then verified live over every object:
//   * entry->record == the record that lists it, 3583/3583 records clean.
//   * hit-side links are mutually consistent -- for every entry, hit_next's
//     hit_prev points back, hit_prev's hit_next points back, and an entry with
//     no hit_prev is the one its hit_head points at: 3583/3583.
// Size is the mapped extent; LinkEntry writes exactly these five fields.
class LTSpatialEntry 0x14 {
    void* record            @0x00   // CONFIRMED: the owning LTSpatialRecord. void* to avoid a circular type reference.
    void** hit_head         @0x04   // CONFIRMED: points AT the hit's list-head slot, not at the head element -- DetachEntries writes `*hit_head = hit_next` when this entry is first. The hit itself is unmapped.
    LTSpatialEntry* record_next @0x08   // CONFIRMED: next entry in the RECORD's list (singly linked)
    LTSpatialEntry* hit_prev @0x0C   // CONFIRMED: previous entry in the HIT's list
    LTSpatialEntry* hit_next @0x10   // CONFIRMED: next entry in the HIT's list
}

// (record class continues below)
class LTSpatialRecord 0x40 {
    float volume[6]     @0x00   // CONFIRMED: sphere shapes use [0..2] centre + [3] radius; AABB shapes use [0..2] min + [3..5] max. WHICH shape applies is a property of the owning object, not of any field here.
    uint16_t entry_count @0x30  // CONFIRMED uint16: LinkEntry increments it per entry and DetachEntries zeroes it alongside entry_list. Live it equals the walked length of entry_list on 3583/3583 records -- so it is a maintained count, not a hint. Note the upper half of this dword is a SEPARATE field (live 0x9249 on many records), which is why this is 16-bit.
    uint8_t client_flags @0x2F  // CONFIRMED as the engine's FOURTH flag kind. LTObject_SetFlagsByType (0x44E53B) routes kind 3 here -- `if (obj->flags3 & 0x400) *(uint8_t*)(record + 0x2F) = value` -- and the reference SDK's matching enum names kind 3 OFT_Client ("client flags, not available on server objects"). So the client flags live on the RECORD, not on the object, which is why they were not found alongside flags/flags2/user_flags. Bit meanings unmapped, and note the write is gated on flags3 bit 0x400 (set on 3583/3583 live).
    void* object        @0x38   // CONFIRMED backpointer to the owning LTObject on 3583/3583. void* only to avoid a circular type reference; it is always an LTObject*.
    LTSpatialEntry* entry_list @0x3C   // CONFIRMED head of this record's association list, rebuilt by LTSpatialRecord_CollectSphere / _CollectAABB. Live totals: 3666 entries across 3583 records, 1699 of them empty. Per type -- OT_SPRITE 1215 entries over 224 objects, OT_WORLDMODEL 1821/1473, OT_PARTICLESYSTEM 336/278, OT_MODEL 294/215, and ZERO for OT_NORMAL and OT_CAMERA. GATED, and this is what makes the two zeroes different: LTObjectOwner_UpdateSpatialRecord only collects when `(flags & 1) && !(flags2 & 0x700)` -- otherwise it calls LTSpatialRecord_Release and the list stays empty. Live the gate is NECESSARY: 1884 records hold entries and every one satisfies it, with 0 counter-examples out of 3583. It is not sufficient -- 40 gated objects still hold nothing, because their volume can miss every sector. OT_NORMAL's zero is because slot 2 returns no volume at all (only 2 of its 919 even pass the gate). OT_CAMERA's zero, which an earlier pass left as "unexplained", is the gate: ZERO of the 474 cameras have flags bit 0 set. It is not geometric -- 459 of their volumes do overlap at least one sector. So cameras are renderable via flags 0x800 and world-tree linked, yet never visibility-associated.
}

// One clipping plane of a visibility sector. Stride is 20 bytes, taken from the
// test loop's `v7 += 20` in LTVisSector_TestSphere.
//
// CONFIRMED live: across every sector that has planes (19 of 263), all normals
// are unit length to within 0.01. That is the check that makes the normal/
// distance split real rather than assumed -- a wrong offset would give lengths
// scattered around arbitrary values.
class LTVisPlane 0x14 {
    LTVector normal   @0x00   // CONFIRMED unit length on every plane of every sector that has any
    float distance    @0x0C   // CONFIRMED: the test compares a point-distance against this
    uint32_t unk_10   @0x10   // unmapped; part of the 20-byte stride
}

// A visibility sector: a convex region described by an AABB plus optional
// clipping planes, holding the list of objects currently associated with it.
// This is the far end of LTSpatialEntry.hit_head -- the thing objects associate
// WITH.
//
// Layout from LTVisSector_TestSphere (0x445F38), which AABB-tests `hit + 0x04`
// and then walks `*(uint8*)(hit + 0x24)` planes from `*(hit + 0x28)`. That also
// pins entry_list at +0x00, since the entry's hit_head values ARE sector
// addresses and the six floats immediately after them are the AABB.
//
// CONFIRMED live -- the sectors form one contiguous array, and the association
// is verified from BOTH ends:
//   * 263 records at stride 48 starting at a single base, every AABB ordered
//     (min <= max componentwise).
//   * Walking each sector's OWN list via hit_next reached 3666 entries, exactly
//     the 3666 the object side produced, and 263/263 sectors' lists were
//     set-equal to the entries that name them. Neither side has an entry the
//     other does not.
// Sector occupancy is very uneven: the busiest holds 197 entries, and 1699 of
// the 3583 object records associate with nothing at all.
class LTVisSector 0x30 {
    LTSpatialEntry* entry_list @0x00   // CONFIRMED: head of this sector's entry list, threaded through LTSpatialEntry.hit_prev/hit_next. LTSpatialEntry.hit_head points AT this slot.
    LTVector aabb_min   @0x04   // CONFIRMED: AABB-tested by LTVisSector_TestSphere; ordered against aabb_max on 263/263
    LTVector aabb_max   @0x10   // CONFIRMED
    float unk_1C        @0x1C   // unmapped; live 0.1 on a sampled record
    uint32_t unk_20     @0x20   // unmapped; live 0 or 1
    uint8_t plane_count @0x24   // CONFIRMED: the plane loop's bound, read as a BYTE. Live, only 19 of 263 sectors have any planes -- the rest are AABB-only, which is why the loop is skipped for them.
    LTVisPlane* planes  @0x28   // CONFIRMED: base of the plane array walked at stride 20
    void* unk_2C        @0x2C   // unmapped; on the sampled record it held the same value as planes
}

// A node of the visibility KD-tree. Layout from LTVisTree_QuerySphere (0x4458D2)
// and LTVisTree_QueryAABB (0x445825), which are the same walk over a sphere or
// an AABB.
//
// split_axis doubles as the LEAF MARKER: the walk treats any value > 2 as "no
// split here, pop the stack", so a leaf is encoded by putting an out-of-range
// axis in the field rather than by a separate flag.
//
// CONFIRMED live by walking from LTVisTree.root: 111 nodes reached, depth 7,
// yielding 263 distinct elements -- every one of them a correctly-aligned entry
// of LTVisTree.sectors, with none outside it. The node count matched
// LTVisTree.node_count exactly.
class LTVisTreeNode 0x18 {
    LTVisSector** elements @0x00   // CONFIRMED: array of sector pointers held at this node
    uint32_t element_count @0x04   // CONFIRMED: its length; the walk tests each element against the query volume
    LTVisTreeNode* child_a @0x08   // CONFIRMED: taken when the query lies on one side of the split
    LTVisTreeNode* child_b @0x0C   // CONFIRMED
    uint32_t split_axis    @0x10   // CONFIRMED: 0/1/2 index the query volume's components; > 2 means LEAF
    float split_value      @0x14   // CONFIRMED: compared against the query volume's component on split_axis
}

// A visibility PORTAL: the connection between two sectors, and the other half of
// the visibility graph. 344 of them live, joining 262 of the 263 sectors (one
// sector has no portals at all).
//
// Found by resolving what LTVisTree's unmapped +0x00/+0x10 pair pointed at. The
// stride is pinned by arithmetic rather than guessed: the region between the
// pointer table and the sector array is 31648 bytes for 344 entries, exactly
// 92 = 0x5C each, and the mapped fields below fill that to the byte.
//
// CONFIRMED live on all 344, with no exceptions:
//   * plane_normal is unit length.
//   * center lies ON the plane -- dot(plane_normal, center) == plane_distance.
//   * sector_a and sector_b are both aligned entries of LTVisTree.sectors, and
//     no portal joins a sector to itself.
//   * vertex_count is 4 on every single one, and all four vertices satisfy the
//     plane equation.
// An earlier guess that this region held bare 4-vertex quads was WRONG and was
// tested: read as 12 floats only 45 of 344 were coplanar. The quads are real but
// they start at +0x2C, behind the plane and the sector pair.
class LTVisPortal 0x5C {
    LTVector plane_normal  @0x00   // CONFIRMED unit length 344/344
    float plane_distance   @0x0C   // CONFIRMED: center and all four vertices satisfy dot(n,p) == this
    LTVector center        @0x10   // CONFIRMED on-plane point; a centroid by position, though nothing read so far proves it is the exact centroid
    float radius           @0x1C   // bounding radius about center; magnitude is plausible (1030..2154 live) but no reader has been traced
    LTVisSector* sector_a  @0x20   // CONFIRMED aligned sector pointer
    LTVisSector* sector_b  @0x24   // CONFIRMED aligned sector pointer, never equal to sector_a
    uint32_t vertex_count  @0x28   // CONFIRMED == 4 on 344/344. The array below holds exactly 4, so 4 may be a hard maximum rather than a coincidence.
    LTVector vertices[4]   @0x2C   // CONFIRMED: all vertices lie on the plane. Ends at 0x5C == the stride.
}

// The visibility tree manager -- the root of the whole vis subsystem, and the
// reason it can be reached without a pattern scan of its own.
//
// IT IS AN EMBEDDED SUB-OBJECT of the IWorldClientBSP instance, at +0x24:
// that interface's vtable slot 14 is literally `return this + 36`. So
// `interfaces::IWorldClientBSP::get() + 0x24` is the manager, and
// LTObjectOwner_UpdateSpatialRecord obtains it exactly that way before calling
// LTSpatialRecord_CollectSphere / _CollectAABB.
//
// CONFIRMED live, and this is what closed the loop on the sector array: reading
// the header gave the SAME array base (sectors) that an earlier pass had found
// only by scanning outwards from a known slot, plus the count as a field instead
// of an inference.
//   * sectors == the scanned base, sector_count == 263 == the scanned record count.
//   * walking root reached 111 nodes -- equal to node_count -- and 263 distinct
//     elements, all of them aligned entries of sectors, none outside.
//   * LTVisTree_Root is `if (this[6]) return this[5]; else return 0`, i.e. it
//     gates the root on node_count being non-zero. An earlier note called +0x18
//     a "validity flag"; it is the node count, used as a truthiness test.
//
// Size is the mapped extent. unk_00/unk_0C hold the same pointer live and
// unk_10 reads 344, which looks like a second array/count pair, but nothing
// read so far touches them so no claim is made.
class LTVisTree 0x24 {
    LTVisPortal** portals   @0x00   // CONFIRMED: a table of portal_count pointers, immediately followed in memory by the portals themselves and then by `sectors` -- one contiguous allocation. Every pointer equals `table_end + i*0x5C` in order, 344/344.
    LTVisSector* sectors    @0x04   // CONFIRMED: base of the sector array (stride 0x30)
    uint32_t sector_count   @0x08   // CONFIRMED == 263 live, matching the array's extent
    void* unk_0C            @0x0C   // unmapped; live equals unk_00
    uint32_t portal_count   @0x10   // CONFIRMED == 344 live. The arithmetic is exact: 344 pointers (0x560 bytes) + 344 portals (0x5C each) lands precisely on `sectors`.
    LTVisTreeNode* root     @0x14   // CONFIRMED: LTVisTree_Root returns this when node_count is non-zero
    uint32_t node_count     @0x18   // CONFIRMED == 111 live, exactly the nodes reached by walking root
    void* traversal_stack   @0x1C   // CONFIRMED: the queries push deferred children here (`v4[7]`)
    void* unk_20            @0x20   // unmapped
}

// The client-side world container: the engine object behind the
// IWorldClientBSP interface. A STATIC INSTANCE in FEAR2.exe's data, whose
// address the interface holder points at.
//
// Reading this header replaced two earlier inferences with fields, and gave the
// world tree a named-global route it did not have before:
//   * bounds_min/max at +0x04 hold the same values as the pair at +0x22C that
//     IWorldClientBSP_IsPointOutsideWorld reads. TWO COPIES, live identical.
//     The slot-16 test uses the +0x22C pair, so that is the authoritative one
//     for "is this point outside the world".
//   * world_tree_root / world_tree_node_count: an earlier pass found the world
//     tree only by climbing parent_offset from a linked object, and counted its
//     nodes by walking. Both are fields here, and both agree exactly -- 649
//     nodes walked == the stored count, and the stored root IS the address that
//     climbing from objects reaches. Two independent routes, same answer.
//   * vis_tree is EMBEDDED at +0x24, which is what IWorldClientBSP's vtable
//     slot 14 returns (`return this + 36`).
//
// world_path is the loaded world file: live
// "worlds\sp\m05_outershell\m05_outershell.wld". Worth knowing for what the
// "main menu" actually is -- a real level is loaded, which is why 3583 objects
// and 263 vis sectors exist there at all.
//
// Size is the MAPPED EXTENT and the true class is certainly larger; the
// world_path array length is the observed string plus its terminator, NOT a
// proven buffer capacity.
class LTWorldClientBSP 0x244 {
    void* vftable              @0x00 [[code]]   // CONFIRMED: live 0x6775F0, and slots 7/13/14/16 are mapped
    LTVector bounds_min        @0x04   // CONFIRMED: equals the +0x22C copy live
    LTVector bounds_max        @0x10   // CONFIRMED
    uint32_t world_tree_node_count @0x1C   // CONFIRMED == 649 live, exactly the nodes reached by walking world_tree_root
    LTWorldTreeNode* world_tree_root @0x20   // CONFIRMED: the same root that climbing LTObject.world_tree_link's parent chain reaches
    LTVisTree vis_tree         @0x24   // CONFIRMED embedded sub-object: IWorldClientBSP vtable slot 14 is `return this + 36`
    uint8_t unk_48             @0x48   // vtable slot 7 returns this byte (IWorldClientBSP_GetFlag48); live 1
    uint8_t unk_49             @0x49   // live 1
    char world_path[44]        @0x4A   // CONFIRMED: the loaded .wld path. Length is the observed string + NUL; the real buffer is probably larger and its capacity is unverified.
    LTVector bounds_min_2      @0x22C  // CONFIRMED: the pair IWorldClientBSP_IsPointOutsideWorld actually reads
    LTVector bounds_max_2      @0x238  // CONFIRMED
}

// NOT an invariant: object positions lying inside the world bounds. Live it is
// 3579 of 3583, and all 263 vis-sector AABBs fit, but four objects sit outside.
// That is consistent with the engine's own behaviour -- the outside-world test
// exists precisely because objects can leave, and LTObjectOwner_OnObjectChanged
// has a "pin objects that have gone outside the world" path -- so the rate is
// recorded rather than asserted.

// The refcounted record LTObject.shared_ref points at. Reached only from there,
// and only on OT_MODEL objects (36 of 215 live).
//
// Size is the MAPPED EXTENT; the true size is unknown.
//
// What is proven is the LIFETIME MECHANISM, not the payload. The base destructor
// calls 0x415B43 on this, which is `if (--refcount == 0) release(this)`, so it is
// shared and counted. Live refcounts are 1 (x21), 3 (x11) and 35 (x4) -- small,
// positive, and varied, which is what a real count looks like.
//
// The records are threaded among THEMSELVES through +0x00/+0x04: following those
// from one record walks to the others. +0x08 and +0x1C both hold the record's own
// address, and +0x0C/+0x10 are a self-pointing pair (an empty list head).
// Nothing here identifies what resource it represents.
class LTObjectRef 0x28 {
    LTObjectRef* link_prev @0x00   // CONFIRMED: records point at each other through this pair
    LTObjectRef* link_next @0x04   // CONFIRMED
    void* self_08          @0x08   // CONFIRMED == this record's own address
    void* unk_0C           @0x0C   // self-pointing pair with unk_10 -- an empty embedded list head
    void* unk_10           @0x10
    void* unk_14           @0x14   // unmapped heap pointer
    void* unk_18           @0x18   // unmapped heap pointer
    void* self_1C          @0x1C   // CONFIRMED == this record's own address (a second copy)
    uint32_t unk_20        @0x20   // live 0xFFFFFFFF on every sampled record
    uint32_t refcount      @0x24   // CONFIRMED: 0x415B43 decrements this and releases at zero. Live 1/3/35.
}

// ---- The base virtual interface (from the six object vtables) --------------
//
// Type <-> vtable is 1:1: walking all seven object_lists[] buckets, each type's
// objects share exactly ONE vtable (3583 live objects, single traversal):
//   OT_NORMAL 0x672360   OT_MODEL 0x6736B0   OT_WORLDMODEL 0x6776E8
//   OT_SPRITE 0x671018   OT_CAMERA 0x677728  OT_PARTICLESYSTEM 0x670FD8
// OT_LIGHT has no live objects and therefore no observed vtable.
//
// 0x672360 (OT_NORMAL's) IS the base LTObject vtable: the base destructor body
// at 0x42050E and the base constructor at 0x420408 both install it. So type 0
// is a plain LTObject and the other five are derived classes. WORLDMODEL and
// CAMERA differ from each other in only slots 0 and 1.
//
// The base methods live in 0x4200A0..0x4206E8. Known slots:
//   1 = Init(owner, createStruct)     8 = SetFlags(uint32 -> +0x3C)
//   3 = SetPos(vec3)                  9 = SetFlags2(uint16 -> +0x44)
//   4 = SetRotation(quat)             6 = sets the float at +0x30
//   7 = SetPosRot(vec3, quat)
// Each notifies owner->slot4(this, code) with a CHANGE CODE, decoded from the
// call sites: 2 = position, 4 = rotation, 6 = both, 8 = flags, 0x10 = +0x30,
// 0x4000 = dims. Slots 10-15 of the simple types are ICF-folded shared stubs
// (0x651914 is `nullsub`, reached from 55 different vtable slots) -- see
// AGENT.MD on not over-claiming from folded bodies.
class LTObject 0xCC {
    void* vtable          @0x00 [[code]]
    uint32_t unk_04       @0x04   // ctor writes all four bytes as 0xFF. Live 0xFFFFFFFF on 3265/3583, with 119 distinct other values on the remaining 318 -- so it is a real field with a -1 "none" default, not padding. Meaning unmapped.
    LTObjectRef* shared_ref @0x08   // CONFIRMED a pointer to a REFCOUNTED record: the base dtor (LTObject_dtor_body) branches on it and calls 0x415B43, which is `if (--pointee[9] == 0) release(pointee)` -- a decrement-and-release on the pointee's +0x24. Live it is non-null on exactly 36 objects, ALL of them OT_MODEL (36 of 215), and the records are threaded among themselves through their own +0x00/+0x04. Refcounts read 1 (x21), 3 (x11) and 35 (x4). WHAT the resource is remains unmapped -- only that it is shared, counted, and released with the object.
    LTObjectType type     @0x10   // CONFIRMED == the index of the object_lists[] bucket holding this object (0 mismatches / 3490 live objects, single traversal). The ctor writes it as a BYTE from its argument.
    uint16_t handle       @0x12   // CONFIRMED: 0xFFFF means "none" (dump 0x40B287, and the ctor initialises it to 0xFFFF)
    LTVector position     @0x14   // CONFIRMED: written component-wise by SetPos (0x4201B8) and SetPosRot (0x4202B6)
    LTRotation rotation   @0x20   // CONFIRMED unit-length in 3506/3506 live samples; the ctor writes (0,0,0,1), pinning w at +0x2C
    float scale           @0x30   // CONFIRMED as a uniform scale, by its READER: OT_MODEL's cull-volume provider (OT_MODEL_GetCullVolume, 0x428FB6) computes its sphere radius as `vis_radius(+0x16C) * this(+0x30)`. That matches the reference SDK's GetRadius() == m_VisRadius * MAX(m_Scale...), except FEAR2 keeps ONE float here rather than the reference's LTVector m_Scale. ctor sets 1.0; virtual slot 6 (LTObject_SetScale, 0x4200BF) is the setter and notifies with change code 0x10. Live it is exactly 1.0 on 3578/3583; the models that differ (1.658/2.493/2.656/3.0/3.19/3.2) multiply a vis_radius of 100.0 into radii of 165.76..320.0, all finite and positive on 193/193 sphere-culled models. An earlier pass called this MEANING UNKNOWN because the models whose value differs all had dims == 0 -- that turned out to be the explanation, not a counter-argument: they are SPHERE-culled, so LTObject_SetDims never runs on them and radius/dims stay at their constructor zeroes.
    void* owner           @0x34   // CONFIRMED: the SAME global for all 3583 live objects -- 0x6ECD2C, a static instance in FEAR2.exe's data (vtable 0x66F86C, constructed by 0x40C4E3). Every base setter reports changes through its vtable; slots 1/2/3/4/6/11/12 are used.
    LTSpatialRecord* spatial_record @0x38   // CONFIRMED per-object and never null (3583/3583); record->object points BACK here on 3583/3583. LTObjectOwner_UpdateSpatialRecord asks the object's own vtable slot 2 for a bounding volume, then calls LTSpatialRecord_CollectSphere / _CollectAABB (or _Release when the object is not renderable), which store that volume on the record and link each spatial hit onto it. NOT a refcount, as an earlier pass guessed. See LTSpatialRecord for the volume evidence. Still unmapped there: record[+0x1C]'s low byte equals this->type on 3465/3583 (118 OT_PARTICLESYSTEM disagree) so that is NOT a type field, and record[+0x34] is NOT a string pointer.
    // flags bit survey (all rates from ONE main-menu snapshot, 3583 objects).
    // These are CORRELATIONS and engine POLICY, not layout -- see
    // MAPPING_WORKFLOW's layout-vs-policy rule. Rates are recorded so a future
    // scene can be compared against them; none is asserted in the fixture except
    // the two mechanism-backed ones called out below.
    //
    // 33 distinct values live. Most common: 0x00000000 x863, 0x00003033 x756,
    // 0x00000800 x473, 0x00003003 x258.
    //
    // TYPE-EXCLUSIVE bits (a bit that only ever appears on one object type):
    //   0x0800  OT_CAMERA, 474/474 AND no other type -- a perfect biconditional
    //           in this snapshot, so it reads as a camera marker. It also sits
    //           inside the renderable mask, which is WHY every camera is
    //           world-tree linked.
    //   0x0008 / 0x0080 / 0x0100 / 0x0200 / 0x20000   OT_MODEL only
    //   0x0040 / 0x2000                               OT_WORLDMODEL only
    //
    // RENDERABILITY. LTObject_IsRenderable is
    //     !(flags & 0x200) && (flags & 0x10C30)
    // and LTObject_SetFlags adds to / removes from the world tree exactly when
    // that predicate flips, which makes the following MECHANISM-backed rather
    // than incidental:
    //   * renderable IMPLIES world-tree linked: 1758/1758, zero counter-examples.
    //   * the converse is FALSE -- 384 objects are linked while not renderable,
    //     so do not turn this into a biconditional. Removal is not as prompt as
    //     insertion (flags2/flags3 changes do not re-run the predicate).
    //   * bit 0x200 (the suppressor) IMPLIES not linked: 27/27, and it is
    //     exercised -- 27 OT_MODELs carry it.
    // Of the mask's bits, the three that occur live (0x10 x1284, 0x20 x860,
    // 0x800 x474) are each 100% world-tree linked; 0x400 and 0x10000 occur on no
    // live object, so their contribution is unexercised.
    uint32_t flags        @0x3C   // CONFIRMED 32-bit (SetFlags does a DWORD read/modify/write; LTObject_IsRenderable reads it as this[15]). Bit 0 is FLAG_VISIBLE: SetFlags special-cases `diff & 1`, and the reference SDK defines FLAG_VISIBLE as (1<<0) -- live it is the single most common bit (1924 objects across five types). ctor zeroes it. See the bit survey above for what else is known, and note that everything there is a rate, not an invariant.
    uint32_t user_flags   @0x40   // CONFIRMED as the engine's THIRD flag kind, and the naming comes from FEAR2's own indexing rather than from guesswork: LTObject_SetFlagsByType (0x44E53B) switches on a kind argument and routes 0 -> vtable slot 8 (SetFlags, +0x3C), 1 -> slot 9 (SetFlags2, +0x44), 2 -> here, 3 -> the byte at spatial_record+0x2F. The reference SDK's matching enum is OFT_Flags / OFT_Flags2 / OFT_User / OFT_Client, so kind 2 is the USER flags word. LTObject_SetUserFlags notifies with change code 8, the same code SetFlags uses. Live: 866 objects read 0, and the rest spread over 68 distinct values (0x4000 x506, 3 x471, 0x4001 x409, 0x21 x357). Bit meanings unverified. NOTE `flags3` at +0x46 is NOT part of this family -- the dispatcher never touches it.
    uint16_t flags2       @0x44   // CONFIRMED 16-bit, and CONFIRMED distinct from `flags` above -- SetFlags2 (0x4200D6) does a WORD read/modify/write here while SetFlags uses the DWORD at +0x3C. Was mapped as `flags` before +0x3C was found. Tested against 0x2/0x600/0x700; bit meanings unverified.
    uint16_t flags3        @0x46  // CONFIRMED 16-bit and distinct from flags2 (SetPos reads it as a separate WORD). Live values: 0x400 x3529, 0x420 x53, 0x490 x1. Bit 0x400 is set on 3583/3583, which is exactly why SetPos's "Object going outside world" branch never runs -- it is gated on that bit being CLEAR, so do not treat the record fields that branch touches as validated. Bit 0x20 is set by LTObject_DetachFromParent. Bit 0x80 means NO CULL VOLUME: LTObject_GetCullVolume_AABB tests the byte here as SIGNED (`(char)this[70] < 0`) and bails when negative, and the single object with that bit set -- the level geometry -- is exactly the single object whose spatial_record volume is all zeros.
    LTVector aabb_min     @0x48   // CONFIRMED == position - dims on 3583/3583 live objects. Written by 0x42015D from SetPos, SetPosRot and SetDims.
    LTVector aabb_max     @0x54   // CONFIRMED == position + dims on 3583/3583 live objects
    float radius          @0x60   // CONFIRMED, and TWO-STATE. SetDims computes sqrt(dot(dims,dims)) and adds the double at 0x66FBB8, which is exactly 0.1 -- but the ctor zeroes both this and dims, so an object SetDims never ran on sits at radius 0 WITH dims 0, not at 0.1. Live partition: 2126 sized (radius == |dims| + 0.1), 1457 pristine (both zero), 0 in neither. My first pass claimed the single formula held on 3583/3583 -- that was wrong, produced by a check with a 1.0-wide acceptance window; the fixture's tighter assertion caught it. Do NOT re-widen the tolerance to make one formula fit.
    LTVector dims         @0x64   // CONFIRMED half-extents: SetDims (0x420358) stores its argument here and derives the AABB as position +/- it. All three components are >= 0 and bounded on 3583/3583.
    float unk_70          @0x70   // ctor zeroes it and live it is still exactly 0.0 on 3583/3583, so nothing in a loaded level writes it. Do not read that as "unused": it means unexercised at the states sampled.
    CClientMgrListLink child_list @0x74   // CONFIRMED: head of THIS object's list of attached children. LTObject_DetachAllChildren (0x4205BC) walks it from +0x78 and detaches every entry. Reusing CClientMgrListLink is correct here on FIELD ORDER (prev@0x00 / next@0x04, verified by that walk) -- unlike LTWorldTreeLink, which is reversed. The type name is narrower than the concept: this is the engine's generic intrusive link, used by CClientMgr's buckets AND here.
    CClientMgrListLink parent_link @0x7C  // CONFIRMED: THIS object's link into its PARENT's child_list. LTObject_SetParent (0x4205D8) inserts it at parent+0x74 and LTObject_DetachFromParent (0x420585) removes it, then sets flags3 bit 0x20. Live biconditional: parent == nullptr on 3582/3582 objects whose link is self-pointing, and the one parented object's link IS present in its parent's child_list (1/1).
    void* self               @0x84   // CONFIRMED == this object's own address on 3583/3583. Not vestigial: it exists so a child_list walker can recover the OBJECT from a bare parent_link -- LTObject_DetachAllChildren reads link[2], which is exactly this field at parent_link + 0x08.
    LTObject* parent         @0x88   // CONFIRMED: written by LTObject_SetParent, cleared by LTObject_DetachFromParent, and used as that function's gate. Live, every child reached by walking a child_list names its walker here (1/1 -- see the population caveat below).
    uint32_t attach_extra    @0x8C   // CONFIRMED written alongside parent by LTObject_SetParent (its third argument) and zeroed by LTObject_DetachFromParent, so it is per-attachment state. Meaning unverified -- a socket/node index would fit the engine's attachment model but nothing read so far consumes it.
    // slot_index's WRITER IS NOT IDENTIFIED, and one plausible candidate has
    // been RULED OUT by measurement. Recorded so nobody re-walks this path:
    //
    // SlotIndex_AcquireOrRelease (0x444B9B) is a textbook acquire/release on a
    // +0xA8 field -- it calls SlotTable_Acquire (0x459CB3) when a predicate holds
    // and no slot is held, and SlotTable_Release (0x4599DC) plus a -1 store when
    // the predicate fails. Its gate, SlotIndex_WantsSlot (0x44365E), even reads
    // offsets that look exactly LTObject-shaped: a BYTE type at +0x10, +0x38, a
    // DWORD flag word at +0x3C, a WORD flag word at +0x46, and +0xEC.
    //
    // But transcribing that predicate and evaluating it over live memory gives
    // TRUE on 0 of 3583 objects, while 3248 hold slots. The blocker is its
    // `flags3 & 4` clause, which passes on 0/3583 -- every OTHER clause passes on
    // 2138..3583. So either it operates on a different class that happens to
    // share the layout, or it is a real LTObject path for a state that does not
    // occur at the main menu; either way it did NOT assign the values that are
    // there. A scan for writes to [reg+0xA8] found 70 sites across many unrelated
    // classes, so offset coincidence is the likely explanation.
    uint32_t slot_index   @0xA8   // CONFIRMED uint32, NOT a float. The ctor's value renders as `NAN` in the decompiler because the constant is 0xFFFFFFFF, and read as a float the live values are denormals (max 5.4e-42) -- which is what exposed the mistake. Read as uint32: 0xFFFFFFFF on 335 objects (a "none" sentinel), and on the other 3248 the values are ALL DISTINCT (3248 distinct values, zero duplicates) in the range 0..3885. So this is a unique per-object slot index into some ~3886-entry table. It is NOT `handle`: it matches +0x12 on 0/3248. Which table it indexes is unmapped.
    CClientMgrListLink list_link  @0xAC   // CONFIRMED: the object_lists[] threading point (walkers do `link - 172`); the ctor self-points it, matching an unlinked object
    CClientMgrListLink owned_list @0xB8   // CONFIRMED list head, self-pointed by the ctor, and CONFIRMED NON-EMPTY in practice: 1931 of 3583 live objects hold entries, 3260 entries in total (by owner type: 1168 OT_NORMAL, 910 OT_MODEL, 662 OT_WORLDMODEL, 474 OT_CAMERA, 45 OT_SPRITE, 1 OT_PARTICLESYSTEM). An earlier draft of this comment claimed every list was empty -- that was written without checking and was wrong. LTObject_ReleaseOwnedList (0x4206E8) drains it, recovering each element as `link - 4` (the element's own link pair sits at element+0x04/+0x08) and calling the element's vtable slots 3 and 1. The recovery is right and the elements ARE vtable-bearing: the three dominant vtables (x2372, x534, x346) are heap addresses whose slots point into GameClient.dll, so these are GAME-side objects owned by an engine object -- the engine/game boundary showing up in data. 7 more entries use an exe-side vtable at 0x66F6A0. Element layout unmapped.
    LTWorldTreeLink world_tree_link @0xC4   // CONFIRMED: the world-tree bucket link. Live, 2142 objects are linked and 1441 sit self-pointing (unlinked), and every linked object's list reaches a node whose parent chain terminates at the single root. LTWorldTree_AddObject descends from a node and links here; LTWorldTree_RemoveObject unlinks and decrements occupied_count up the parent chain. Ends at 0xCC == the class size.
}

// LTMemory.dll's fixed-size pool allocator. NOT a FEAR2.exe type -- both
// vtable pointers land inside LTMemory.dll's image (live 0x10004274 and
// 0x10004254, each dereferencing to code in that module), so LTMemory
// constructs these and FEAR2.exe only holds references.
//
// TWO vtable pointers at +0x00/+0x04 = multiple inheritance, which is why this
// is not modelled with a single vptr.
//
// CONFIRMED LIVE:
//   * 277 of these are threaded into one circular doubly-linked list. Walking
//     forward from CClientMgr's first bank returns to its own start after 257;
//     walking backward reaches 20 more and then a non-pool head sentinel in
//     LTMemory.dll's own data (0x100050AC). LTMemory owns the list; FEAR2's
//     six object banks are a subset of it.
//   * The links are at +0x34/+0x38 and point at the NEIGHBOUR'S +0x34, not at
//     its base (obj[i].next == obj[i+1] + 0x34 for every pair walked).
//   * +0x3C holds the object's OWN address (6/6 across CClientMgr's banks).
//   * block_size == (requested element_size + 8) & ~7, exactly, 6/6 -- an
//     8-byte allocation header plus 8-byte alignment.
//   * chunk: the first element slot begins at chunk + 0x10 (a 16-byte chunk
//     header), and slots are block_size apart. Verified by landing exactly on
//     live objects from that slot base.
//
// elems_per_chunk is the best-supported READING of +0x2C, not a proven
// contract: block_size * it clusters just under a page (4032/4048/3960...) for
// 248 of 257 pools and just under 16K for the other 9, so the chunk size is
// not fixed and the name describes the observed relationship only.
class LTMemoryPool 0x40 {
    void* vftable_a          @0x00 [[code]]  // CONFIRMED inside LTMemory.dll (live 0x10004274)
    void* vftable_b          @0x04 [[code]]  // CONFIRMED inside LTMemory.dll (live 0x10004254); multiple inheritance
    uint32_t unk_08          @0x08           // unverified; live 0xFFFFFFFF on all six banks
    uint32_t unk_0C          @0x0C           // unverified; live 0xFFFFFFFF on all six banks
    uint32_t unk_1C          @0x1C           // unverified; live 0x020007D0 identically on all six banks
    uint32_t unk_20          @0x20           // unverified; 1..12 across pools, tracks the chunk-size cluster
    uint32_t unk_24          @0x24           // unverified; live 0x00020001 or 0x00000001
    uint32_t block_size      @0x28           // CONFIRMED == (element_size + 8) & ~7, 6/6
    uint32_t elems_per_chunk @0x2C           // relationship confirmed, contract not -- see above
    void* chunk              @0x30           // CONFIRMED: element slots start at chunk + 0x10, block_size apart
    void* list_prev          @0x34           // CONFIRMED: points at the previous pool's +0x34
    void* list_next          @0x38           // CONFIRMED: points at the next pool's +0x34
    LTMemoryPool* self       @0x3C           // CONFIRMED: equals this object's own address (6/6)
}

// One CClientMgr object-type bank: the LTMemory pool plus the element size
// requested from it. See CClientMgr.object_banks for the type mapping proof.
class CClientMgrObjectBank 0x8 {
    LTMemoryPool* pool     @0x00   // CONFIRMED LTMemory pool (vtables in LTMemory.dll)
    uint32_t element_size  @0x04   // CONFIRMED: pool->block_size == (this + 8) & ~7, 6/6
}

// Row-major 3x4 rigid transform: three rows of (basis.x, basis.y, basis.z, t).
// CONFIRMED as a real transform, not a plane set or a loose float blob -- see
// LTCameraObject, where the 3x3 part was matched against the object's own
// rotation quaternion exactly (max component difference 0.00000 across 40
// objects) with determinant 1.0 across all of them.
class LTMatrix3x4 0x30 {
    float m[12]   @0x00   // row-major; row r = m[r*4 .. r*4+3], translation is m[r*4+3]
}

// The concrete class behind object type 2 -- and, as it turns out, the BASE of
// type 5. 316 bytes (0x13C) from its bank's element_size.
//
// THE HIERARCHY IS PROVEN BY THE DESTRUCTORS, which is also how an earlier
// mis-attribution here was caught. OT_CAMERA_scalar_dtor installs
// vtbl_OT_CAMERA and then calls OT_WORLDMODEL_dtor_body (0x465344), which
// installs vtbl_OT_WORLDMODEL and then calls LTObject_dtor_body. That is the
// MSVC derived-destructor chain, so:
//     LTObject  <-  WorldModel  <-  Camera
// It explains what the vtable survey had already shown without explaining: the
// two types share slots 2..15 and differ only in slots 0 and 1.
//
// The sizes clinch it. WorldModel is 0x13C and the transform pair below ends at
// exactly 0x13C; Camera is 0x140 and adds ONLY a uint16. An earlier pass mapped
// the transform pair onto LTCameraObject as though it were camera-specific --
// wrong, and the fix matters for a mod: 1473 worldmodels carry these matrices,
// not just 474 cameras.
//
// CONFIRMED live on OT_WORLDMODEL (1473 objects):
//   * determinant of world_transform's 3x3 is 1.0 on 1473/1473 -- every matrix
//     is a proper rotation.
//   * the 3x3 equals R(base.rotation) on 1464/1473, and inverse_transform is the
//     exact rigid inverse on 1450/1473. The shortfalls are NOT asserted: a
//     worldmodel is the engine's moving level geometry (doors, lifts), so a
//     cached transform can legitimately lag the quaternion between updates.
//     Cameras show no such lag -- 474/474 on all three.
class LTWorldModelObject 0x13C {
    LTObject base                  @0x00    // CONFIRMED: the first 0xCC bytes are an LTObject
    void* unk_CC                   @0xCC    // CONFIRMED as WorldModel's FIRST own field: OT_WORLDMODEL_dtor_body branches on `this[51]` (+0xCC) and releases it via 0x43B85C, and OT_WORLDMODEL_ctor (0x4651D1) initialises it to null. Live 1034 of 1473 are null and the rest are 439 distinct heap pointers. Pointee unmapped.
    uint16_t unk_D0                @0xD0    // ctor writes 0. Unmapped.
    uint16_t unk_D2                @0xD2    // ctor writes 0xFFFF -- the same "none" sentinel idiom as LTObject.handle. Unmapped.
    uint32_t unk_D4                @0xD4    // ctor writes 0. Unmapped.
    uint32_t unk_D8                @0xD8    // ctor writes 0. Unmapped.
    LTMatrix3x4 world_transform    @0xDC    // CONFIRMED rigid transform; 3x3 == R(base.rotation) on 1464/1473, det 1.0 on 1473/1473. CORROBORATED FROM THE CTOR: OT_WORLDMODEL_ctor calls LTMatrix3x4_SetIdentity (0x421010) on this offset AND on 0x10C -- the same function, on both, which is independent of the destructor/size argument that first established the pair.
    LTMatrix3x4 inverse_transform  @0x10C   // CONFIRMED exact rigid inverse on 1450/1473; also identity-initialised by the ctor (see above). Ends at 0x13C == the class size.
}

// The concrete class behind object type 5. Derives from WorldModel (see above),
// which is why it inherits the cached transform pair and adds only 4 bytes:
// 320 - 316 == the uint16 below plus padding.
//
// NAME IS A LithTech-SDK ANALOGUE (AGENT.MD rule 9): the shipping build has no
// RTTI, so "camera" comes from the reference enum's ordering, not from FEAR2.
// The inherited transform-plus-inverse is exactly a view-matrix pair, which fits
// a camera -- but now that the pair is known to come from WorldModel it is much
// weaker corroboration than it looked, since 1473 worldmodels have it too. 474
// live instances is also more than a player-camera count. Treat the name as a
// label.
//
// On the inherited fields, cameras are the well-behaved case: 3x3 == R(rotation),
// exact inverse and det 1.0 all hold on 474/474.
//
// unk_13C is a uint16 (not a dword): dump 0x46510E writes it as `this[158]`
// through a WORD* -- 158 * 2 == 0x13C -- copying a WORD from another object's
// +0x02. Observed values 1/6/7/9. Role unverified.
class LTCameraObject 0x140 {
    LTWorldModelObject base @0x00    // CONFIRMED: type 5 derives from type 2, proven by the destructor chain
    uint16_t unk_13C        @0x13C   // unverified; written as a WORD by dump 0x46510E. The ONLY field camera adds.
}

// Node CClientMgr registers for itself in its own counter_list_head list
// (see CClientMgr::Init, dump 0x40AEC6, embedded debug string
// "CClientMgr::Init": `v8 = sub_415B54(a1+5100); *(a1+5108) = v8;` -- the
// list-insert call's return value, the raw allocated node, is what
// CClientMgr.own_counter_node points at).
//
// Bytes 0x00-0x13 are the generic list machinery's own bookkeeping
// (allocator header etc.) -- NOT investigated here. self_link @0x14 IS
// investigated (see below).
//
// elapsed_ms/elapsed_time: CONFIRMED CORRELATED live -- sampled
// elapsed_ms=2169885 and elapsed_time=2169.885 in the SAME live snapshot;
// the digits match exactly (elapsed_ms == elapsed_time * 1000), far too
// precise to be coincidence -- both represent the same measurement in
// different units/precision. Read by several small accessor functions
// spread across the engine, not just CClientMgr's own code (dump
// 0x406DED/0x406DFC/0x406E0B/0x4692B1 all read this exact node).
//
// Advancement semantics: UNVERIFIED. The value is not static -- it was
// observed at 2169885 and later at 3243286 in this session. Beyond "it
// changed between observations", nothing about it is established: not the
// rate, not what it measures (wall time? accumulated frame time? time
// since a load/session event?), not its zero point. No controlled
// known-running interval has been measured.
//
// RETRACTED: an earlier note here claimed the value "did NOT advance when
// re-sampled minutes apart". Those samples were taken while the game
// process was suspended, so they say nothing about advancement. Do not
// re-derive that claim without sampling a confirmed-running engine.
//
// Only the elapsed_ms/elapsed_time correlation is confirmed.
//
// unk_28/unk_2C: read by CClientMgr::Update itself (dump 0x40B665) --
// unk_28 gates its FPS-limiter code block (checked truthy); unk_2C is read
// as a float alongside that block's target-frametime computation. Neither
// confirmed beyond "CClientMgr::Update reads and uses it here".
class CClientMgrCounterNode 0x40 {
    CClientMgrListLink self_link @0x14   // CONFIRMED via CClientMgr_Init's insertion code (`*(result+20)=*this`, i.e. this node's OWN link portion begins here) AND live: ADDRESS of this field (own_counter_node+0x14) == the owning CClientMgr.counter_list_head.next exactly (NOT self_link.next -- the field's address itself)
    uint32_t unk_28    @0x28   // gates CClientMgr::Update's FPS-limiter block (checked truthy); role beyond that unverified
    float unk_2C       @0x2C   // read as float in CClientMgr::Update's FPS-limiter block; role unverified
    uint32_t elapsed_ms @0x30   // CONFIRMED correlated with elapsed_time (see above)
    double elapsed_time @0x38   // CONFIRMED correlated with elapsed_ms (see above)
}

// FEAR2.exe's engine-side client manager singleton (see
// shared/sdk/CClientMgr.hpp/.cpp -- already deployed via a hand-derived
// offset before this pass; this formalizes it into the regenny convention).
// Live instance via g_pClientMgr: FEAR2.exe base + RVA 0x2ECCA0
// (FEAR2_dump.exe VA 0x6ECCA0; FEAR2.exe loads at its preferred base
// 0x400000 at runtime -- see AGENT.MD's "IDB truth vs runtime truth" note --
// so the dump VA is directly usable as the RVA source, not just a hint).
//
// client_shell/updating: CONFIRMED live (2026-07) via TWO independent paths
// agreeing exactly: (a) raw memory read through g_pClientMgr -> +0x1434/
// +0x143C, (b) the ALREADY-DEPLOYED sdk::CClientMgr (pre-dating this .genny
// mapping, hardcoded offset 0x1434) reporting the identical addresses live
// via /sdk/targets. Field evidence: CClientMgr::Update (dump 0x40B665).
//
// counter_list_head/own_counter_node: CONFIRMED via CClientMgr::Init (dump
// 0x40AEC6) wiring the two together, live-verified exactly (see
// CClientMgrListLink/CClientMgrCounterNode above).
//
// start_shell_list: CONFIRMED STRUCTURALLY -- CClientMgr::StartShell
// (dump 0x40A90A, embedded debug string "CClientMgr::StartShell") inserts
// 272-byte allocated nodes into a list at this exact offset (found via a
// level/archive file scan -- "Arch01"/findfirst-findclose evidence in that
// function) using the SAME insertion pattern as counter_list_head. Live-
// verified EMPTY at the main menu (next == head, i.e. no entries). Named
// for the confirmed insertion site, NOT "loaded_shell" -- what the 272-byte
// nodes actually represent (levels? archives? something else StartShell
// tracks) is NOT confirmed; node payload not investigated.
//
// object_lists: CONFIRMED, and the biggest find of this pass. An array of
// SEVEN CClientMgrListLink sentinel heads. Static evidence: two independent
// loops iterate them identically -- dump 0x40CB24 (`for (i = 0; i < 0x38;
// i += 8) sub_40B52A(i + g_pClientMgr, 1)`) and dump 0x40D065 (two more
// `i < 0x38; i += 8` loops walking `*(v1+4)` until it returns to the head).
// 0x38 / 8 == 7 heads.
//
// Live: walked all 7 in one main-menu snapshot -- 3490 objects reached,
// every list terminating cleanly back at its own head. The elements are
// LTObjects (see LTObject above), recovered as `link - 172` exactly as the
// engine's own walkers do.
//
// BUCKETED BY TYPE -- PROVEN PER-OBJECT, not inferred from totals: in a
// SINGLE traversal, for every object reached from head N, read that same
// object's LTObject.type and compared it to N.
//   RESULT: 0 mismatches / 3490 objects.
// Because both values come from the same object in the same pass, live
// churn cannot explain the agreement. object_lists[N] holds exactly the
// objects whose .type == N. (Per-list counts in that pass: 914 / 183 /
// 1476 / 221 / 0 / 474 / 222 -- these drift between runs as the game
// creates and destroys objects, which is why the PER-OBJECT check, not the
// totals, is the evidence.)
//
// INVESTIGATED, UNCONFIRMED: an `ObjectMgr` sub-object
// wrapping these lists. The FEAR1/LithTech source drop nests them one level
// deeper -- `CClientMgr::m_ObjectMgr` (clientmgr.h:238),
// `ObjectMgr::m_ObjectLists` (objectmgr.h:90) -- so mirroring that here is
// tempting. Every checkable point of that reference LAYOUT is contradicted
// by FEAR2:
//   1. Reference `ObjectMgr : public WorldTreeHelper` has virtuals
//      (IncFrameCode/GetFrameCode), so ITS offset 0 is a vptr. FEAR2's
//      CClientMgr+0x00 is part of a list head: live it holds the head's OWN
//      address -- a heap value outside the exe image, structurally
//      incompatible with a vptr. (Why it self-points on a POPULATED list --
//      list[0] had 914 entries in that snapshot -- is exactly why the field
//      is still typed `prev` unverified; see CClientMgrListLink.)
//   2. Reference `m_ObjectLists` is the LAST member of ObjectMgr, preceded
//      by m_CurFrameCode, m_InternalLink, 4 StructBanks, 12 ObjectBanks and
//      a bank-pointer array. FEAR2 puts the 7 heads at offset 0, with
//      nothing ahead of them. (What actually follows at +0x38 is not mapped
//      yet -- see the unclaimed span below; it was not matched against the
//      reference's members and no such correspondence is asserted.)
//   3. Reference element type `LTList` is 16 bytes (`m_nElements` + a
//      12-byte `LTLink` carrying `m_pData`). FEAR2's heads are 8 bytes at
//      stride 8 with no count, and its walkers recover the object by
//      `link - 172` (INTRUSIVE) rather than reading `m_pData`. Different
//      list implementation, not just a different offset.
//   4. Every reference `om_*` routine takes an explicit `ObjectMgr*`
//      (om_Init/om_Term/om_CreateObject/om_DestroyObject). The FEAR2 object
//      routines examined here take no manager at all: 0x40CB24 and 0x40D065
//      read the g_pClientMgr global directly, 0x40B52A takes a bare list
//      head, and 0x40B287 takes only the object. 0x40BDC4 is a CClientMgr
//      __thiscall (touches this[1294], this+1285, this+26) that walks the 7
//      lists from `this + 0` inline. (Those five are the walkers/teardown
//      path, not an exhaustive sweep of every object routine.)
// Note (4) is suggestive, not decisive -- an embedded subobject at offset 0
// is layout-INDISTINGUISHABLE from direct fields, so no binary access
// pattern can prove or disprove a purely nominal wrapper. That cuts both
// ways: it cannot be confirmed either, and AGENT.MD rule 9 says FEAR2 is
// ground truth and the source drop is a NAMING hint only. So the lists stay
// declared directly on CClientMgr. Do not re-import this nesting from the
// source drop without FEAR2-side evidence.
//
// unk_68: a container/vector-like object, NOT a plain field. dump 0x44ED89
// uses `g_pClientMgr + 104` as a DROP-IN FALLBACK for `dword_6F3080 + 1064`
// and feeds it to sub_61C92C -- which computes `(this[2] - this[1]) >> 2`,
// i.e. a size() over 4-byte elements -- and to sub_46D362, which is its
// operator[] (`return this[1] + 4*index`, bounds-checked against that same
// size()). So relative to unk_68: +0x04 = begin, +0x08 = end. Live: begin=
// 0x175CA208 end=0x175CA20C, size 1. The DWORD at unk_68+0x00 itself is
// separately read as a BYTE flag by dump 0x40CB42 (`if (this[104])
// { ... } this[104] = 0;` -- a commit-and-clear), and read 0 live.
// Modelled as CClientMgrPtrVector below.
//
// last_sent_bandwidth: CONFIRMED EXACTLY. dump 0x40B562 computes
// `clamp(BandwidthTargetClient / 8000, 0, 0xFFFF)`, compares it against
// this field, and ONLY IF IT CHANGED calls the connection object's vtable
// slot 16 and re-sends -- then stores it back here. The value is written
// into a bit-packed network message (sub_438CE5 is a bitstream writer:
// `this[1] |= (val & mask) << bitpos`) as message id 7 in 4 bits followed
// by this value in 16 bits. dword_6E34E4 is the **BandwidthTargetClient**
// cvar -- proven from the engine's own cvar registration table at
// 0x6E3944 = {name="BandwidthTargetClient", &dword_6E34E4, type 2}.
// Live check: BandwidthTargetClient=256000, /8000 = 32, and this field
// read exactly 32. This is a change-detection cache of the last bandwidth
// value transmitted to the server, NOT a live bandwidth measurement.
//
// unk_4E4: explicitly zeroed inside CClientMgr::Init
// (`*(_DWORD*)(a1+1252)=0`) and observed live holding a heap pointer
// (0x05F30498) -- actively written post-init, role otherwise unverified.
//
// pending_shell_release @0x1438 + what `updating` is FOR: CONFIRMED, and it
// turns `updating` from "a flag we observed" into a mechanism we understand.
// Both halves are visible:
//
//   SET -- dump 0x409DDF (the shell-release path):
//     if (client_shell) {
//         if (updating) { <world/level teardown>; pending_shell_release = client_shell; }
//         else          { (**client_shell)(client_shell, 1); }  // virtual delete now
//         client_shell = 0;
//     }
//
//   CONSUME -- dump 0x40B665 (CClientMgr::Update), immediately after it
//   clears `updating`:
//     updating = 1;
//     CClientShell::Update(client_shell);       // dump 0x40CC5E
//     updating = 0;
//     if (...) sub_409DDF(this);                // may set pending_shell_release
//     if (pending_shell_release) {
//         (**pending_shell_release)(pending_shell_release, 1);  // vtable slot 0, arg 1
//         pending_shell_release = 0;
//     }
//
// So `updating` is a RE-ENTRANCY GUARD: it exists so a shell cannot be
// destroyed while its own Update is on the stack. A release requested from
// inside the update is parked in this field and performed by Update the
// instant the guard drops. The `(ptr)(ptr, 1)` shape is the usual MSVC
// scalar-deleting-destructor call through vtable slot 0.
//
// This also explains why a diagnostic sampling `updating` over IPC sees
// false essentially always: the true window is one CClientShell::Update
// call on the engine thread.
//
// Still identified but NOT mapped (see reversing/MAPPING_WORKFLOW.md --
// don't force a field without confident evidence): an embedded blob @0x90
// passed BY ADDRESS to a global subsystem's (dword_6ECC98) vtable slot 20
// during Init -- size/type/purpose unknown.
//
// Struct size below is a HEADROOM MINIMUM matching the highest mapped
// field + alignment, exactly like DatabaseMgr's own "unconfirmed beyond
// +0x18" note -- do NOT treat 0x1468 as the confirmed total object size,
// only as "safe to reinterpret up to here".
//
// object_banks: CONFIRMED. Six {LTMemoryPool*, element_size} pairs filling the
// 0x38..0x67 span that used to be the largest unmapped hole in this class.
// Each is the fixed-size allocator for ONE object type.
//
// THE INDEX IS NOT THE TYPE. OT_LIGHT (4) has no bank, so the array is
// compacted around it:
//   bank[0] -> type 0 OT_NORMAL         element_size 204  block 208
//   bank[1] -> type 1 OT_MODEL          element_size 408  block 416
//   bank[2] -> type 2 OT_WORLDMODEL     element_size 316  block 320
//   bank[3] -> type 3 OT_SPRITE         element_size 340  block 344
//   bank[4] -> type 5 OT_CAMERA         element_size 320  block 328
//   bank[5] -> type 6 OT_PARTICLESYSTEM element_size 264  block 272
// That OT_LIGHT is skipped is no longer just "consistent with" an empty bucket --
// it is PROVEN UNCREATABLE. CClientMgr_CreateObjectOfType (0x437E2E) switches on
// the requested type byte and has cases for 0,1,2,3,5,6 only; type 4 falls to
// `default: return 0`. So no code path can construct one, which is why its
// object_lists bucket reads 0 entries in every sample and why it needs no bank.
// The switch is also the ground truth for this whole table: each case calls one
// per-type creator (CClientMgr_NewObject_OT_*) whose base ctor identifies the
// class, and the case labels match the reference SDK's enum ordering exactly.
//
// HOW THE MAPPING WAS PROVEN -- three checks, because the obvious one is not
// sufficient on its own:
//   1. Minimum live address spacing per type equals exactly one bank's
//      block_size, and the six values form a bijection with the six types
//      (208/416/320/344/328/272, all distinct).
//   2. NOT sufficient alone: those block sizes are NOT unique across the
//      wider LTMemory pool list -- 4 of the 6 are shared with 1-2 other pools.
//      So spacing alone cannot prove the objects come from THESE pools.
//   3. Membership, which does prove it: each bank's pool->chunk, taken at
//      chunk + 0x10 with block_size stride, contains ONLY objects of its
//      mapped type and none of any other -- 6/6 banks, 0 foreign objects
//      (56/20/15/35/9/55 in-chunk hits respectively). The first slot's own
//      type byte also equals the mapped type, 6/6.
//
// This is also where every object type's allocation size comes from; see the
// LTObject comment for why that pins its size at 0xCC rather than headroom.
class CClientMgr 0x1468 {
    CClientMgrListLink object_lists[7]       @0x00     // CONFIRMED: 7 heads, bucketed by LTObject.type (index == type)
    CClientMgrObjectBank object_banks[6]     @0x38     // CONFIRMED per-object-type pool banks; index != type (OT_LIGHT has none) -- see the class comment
    CClientMgrPtrVector unk_68               @0x68     // CONFIRMED container shape; what it holds is unverified
    void* unk_4E4                            @0x4E4
    CClientMgrListLink counter_list_head     @0x13EC   // CONFIRMED: iterated per-frame by EngineList_ForEach(this+0x13EC) in CClientMgr::Update (dump 0x40B6A3)
    CClientMgrCounterNode* own_counter_node  @0x13F4
    uint32_t last_sample_time_ms             @0x1400   // CONFIRMED milliseconds. CClientMgr::Update computes `sub_409FD0(now - this->last_sample_time_ms)` with now = dump 0x60AAF2 (dump 0x40B6AD/0x40B6C6), and sub_409FD0 divides that delta by exactly 1000.0 (dbl_66E738) to get seconds -- so this field's unit is ms. Live: advanced 1672342 -> 1673346 (delta 1004) across ~1.00s of wall clock, i.e. tracks real time 1:1 and is re-sampled continuously. The instruction that writes it was NOT located in the functions read so far.
    float unk_1424                           @0x1424   // unverified float. Live: advances while the engine runs, but NOT by whole numbers and NOT at a fixed rate -- observed +168.000 over ~1.0s in one sample and +21.987 over ~2.0s in another. RETRACTED HYPOTHESIS: dump 0x409FD0 does `*(float*)(<ecx>+0x1424) += 1.0` (dbl_66EDF0 == 1.0), and this field was briefly named frame_counter on that basis. That was WRONG: the decompiler never established that 0x409FD0's ecx is CClientMgr, and the non-integral live deltas here disprove it -- either that function operates on a different object, or something else writes this field. Offset/type are sound (read as a float that changes); the meaning is not.
    uint16_t last_sent_bandwidth             @0x1430   // CONFIRMED == clamp(BandwidthTargetClient/8000, 0, 0xFFFF); live 256000/8000 == 32 == field
    void* client_shell                       @0x1434
    void* pending_shell_release              @0x1438   // CONFIRMED deferred-destruction slot; see the class comment. Set only when `updating`, consumed at the end of CClientMgr::Update.
    bool updating                            @0x143C
    CClientMgrListLink start_shell_list      @0x1460
}

// ---- The per-type cull-volume interface (object vtable slot 2) -------------
//
// LTObjectOwner_UpdateSpatialRecord asks each object for its culling volume
// through vtable slot 2, and dispatches on the RETURN VALUE:
//   0 = no volume -> LTSpatialRecord_Release (the object leaves the index)
//   1 = sphere    -> out[0..2] = centre, out[3] = radius
//   2 = AABB      -> out[0..2] = min,    out[3..5] = max
// The AABB form is written by LTMath_WriteAABB (0x40DD51), a plain 6-float
// copy, which is what pins the out-buffer layout.
//
// Per type, live:
//   OT_NORMAL          returns 0 unconditionally -- these objects are NEVER in
//                      the spatial index (OT_NORMAL_GetCullVolume is `return 0`)
//   OT_MODEL           1, from vis_radius * LTObject.scale (see LTModelObject)
//   OT_WORLDMODEL      2, straight from LTObject.aabb_min / aabb_max
//   OT_CAMERA          2, same shared body as OT_WORLDMODEL
//   OT_SPRITE          2 when its kind byte @0x106 is 3/4/7/9, else 1
//   OT_PARTICLESYSTEM  returns its own mode byte (see LTParticleSystemObject)
//
// The shared OT_WORLDMODEL/OT_CAMERA body also returns 0 when the byte at
// LTObject.flags3's low end has bit 0x80 set. The code is `if ((char)this[70] <
// 0) return 0` -- a SIGNED BYTE test, so the mask is 0x80, NOT 0x8000 as an
// earlier draft of this comment said. That draft went on to call the path
// unexercised, having looked for the wrong bit.
//
// It IS exercised, by exactly one object: the level geometry (flags3 == 0x490,
// handle == 0xFFFF, slot_index == -1, dims of (13375, 9149, 10200) spanning the
// whole map). Its spatial_record volume is all zeros while every other
// OT_WORLDMODEL's holds a real AABB -- so the single live exception to the
// record mapping is explained by this gate rather than left as residue.

// A SHARED model asset record. Live, 215 OT_MODEL objects point at only 34
// distinct instances of this, and never at null (215/215) -- so it is per-ASSET,
// not per-instance, which is what makes LTModelObject.asset a resource handle
// rather than an owned sub-object.
//
// Size is the MAPPED EXTENT, not a proven class size.
//
// NOT MAPPED, and specifically tested and rejected: the fields after +0x04 look
// like (pointer, count) array descriptors at +0x04/+0x0C/+0x14/+0x1C, which
// would be a normal asset header. Checking all four pairs across all 34 assets,
// only 69 of 136 had both a heap-shaped pointer and a plausible count, and the
// dword at +0x08 reads 0 on 14 assets, 1 on 10 and 11 on 10. That is not an
// array header; the shape was a guess and it failed, so nothing beyond radius is
// claimed here.
class LTModelAsset 0x4 {
    float radius   @0x00   // CONFIRMED: OT_MODEL_GetCullVolume reads it as `**(float**)(obj+0xEC)` for its sphere radius. Live values are round -- 20, 25, 100, 120, 200, 240 across 15 distinct readings -- and equal LTModelObject.vis_radius on 215/215 objects, i.e. that per-object field is a CACHE of this one.
}

// The concrete class behind object type 1. 408 bytes (0x198) from its bank's
// element_size, and the class is now CLOSED at that boundary: the cached
// rotation below ends at exactly 0x198.
//
// OT_MODEL_ctor (0x42A4C8) is what opened the rest of this class up. It derives
// DIRECTLY from LTObject -- OT_MODEL_dtor_body installs vtbl_OT_MODEL and calls
// LTObject_dtor_body with nothing in between -- so despite having a vtable that
// shares no slots with any sibling, there is no intermediate class here.
class LTModelObject 0x198 {
    LTObject base            @0x00    // CONFIRMED: the first 0xCC bytes are an LTObject
    CClientMgrListLink embedded_link @0xCC   // CONFIRMED: a link pair that the ctor INSERTS INTO THIS OBJECT'S OWN list_head below, immediately after constructing a sub-object at the same offset (0x4297CF), and the insert is what takes list_count to 1. Live, this node is a member of its own object's list on 215/215. So every model owns at least one of whatever the list holds, always the embedded one.
    LTModelAsset* asset      @0xEC    // CONFIRMED non-null on 215/215 and SHARED -- 34 distinct across 215 objects. Its radius is what branch A of OT_MODEL_GetCullVolume uses. SlotIndex_WantsSlot also requires this non-null for type 1, so it is a mandatory resource handle. A SECOND ROUTE reaches the same pointer: asset_dup at 0x130 equals it on 215/215.
    CClientMgrListLink list_head @0x100   // CONFIRMED list head: the ctor self-points both halves (an empty list) and then links embedded_link in. Live it is never empty for that reason. Members are recovered as `link` addresses; the only member whose identity is proven is the object's own embedded_link.
    uint32_t list_count      @0x108   // CONFIRMED the list's OWN stored count: it equals the walked member count on 215/215, and the ctor increments it to 1 as it links embedded_link. Live distribution 1 (x184), 2 (x6), 3 (x12), 4 (x9), 5 (x3), 6 (x1) -- so one embedded member plus up to five extras. WHAT the extra members are is unmapped; the shape (one built-in plus optional additions) is all that is proven.
    void* owned_120          @0x120   // ctor constructs a sub-object here (0x4257CE) and the dtor destroys it (0x428CAC). Live this first dword is a heap pointer unique to each object and far from it, so it is an owned allocation rather than an embedded self-reference. Pointee unmapped.
    LTModelAsset* asset_dup  @0x130   // CONFIRMED equal to `asset` on 215/215 -- two independent routes to one address, which is why this is worth recording rather than folding away. The ctor constructs a sub-object here (0x42CE7D) and the dtor destroys it (0x42DA6C), so this is the first field of that sub-object and the asset pointer is reachable through it.
    uint16_t sphere_source   @0x156   // CONFIRMED branch selector in OT_MODEL_GetCullVolume. The two branches differ in MORE than where they read from, which is why both exist: non-zero takes the centre from sphere_center and the radius from asset->radius UNSCALED; zero takes the centre from LTObject.position and the radius from vis_radius * LTObject.scale. Since asset->radius == vis_radius on 215/215, the real distinction is explicit-centre-and-unscaled versus object-centre-and-scaled. Live: 22 non-zero / 193 zero of 215.
    LTVector sphere_center   @0x160   // CONFIRMED: the cull-sphere centre used when sphere_source != 0 (a world position, copied out directly rather than added to LTObject.position). PROVENANCE, from the ctor: it is initialised by copying base.position. That is why it is stale on most objects -- live it still equals base.position on only 12 of 215 -- and why the 193 objects with sphere_source == 0 can safely ignore it.
    float vis_radius         @0x16C   // CONFIRMED: multiplied by LTObject.scale to give branch B's cull radius. Live > 0 on 215/215. It is a CACHE of the shared asset->radius -- the two are equal on 215/215 objects -- so a mod must not treat them as independent knobs. An earlier note said "the sampled models all read exactly 100.0", which was true only of the six models sampled then; across all 34 assets the values are 20/25/100/120/200/240 and more.
    LTRotation cached_rotation @0x188   // CONFIRMED a real quaternion, not padding: the ctor writes (0,0,0,1) and live it is unit-length on 215/215. Ends at 0x198 == the class size, closing the class. It is NOT a live mirror of base.rotation (that would make it redundant); which of the two the renderer consumes is unmapped.
}

// The concrete class behind object type 6. 264 bytes (0x108) from its bank's
// element_size -- and the cull fields below end at exactly 0x108, so this part
// of the class is complete even though nothing else in it is mapped.
//
// Note both volumes are stored as OFFSETS: the provider adds LTObject.position
// to every component before handing them out, so these are object-local.
class LTParticleSystemObject 0x108 {
    LTObject base              @0x00   // CONFIRMED: the first 0xCC bytes are an LTObject
    uint8_t cull_volume_type   @0xDD   // CONFIRMED: OT_PARTICLESYSTEM_GetCullVolume RETURNS this byte, so it is literally the volume-kind selector -- 1 takes the sphere path, anything else the AABB path. Live it is only ever 1 (239) or 2 (39) across 278/278 objects, which is exactly the pair of values the interface defines.
    LTVector sphere_offset     @0xE0   // CONFIRMED: added to LTObject.position to give the sphere centre (type 1)
    float sphere_radius        @0xEC   // CONFIRMED: the sphere radius (type 1)
    LTVector aabb_min_offset   @0xF0   // CONFIRMED: added to LTObject.position to give the AABB min (type != 1)
    LTVector aabb_max_offset   @0xFC   // CONFIRMED: added to LTObject.position to give the AABB max. Ends at 0x108 == the class size.
}

// The concrete class behind object type 3. 340 bytes (0x154) from its bank's
// element_size. Only the cull-volume fields are mapped.
//
// Unlike OT_PARTICLESYSTEM, the selector here is NOT a volume-kind enum: the
// provider switches on a KIND byte and hard-codes which kinds are AABB-shaped
// (3, 4, 7 and 9), returning a sphere for everything else. So the byte
// identifies what the sprite IS and the volume shape follows from that.
class LTSpriteObject 0x154 {
    LTObject base          @0x00    // CONFIRMED: the first 0xCC bytes are an LTObject
    uint8_t kind           @0x106   // CONFIRMED selector in OT_SPRITE_GetCullVolume: kinds 3/4/7/9 take the AABB path, all others the sphere path. Live values span 1..9 across 224/224 objects (6 is the most common at 112), so this is a small dense enum -- but only the AABB-vs-sphere split is proven; what each kind MEANS is unmapped.
    LTVector aabb_min      @0x120   // CONFIRMED: passed to LTMath_WriteAABB as the min for AABB kinds. Live, min <= max componentwise on 9/9 AABB-kind sprites.
    LTVector aabb_max      @0x12C   // CONFIRMED: the max for AABB kinds
    float radius           @0x138   // CONFIRMED: the sphere radius for all other kinds, paired with LTObject.position as the centre. Live, finite and > 0 on 215/215 sphere-kind sprites.
    void* owned[6]         @0x13C   // CONFIRMED OWNED: OT_SPRITE_dtor_body (0x4150B3) runs `do { LTMem_Free(*v2++) } while(--6)` starting at this+79 dwords == +0x13C, so all six are freed unconditionally. Ends at 0x154 == the class size, which is how the count 6 and this offset corroborate each other. Live they are sparsely used -- 168 of 1344 slots non-null, and only 3 of 224 sprites fill all six -- so they are optional per-slot allocations. WHAT they hold is unmapped.
}
}
