type uint64_t 8 [[u64]]
type int32_t 4 [[i32]]
type uint32_t 4 [[u32]]
type int16_t 2 [[i16]]
type uint16_t 2 [[u16]]
type uint8_t 1 [[u8]]
type int8_t 1 [[i8]]
type double 8 [[f64]]
type float 4 [[f32]]
type char 1
type void 0
type code 4 [[code]]
type wstrptr 4 [[utf16*]]
type strptr 4 [[utf8*]]
type wchar_t 2 [[u16]]
